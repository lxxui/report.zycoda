@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zycoda Report</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light main-nav fixed-top shadow-sm">
            <div class="container-fluid px-4">
                <a class="navbar-brand" asp-area="" asp-controller="Dashboard" asp-action="Index">
                    <span class="d-none d-sm-inline">ZYCODA REPORT</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <div class="d-flex align-items-center ms-auto ps-md-4 border-start d-none d-md-flex">

                        <div class="text-end me-3">
                            @if (User.Identity.IsAuthenticated)
                            {
                                // 1. ดึงข้อมูลจาก Claims
                                var fullName = User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value;
                                var sectionName = User.Claims.FirstOrDefault(c => c.Type == "Section")?.Value;
        
                                // 🚩 ดึง SectionOption มาแสดง
                                var sectionoption = User.Claims.FirstOrDefault(c => c.Type == "SectionOption")?.Value;

                                if (User.IsInRole("Administrator"))
                                {
                                    <span class="fw-bold text-danger">Admin: @fullName</span>
                                }
                                else
                                {
                                    <span class="fw-bold">User: @fullName</span>
                                }

                                <br />
                                @* แสดงแผนกหลัก *@
                                <small class="text-muted">แผนกหลัก: @sectionName</small>

                                @* 🚩 ถ้ามี SectionOption ให้แสดงเพิ่มบรรทัดใหม่ *@
                                if (!string.IsNullOrEmpty(sectionoption))
                                {
                                    <br />
                                    <small class="text-primary" style="font-size: 0.75rem;">
                                        <i class="bi bi-eye"></i> สิทธิ์มองเห็น: @sectionoption
                                    </small>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Guest User</span>
                            }
                        </div>

                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width:38px; height:38px;">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <form asp-controller="Home" asp-action="Logout" method="post" id="logoutForm" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn btn-outline-danger btn-sm border-0 hover-effect" onclick="showLogoutAlert()">
                                <i class="bi bi-box-arrow-right"></i>
                                <span class="d-none d-lg-inline ms-1">Logout</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 content-wrapper">
        <main role="main" class="pb-3">
            <br />
            @RenderBody()
        </main>
    </div>


    <footer class="footer text-muted">
        <div class="container-fluid px-4">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    &copy; 2026 - <b>President Bakery PCL.</b> <span class="mx-2 text-silver">|</span> System Development 1
                </div>
                <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted me-3">Privacy Policy</a>
                    <span class="badge bg-light text-dark border">v1.2.0</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function showLogoutAlert() {
        Swal.fire({
        title: 'ออกจากระบบ?',
        text: "คุณต้องการออกจากระบบ Zycoda Report ใช่หรือไม่?",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33', // สีแดง (Danger)
        cancelButtonColor: '#6c757d', // สีเทา (Secondary)
        confirmButtonText: '<i class="bi bi-check-lg"></i> ใช่, ออกจากระบบ',
        cancelButtonText: 'ยกเลิก',
        background: '#ffffff',
        borderRadius: '15px',
        customClass: {
        title: 'fw-bold',
        confirmButton: 'btn btn-danger px-4',
        cancelButton: 'btn btn-secondary px-4'
        }
        }).then((result) => {
        if (result.isConfirmed) {
        // ถ้ากดยืนยัน ให้ส่งฟอร์ม Logout
        document.getElementById('logoutForm').submit();
        }
        })
        }
    </script>


</body>


</html>

