@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>

        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Zycoda Report</title>

        <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css">
    
        <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    
        <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />

        <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
        <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
        <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        /* ตกแต่ง Logo ZYCODA ให้ดู Modern */
        .zycoda-logo-text {
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        font-weight: 800;
        letter-spacing: 2px;
        background: linear-gradient(135deg, #001f3f 0%, #004080 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-size: 1.4rem;
        }

        .zycoda-badge {
        background-color: #001f3f;
        color: white;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.65rem;
        vertical-align: middle;
        margin-left: 5px;
        letter-spacing: 1px;
        }

        .modal-header-modern {
        border-bottom: 1px solid #f1f5f9;
        padding: 1.25rem 2rem;
        background: #ffffff;
        }

        .btn-logout-modern {
        color: #64748b; /* สีเทาเข้มแบบ Slate */
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 12px;
        }

        .btn-logout-modern:hover {
        color: #dc3545; /* เปลี่ยนเป็นสีแดงเฉพาะตอนจะกด */
        background-color: #fff1f2; /* พื้นหลังชมพูอ่อนๆ */
        transform: translateX(3px); /* ขยับขวาเบาๆ ให้ดูมี Dynamic */
        }

        .btn-logout-modern i {
        font-size: 1.1rem;
        vertical-align: middle;
        }

        /* CSS เพิ่มเติมเพื่อให้ UI ดูดีขึ้น */
        .bg-navy-gradient {
        background: linear-gradient(135deg, #001f3f 0%, #004080 100%);
        }

        .text-navy {
        color: #001f3f;
        }

        /* ปุ่ม Master Setup แบบใหม่ */
        .btn-master-setup {
        background-color: #fff;
        color: #001f3f;
        border: 1.5px solid #001f3f;
        font-size: 0.65rem;
        font-weight: 800;
        padding: 4px 12px;
        border-radius: 50px;
        transition: all 0.3s ease;
        }

        .btn-master-setup:hover {
        background-color: #001f3f;
        color: #fff;
        transform: translateY(-1px);
        }

        /* ปุ่ม Logout แบบ Minimal */
        .btn-logout-modern-v2 {
        background: none;
        border: none;
        color: #94a3b8;
        font-weight: 700;
        font-size: 0.9rem;
        padding: 8px 15px;
        border-radius: 10px;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        }

        .btn-logout-modern-v2:hover {
        color: #ef4444;
        background-color: #fef2f2;
        }

        .main-nav {
        backdrop-filter: blur(10px); /* ทำให้พื้นหลังเบลอแบบ iOS */
        background-color: rgba(255, 255, 255, 0.9) !important;
        }

        /* บังคับสีและขนาด เผื่อโดน CSS ตัวอื่นทับ */
        .bi-bell-fill {
        display: inline-block !important;
        visibility: visible !important;
        color: #001f3f !important; /* สี Navy เข้มๆ ของฝ้าย */
        }

        /* ปรับตำแหน่ง Badge ให้เป๊ะขึ้น */
        #notif-badge {
        z-index: 1050; /* ให้อยู่เหนือทุกอย่าง */
        font-family: sans-serif;
        transform: translate(10%, -10%);
        }


    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light main-nav fixed-top shadow-sm bg-white py-2">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Maintenance" asp-action="Index">
                    <div class="me-3 border-end pe-3">
                        <span class="zycoda-logo-text" style="font-size: 1.6rem; letter-spacing: 3px;">ZYCODA</span>
                        <span class="zycoda-badge shadow-sm" style="background: #001f3f; padding: 3px 10px;">REPORT</span>
                    </div>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <div class="d-flex align-items-center ms-auto">

                        @if (User.Identity.IsAuthenticated)
                        {
                            // 1. ดึง List (ใส่ Check เผื่อ ViewBag เป็น Null)
                            var allSections = ViewBag.SectionList as List<report_zycoda.Models.SectionApiModels>;
    
                            // 2. ดึงรหัสแผนกจาก Claim
                            var sectionIdFromClaim = User.Claims.FirstOrDefault(c => c.Type == "Section")?.Value;

                            // 3. ทำการ Matching (เพิ่ม StringComparison ให้แม่นยำขึ้น)
                            var userSection = allSections?.FirstOrDefault(s =>
                                string.Equals(s.Sections?.Trim(), sectionIdFromClaim?.Trim(), StringComparison.OrdinalIgnoreCase));

                            // 4. สรุปชื่อที่จะใช้แสดง
                            string displaySectionName;
                            if (allSections == null)
                            {
                                displaySectionName = "ระบบไม่ได้โหลดรายการหน่วยงาน (" + sectionIdFromClaim + ")";
                            }
                            else if (userSection == null)
                            {
                                displaySectionName = "ไม่พบชื่อหน่วยงานรหัส " + sectionIdFromClaim;
                            }
                            else
                            {
                                displaySectionName = userSection.Name;
                            }

                            <div class="user-nav-wrapper d-flex align-items-center px-3 py-1 me-3">
                                <div class="text-end me-3">
                                    <div class="d-flex align-items-center justify-content-end lh-1 mb-1">
                                        <span class="fw-bold text-dark me-2" style="font-size: 0.95rem;">
                                            @User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value
                                            @User.Claims.FirstOrDefault(c => c.Type == "LastName")?.Value
                                        </span>
                                    </div>
                                    <div class="text-muted d-flex align-items-center justify-content-end" style="font-size: 0.75rem;">
                                        <i class="bi bi-geo-alt-fill me-1 text-primary"></i>
                                        <span title="Matching Status: @(userSection != null ? "Found" : "Not Found")">
                                            @displaySectionName
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="notification-wrapper me-3">
                                <a class="nav-link position-relative p-2" href="#" id="notificationBell">
                                    <i class="bi bi-bell-fill text-navy fs-5"></i>
                                    <span id="notif-badge"
                                          class="position-absolute badge rounded-pill bg-danger"
                                          style="top: 2px; right: -2px; font-size: 0.6rem; padding: 0.3em 0.5em;">
                                        NEW
                                    </span>
                                </a>
                            </div>
                        }
                     
                        <form asp-controller="Home" asp-action="Logout" method="post" id="logoutForm" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="button"
                                    class="btn-logout-modern-v2"
                                    onclick="showLogoutAlert()"
                                    title="ออกจากระบบ">
                                <i class="bi bi-box-arrow-right"></i>
                                <span class="d-none d-lg-inline ms-2">Logout</span>
                            </button>
                        </form>

                    </div>
                </div>
            </div>
        </nav>
    </header>


    <div class="container-fluid px-4 content-wrapper">
        <main role="main" class="pb-3">
            <br />
            @RenderBody()
        </main>
    </div>


    <footer class="footer text-muted">
        <div class="container-fluid px-4">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    &copy; 2026 - <b>President Bakery PCL.</b> <span class="mx-2 text-silver">|</span> System Development 1
                </div>
                <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted me-3">Privacy Policy</a>
                    <span class="badge bg-light text-dark border">v1.0.0</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
       function showLogoutAlert() {
        Swal.fire({
            title: 'ยืนยันการออกจากระบบ',
            html: 'เซสชันของคุณจะสิ้นสุดลง<br><small class="text-muted">คุณต้องการออกจากระบบ Zycoda Report ใช่หรือไม่?</small>',
            // ใช้ Icon แบบ Custom หรือเปลี่ยนเป็น Question แทน Warning จะดู Soft กว่า
            icon: 'question', 
            iconColor: '#001f3f', // สี Navy ตาม Branding ของฟาย
            showCancelButton: true,
            confirmButtonText: 'ออกจากระบบ',
            cancelButtonText: 'กลับไปทำงานต่อ',
            reverseButtons: true, // เอาปุ่มยืนยันไว้ขวา (ตามหลัก UI สมัยใหม่)
        
            // ตกแต่งความสวยงาม
            background: '#ffffff',
            padding: '2rem',
            color: '#001f3f',
            backdrop: `rgba(0,31,63,0.1)`, // พื้นหลังมัวๆ สี Navy จางๆ
        
            showClass: {
                popup: 'animate__animated animate__fadeInUp animate__faster' // ต้องลง animate.css หรือใช้ default ก็ได้
            },
            hideClass: {
                popup: 'animate__animated animate__fadeOutDown animate__faster'
            },

            customClass: {
                title: 'fw-bold fs-4 mb-2',
                htmlContainer: 'mb-4',
                confirmButton: 'btn btn-navy px-4 py-2 rounded-pill shadow-sm ms-3',
                cancelButton: 'btn btn-link text-muted fw-bold text-decoration-none'
            },
            buttonsStyling: false // ปิด Style พื้นฐานของ Swal เพื่อใช้ Bootstrap ของเราเอง
              }).then((result) => {
                if (result.isConfirmed) {
                    // 1. แสดง Loading ทันทีที่กดยืนยัน
                    Swal.fire({
                        title: 'กำลังออกจากระบบ...',
                        html: 'กรุณารอสักครู่ ระบบกำลังปิดเซสชันการทำงาน',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading(); // แสดง Spinner ของ Swal
                        }
                    });

                    // 2. ใช้ setTimeout เพื่อหน่วงเวลาให้ User เห็น UI แป๊บหนึ่ง (1500ms = 1.5 วินาที)
                    setTimeout(() => {
                        document.getElementById('logoutForm').submit();
                    }, 1500); 
                }
            });
    }

    function deleteSection(id) {
    Swal.fire({
        title: 'ยืนยันการลบ?',
        text: "คุณกำลังจะลบหน่วยงานรหัส " + id,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        confirmButtonText: 'ลบเลย!',
        cancelButtonText: 'ยกเลิก'
    }).then((result) => {
        if (result.isConfirmed) {
            // สร้าง Form จำลองเพื่อส่งค่า POST ไปลบ
            var form = $('<form action="/Master/DeleteSection" method="post">' +
                         '<input type="hidden" name="id" value="' + id + '" />' +
                         '</form>');
            $('body').append(form);
            form.submit();
        }
    });
}

    </script>


</body>


</html>

