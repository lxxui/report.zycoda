@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var userClass = (User.FindFirst("Class")?.Value ?? "0").Trim();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zycoda Report</title>

    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css"> *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        /* ตกแต่ง Logo ZYCODA ให้ดู Modern */
        .zycoda-logo-text {
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            font-weight: 800;
            letter-spacing: 2px;
            background: linear-gradient(135deg, #001f3f 0%, #004080 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-size: 1.4rem;
        }

        .zycoda-badge {
            background-color: #001f3f;
            color: white;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 0.65rem;
            vertical-align: middle;
            margin-left: 5px;
            letter-spacing: 1px;
        }

        .modal-header-modern {
            border-bottom: 1px solid #f1f5f9;
            padding: 1.25rem 2rem;
            background: #ffffff;
        }

        .bg-navy-gradient {
            background: linear-gradient(135deg, #001f3f 0%, #004080 100%);
        }

        .text-navy {
            color: #001f3f;
        }

        .btn-outline-navy {
            color: #001f3f;
            border: 1.5px solid #001f3f;
            background-color: #f8fafc;
            font-weight: 600;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-outline-navy:hover {
            color: #ffffff;
            background-color: #001f3f;
            border-color: #001f3f;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(0, 31, 63, 0.2);
        }

        .animation-spin-hover {
            transition: transform 0.4s ease;
        }

        .btn-outline-navy:hover .animation-spin-hover {
            transform: rotate(60deg);
        }

        .btn-logout-modern-v2 {
            background: none;
            border: none;
            color: #64748b;
            font-weight: 700;
            font-size: 0.9rem;
            padding: 8px 16px;
            border-radius: 12px;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
        }

        .btn-logout-modern-v2:hover {
            color: #ef4444;
            background-color: #fff1f2;
            transform: translateX(2px);
        }

        .btn-navy {
            background-color: #001f3f;
            color: #ffffff;
            border: none;
            transition: all 0.2s;
        }
        .btn-navy:hover {
            background-color: #003366;
            color: #ffffff;
        }

        .main-nav {
            backdrop-filter: blur(10px);
            background-color: rgba(255, 255, 255, 0.9) !important;
        }

        .bi-bell-fill {
            display: inline-block !important;
            visibility: visible !important;
            color: #001f3f !important;
        }

        #notif-badge {
            z-index: 1050;
            font-family: sans-serif;
            transform: translate(10%, -10%);
        }

        /* 💡 บังคับเลเยอร์ Dropdown ให้อยู่บนสุดเสมอ ป้องกันองค์ประกอบอื่นบัง */
        .dropdown-menu {
            z-index: 2500 !important;
        }
        #profileDropdown {
            cursor: pointer;
        }

    </style>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-light main-nav fixed-top shadow-sm bg-white py-2">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Maintenance" asp-action="Index">
                    <div class="me-3 border-end pe-3 d-flex align-items-center gap-1">
                        <span class="zycoda-logo-text fw-bold text-dark-slate" style="font-size: 1.5rem; letter-spacing: 2px;">ZYCODA</span>
                        <span class="zycoda-badge shadow-sm rounded-2 text-white fw-semibold" style="background: #001f3f; padding: 2px 8px; font-size: 0.75rem;">REPORT</span>
                    </div>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <div class="d-flex align-items-center ms-auto gap-2">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var allSections = ViewBag.SectionList as List<report_zycoda.Models.SectionApiModels>;
                            var sectionIdFromClaim = User.Claims.FirstOrDefault(c => c.Type == "Section")?.Value;
                            var userClass = User.Claims.FirstOrDefault(c => c.Type == "Class")?.Value;

                            var userSection = allSections?.FirstOrDefault(s =>
                                string.Equals(s.Sections?.Trim(), sectionIdFromClaim?.Trim(), StringComparison.OrdinalIgnoreCase));

                            string displaySectionName = allSections == null
                                ? "ระบบไม่ได้โหลดรายการหน่วยงาน"
                                : (userSection == null ? "รหัสหน่วยงาน: " + sectionIdFromClaim : userSection.Name);

                            var fullName = User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value ?? "User";
                            var initialLetter = !string.IsNullOrEmpty(fullName) ? fullName.Substring(0, 1).ToUpper() : "U";

                            <div class="position-relative me-1">
                                <a class="nav-link d-flex align-items-center justify-content-center rounded-circle hover-bg-effect"
                                   href="#" id="notificationBell" style="width: 40px; height: 40px; transition: all 0.2s;">
                                    <i class="bi bi-bell text-dark-slate fs-5"></i>
                                    <span id="notif-badge" class="position-absolute badge rounded-pill bg-danger border border-white"
                                          style="top: 6px; right: 4px; font-size: 0.55rem; padding: 0.35em 0.5em;">
                                        NEW
                                    </span>
                                </a>
                            </div>

                            <div class="dropdown">
                                <button class="btn d-flex align-items-center bg-white border border-light-subtle p-1.5 pe-3 rounded-pill shadow-sm dropdown-toggle profile-toggle-btn"
                                        type="button" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="transition: all 0.2s;">

                                    <div class="avatar-circle-sm d-flex align-items-center justify-content-center fw-bold rounded-circle me-2 shadow-inner">
                                        @initialLetter
                                    </div>

                                    <div class="text-start me-1 d-none d-sm-block" style="max-width: 140px;">
                                        <div class="fw-bold text-dark text-truncate" style="font-size: 0.8rem; line-height: 1.2;">
                                            @fullName
                                        </div>
                                        <div class="text-muted text-truncate" style="font-size: 0.7rem; margin-top: 1px;" title="@displaySectionName">
                                            <i class="bi bi-geo-alt-fill text-success me-0.5"></i>@displaySectionName
                                        </div>
                                    </div>
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-2 mt-2"
                                    aria-labelledby="profileDropdown"
                                    style="min-width: 280px; border-radius: 16px;">

                                    <li class="px-3 py-3 mb-2 rounded-4 d-flex align-items-center gap-3" style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);">
                                        <div class="avatar-circle-lg d-flex align-items-center justify-content-center fw-bold rounded-circle text-white shadow-sm">
                                            @initialLetter
                                        </div>
                                        <div class="overflow-hidden">
                                            <div class="text-muted fw-medium" style="font-size: 0.65rem; letter-spacing: 0.5px; text-transform: uppercase;">ผู้ใช้งานปัจจุบัน</div>
                                            <div class="fw-bold text-dark text-truncate" style="font-size: 0.9rem;" title="@fullName">@fullName</div>
                                            <span class="badge mt-1 font-monospace rounded-pill shadow-sm" style="font-size: 0.65rem; background-color: #001f3f; color: #ffffff;">
                                                Class @userClass
                                            </span>
                                        </div>
                                    </li>

                                    @* 🛠️ ปรับปรุงจุดเช็คสิทธิ์แก้ไขปัญหา String/Whitespace *@
                                    @{
                                        bool hasMechanicAccess = userClass != null && userClass.Trim() == "9";
                                    }

                                    @if (hasMechanicAccess)
                                    {
                                        <li><hr class="dropdown-divider my-2" style="opacity: 0.08;"></li>
                                        <li class="dropdown-header text-uppercase pt-1 pb-1 px-3" style="font-size: 0.65rem; letter-spacing: 0.8px; color: #94a3b8; font-weight: 700;">Admin Management</li>
                                        <li>
                                            <a asp-controller="Maintenance" asp-action="Machine" class="dropdown-item d-flex align-items-center py-2 px-3 rounded-3 text-secondary fw-medium custom-menu-item" style="font-size: 0.85rem;">
                                                <div class="icon-box d-flex align-items-center justify-content-center bg-light rounded-3 me-2.5" style="width: 32px; height: 32px; transition: all 0.2s;">
                                                    <i class="bi bi-gear text-dark" style="font-size: 0.95rem;"></i>
                                                </div>
                                                <span>ตั้งค่าและจัดการเครื่องจักร</span>
                                            </a>
                                        </li>
                                    }

                                    <li><hr class="dropdown-divider my-2" style="opacity: 0.08;"></li>

                                    <li>
                                        <button type="button" class="dropdown-item d-flex align-items-center py-2 px-3 rounded-3 text-danger fw-semibold custom-logout-item"
                                                onclick="showLogoutAlert()" style="font-size: 0.85rem;">
                                            <div class="icon-box d-flex align-items-center justify-content-center bg-danger-subtle rounded-3 me-2.5" style="width: 32px; height: 32px; transition: all 0.2s;">
                                                <i class="bi bi-box-arrow-right text-danger" style="font-size: 0.95rem;"></i>
                                            </div>
                                            <span>ออกจากระบบ (Logout)</span>
                                        </button>
                                    </li>
                                </ul>
                            </div>
                        }

                        <form asp-controller="Home" asp-action="Logout" method="post" id="logoutForm" class="d-none">
                            @Html.AntiForgeryToken()
                        </form>

                    </div>
                </div>
            </div>
        </nav>
</header>
    <div class="container-fluid px-4 content-wrapper">
        <main role="main" class="pb-3">
            <br />
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container-fluid px-4">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    &copy; 2026 - <b>President Bakery PCL.</b> <span class="mx-2 text-silver">|</span> System Development 1
                </div>
                <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted me-3">Privacy Policy</a>
                    <span class="badge bg-light text-dark border">v1.0.0</span>
                </div>
            </div>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function showLogoutAlert() {
            Swal.fire({
                title: 'ยืนยันการออกจากระบบ',
                html: 'เซสชันของคุณจะสิ้นสุดลง<br><small class="text-muted">คุณต้องการออกจากระบบ Zycoda Report ใช่หรือไม่?</small>',
                icon: 'question',
                iconColor: '#001f3f', 
                showCancelButton: true,
                confirmButtonText: 'ออกจากระบบ',
                cancelButtonText: 'กลับไปทำงานต่อ',
                reverseButtons: true, 
                background: '#ffffff',
                padding: '2rem',
                color: '#001f3f',
                backdrop: `rgba(0,31,63,0.1)`, 
                customClass: {
                    title: 'fw-bold fs-4 mb-2',
                    htmlContainer: 'mb-4',
                    confirmButton: 'btn btn-navy px-4 py-2 rounded-pill shadow-sm ms-3',
                    cancelButton: 'btn btn-link text-muted fw-bold text-decoration-none'
                },
                buttonsStyling: false 
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'กำลังออกจากระบบ...',
                        html: 'กรุณารอสักครู่ ระบบกำลังปิดเซสชันการทำงาน',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    setTimeout(() => {
                        document.getElementById('logoutForm').submit();
                    }, 1500);
                }
            });
        }

        function deleteSection(id) {
            Swal.fire({
                title: 'ยืนยันการลบ?',
                text: "คุณกำลังจะลบหน่วยงานรหัส " + id,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'ลบเลย!',
                cancelButtonText: 'ยกเลิก'
            }).then((result) => {
                if (result.isConfirmed) {
                    var form = $('<form action="/Master/DeleteSection" method="post">' +
                    '<input type="hidden" name="id" value="' + id + '" />' +
                    '</form>');
                    $('body').append(form);
                    form.submit();
                }
            });
        }
    </script>
</body>
</html>