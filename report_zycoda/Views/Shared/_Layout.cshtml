@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Maintenance System</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />


</head>
<body>
    <header>

        <nav class="navbar navbar-expand-sm navbar-light main-nav">
            <div class="container-fluid px-4">
                <a class="navbar-brand" asp-area="" asp-controller="Dashboard" asp-action="Index">
                    @* <img src="~/images/logo.png" alt="Logo" class="brand-logo" onerror="this.src='https://cdn-icons-png.flaticon.com/512/5968/5968204.png'; this.style.opacity='0.5'"> *@
                    <span class="d-none d-sm-inline">ZYCODA REPORT</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")"
                               asp-area="" asp-controller="Maintenance" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item ms-md-2">
                            <a class="nav-link" href="#">
                                <i class="bi bi-gear me-1"></i> Settings
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center ms-md-4 ps-md-4 border-start d-none d-md-flex">
                        <div class="text-end me-2">
                            <div class="small fw-bold">
                                @* แก้เป็น UserFullName ให้ตรงกับที่ Set ไว้ใน Controller *@
                                @(Context.Session.GetString("UserFullName") ?? "Guest User")
                            </div>
                            <div class="text-muted" style="font-size: 0.7rem;">
                                @* แก้เป็น UserSection *@
                                @(Context.Session.GetString("UserSection") ?? "No Department")
                            </div>
                        </div>

                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3" style="width:35px; height:35px;">
                            <i class="bi bi-person"></i>
                        </div>

                        <form asp-controller="Home" asp-action="Logout" method="post" id="logoutForm" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn btn-outline-danger btn-sm border-0" onclick="showLogoutAlert()">
                                <i class="bi bi-box-arrow-right"></i>
                                <span class="d-none d-lg-inline ms-1">Logout</span>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 content-wrapper">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <footer class="footer text-muted">
        <div class="container-fluid px-4">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    &copy; 2026 - <b>President Bakery PCL.</b> <span class="mx-2 text-silver">|</span> IT Systems
                </div>
                <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted me-3">Privacy Policy</a>
                    <span class="badge bg-light text-dark border">v1.2.0</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        function showLogoutAlert() {
            Swal.fire({
                title: 'ออกจากระบบ?',
                text: "คุณต้องการออกจากระบบ Zycoda Report ใช่หรือไม่?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33', // สีแดง (Danger)
                cancelButtonColor: '#6c757d', // สีเทา (Secondary)
                confirmButtonText: '<i class="bi bi-check-lg"></i> ใช่, ออกจากระบบ',
                cancelButtonText: 'ยกเลิก',
                background: '#ffffff',
                borderRadius: '15px',
                customClass: {
                    title: 'fw-bold',
                    confirmButton: 'btn btn-danger px-4',
                    cancelButton: 'btn btn-secondary px-4'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    // ถ้ากดยืนยัน ให้ส่งฟอร์ม Logout
                    document.getElementById('logoutForm').submit();
                }
            })
        }
    </script>


</body>


</html>

