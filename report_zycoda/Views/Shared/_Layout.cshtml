@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zycoda Report</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />

    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        /* ตกแต่ง Logo ZYCODA ให้ดู Modern */
        .zycoda-logo-text {
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        font-weight: 800;
        letter-spacing: 2px;
        background: linear-gradient(135deg, #001f3f 0%, #004080 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-size: 1.4rem;
        }

        .zycoda-badge {
        background-color: #001f3f;
        color: white;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.65rem;
        vertical-align: middle;
        margin-left: 5px;
        letter-spacing: 1px;
        }

        .modal-header-modern {
        border-bottom: 1px solid #f1f5f9;
        padding: 1.25rem 2rem;
        background: #ffffff;
        }

        .btn-logout-modern {
        color: #64748b; /* สีเทาเข้มแบบ Slate */
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        font-weight: 600;
        padding: 8px 16px;
        border-radius: 12px;
        }

        .btn-logout-modern:hover {
        color: #dc3545; /* เปลี่ยนเป็นสีแดงเฉพาะตอนจะกด */
        background-color: #fff1f2; /* พื้นหลังชมพูอ่อนๆ */
        transform: translateX(3px); /* ขยับขวาเบาๆ ให้ดูมี Dynamic */
        }

        .btn-logout-modern i {
        font-size: 1.1rem;
        vertical-align: middle;
        }

    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light main-nav fixed-top shadow-sm">
            <div class="container-fluid px-4">
                <a class="navbar-brand" asp-area="" asp-controller="Maintenance" asp-action="Index">
                    <div class="me-3 border-end pe-3">
                        <span class="zycoda-logo-text">ZYCODA</span>
                        <span class="zycoda-badge">REPORT</span>
                    </div>

                    @* <span class="d-none d-sm-inline">ZYCODA REPORT</span> *@
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <div class="d-flex align-items-center ms-auto ps-md-4 border-start d-none d-md-flex">

                        <div class="text-end me-3">
                            @if (User.Identity.IsAuthenticated)
                            {
                                // 1. ดึงข้อมูลจาก Claims
                                var fullName = User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value;
                                var sectionName = User.Claims.FirstOrDefault(c => c.Type == "Section")?.Value;
        
                                // 🚩 ดึง SectionOption มาแสดง
                                var sectionoption = User.Claims.FirstOrDefault(c => c.Type == "SectionOption")?.Value;

                                if (User.IsInRole("Administrator"))
                                {
                                    <span class="fw-bold text-danger">Admin: @fullName</span>
                                }
                                else
                                {
                                    <span class="fw-bold">User: @fullName</span>
                                }

                                <br />
                                @* แสดงแผนกหลัก *@
                                <small class="text-muted">แผนกหลัก: @sectionName</small>

                                @* 🚩 ถ้ามี SectionOption ให้แสดงเพิ่มบรรทัดใหม่
                                if (!string.IsNullOrEmpty(sectionoption))
                                {
                                    <br />
                                    <small class="text-primary" style="font-size: 0.75rem;">
                                        <i class="bi bi-eye"></i> สิทธิ์มองเห็น: @sectionoption
                                    </small>
                                } *@
                            }
                            else
                            {
                                <span class="text-muted">Guest User</span>
                            }
                        </div>

                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width:38px; height:38px;">
                            <i class="bi bi-person-fill"></i>
                        </div>

                        <form asp-controller="Home" asp-action="Logout" method="post" id="logoutForm" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="button"
                                    class="btn btn-logout-modern border-0 d-flex align-items-center"
                                    onclick="showLogoutAlert()"
                                    title="ออกจากระบบ Zycoda Report">
        
                                <div class="position-relative d-flex align-items-center">
                                    <i class="bi bi-power me-2"></i> <span class="d-none d-lg-inline">ออกจากระบบ</span>
                                </div>
        
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4 content-wrapper">
        <main role="main" class="pb-3">
            <br />
            @RenderBody()
        </main>
    </div>


    <footer class="footer text-muted">
        <div class="container-fluid px-4">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    &copy; 2026 - <b>President Bakery PCL.</b> <span class="mx-2 text-silver">|</span> System Development 1
                </div>
                <div class="col-md-6 text-center text-md-end mt-2 mt-md-0">
                    <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-decoration-none text-muted me-3">Privacy Policy</a>
                    <span class="badge bg-light text-dark border">v1.2.0</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
       function showLogoutAlert() {
        Swal.fire({
            title: 'ยืนยันการออกจากระบบ',
            html: 'เซสชันของคุณจะสิ้นสุดลง<br><small class="text-muted">คุณต้องการออกจากระบบ Zycoda Report ใช่หรือไม่?</small>',
            // ใช้ Icon แบบ Custom หรือเปลี่ยนเป็น Question แทน Warning จะดู Soft กว่า
            icon: 'question', 
            iconColor: '#001f3f', // สี Navy ตาม Branding ของฟาย
            showCancelButton: true,
            confirmButtonText: 'ออกจากระบบ',
            cancelButtonText: 'กลับไปทำงานต่อ',
            reverseButtons: true, // เอาปุ่มยืนยันไว้ขวา (ตามหลัก UI สมัยใหม่)
        
            // ตกแต่งความสวยงาม
            background: '#ffffff',
            padding: '2rem',
            color: '#001f3f',
            backdrop: `rgba(0,31,63,0.1)`, // พื้นหลังมัวๆ สี Navy จางๆ
        
            showClass: {
                popup: 'animate__animated animate__fadeInUp animate__faster' // ต้องลง animate.css หรือใช้ default ก็ได้
            },
            hideClass: {
                popup: 'animate__animated animate__fadeOutDown animate__faster'
            },

            customClass: {
                title: 'fw-bold fs-4 mb-2',
                htmlContainer: 'mb-4',
                confirmButton: 'btn btn-navy px-4 py-2 rounded-pill shadow-sm ms-3',
                cancelButton: 'btn btn-link text-muted fw-bold text-decoration-none'
            },
            buttonsStyling: false // ปิด Style พื้นฐานของ Swal เพื่อใช้ Bootstrap ของเราเอง
              }).then((result) => {
                if (result.isConfirmed) {
                    // 1. แสดง Loading ทันทีที่กดยืนยัน
                    Swal.fire({
                        title: 'กำลังออกจากระบบ...',
                        html: 'กรุณารอสักครู่ ระบบกำลังปิดเซสชันการทำงาน',
                        allowOutsideClick: false,
                        didOpen: () => {
                            Swal.showLoading(); // แสดง Spinner ของ Swal
                        }
                    });

                    // 2. ใช้ setTimeout เพื่อหน่วงเวลาให้ User เห็น UI แป๊บหนึ่ง (1500ms = 1.5 วินาที)
                    setTimeout(() => {
                        document.getElementById('logoutForm').submit();
                    }, 1500); 
                }
            });
    }
    </script>


</body>


</html>

