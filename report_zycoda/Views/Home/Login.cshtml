@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;
    var version = "1.0.0";
    // ดึงเวลาที่ Build หรือเวลาที่ไฟล์ DLL แก้ไขล่าสุด
    var assemblyPath = System.Reflection.Assembly.GetExecutingAssembly().Location;
    var buildDate = System.IO.File.GetLastWriteTime(assemblyPath).ToString("dd/MM/yyyy HH:mm");
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Zycoda Report</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <link href="~/css/home_login.css" rel="stylesheet">

    <style>
        /* จังหวะตัวไอคอนเด้ง */
        .bouncing-container {
            position: relative;
            animation: bounce 0.6s cubic-bezier(0.28, 0.84, 0.42, 1) infinite alternate;
        }

        @@keyframes bounce {
            0% { transform: translateY(0); }
            100% { transform: translateY(-30px); }
        }

        /* เงาที่พื้นเด้งตามจังหวะ */
        .shadow-pulse {
            width: 40px;
            height: 8px;
            background: rgba(0, 0, 0, 0.1);
            border-radius: 50%;
            margin: 10px auto 0;
            animation: shadowSize 0.6s cubic-bezier(0.28, 0.84, 0.42, 1) infinite alternate;
        }

        @@keyframes shadowSize {
            0% { transform: scale(1); opacity: 0.4; }
            100% { transform: scale(0.4); opacity: 0.1; }
        }

        .loading-text {
            letter-spacing: 1px;
        }
    </style>

    </head>

    <body>
        <canvas id="network-canvas"></canvas>

        <div class="login-box">
            <div class="brand-logo">
                <h1>ZYCODA REPORT</h1>
                <p style="color: #cbd5e1; font-size: 14px; margin-top: 8px; font-weight: 300; min-height: 20px;">
                    <span id="typing-effect"></span><span class="cursor">|</span>
                </p>
            </div>

            <form method="post" asp-controller="Home" asp-action="Login">
                <div class="form-group">
                    <label>Username</label>
                    <input type="text" name="username" placeholder="ระบุรหัสพนักงาน" required autocomplete="off" />
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <input type="password" name="password" placeholder="ระบุรหัสผ่าน" required />
                </div>

               @if (ViewBag.DebugLog != null)
                {
                    <div class="alert alert-secondary mt-3" style="font-family: 'Courier New', Courier, monospace; font-size: 12px;">
                        <h6>🛠 Debug Log:</h6>
                        <ul class="list-unstyled">
                            @foreach (var log in ViewBag.DebugLog)
                            {
                                <li>@log</li>
                            }
                        </ul>
                    </div>
                }

                <button type="submit" class="btn-login">Sign In</button>

            </form>

           <div class="footer-text">
                &copy; 2026 Zycoda. All rights reserved. <br />
                <small style="opacity: 0.7; font-weight: 300; letter-spacing: 0.5px;">
                    v.@version | Last Build: @buildDate
                </small>
            </div>
        </div>

        <div id="git-loader" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(255,255,255,0.9); z-index:9999; flex-direction:column; align-items:center; justify-content:center;">
            <div class="bouncing-container mb-4">
                <i class="bi bi-tools text-navy" style="font-size: 3rem;"></i>
                <div class="shadow-pulse"></div>
            </div>
    
            <div class="loading-text fw-bold text-navy mb-2">กำลังเตรียมข้อมูล...</div>
    
            <div class="progress" style="width: 250px; height: 6px; border-radius: 10px; background-color: #e9ecef;">
                <div id="git-progress" class="progress-bar progress-bar-striped progress-bar-animated bg-navy" style="width: 0%; border-radius: 10px; transition: width 0.3s ease;"></div>
            </div>
        </div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<script>
    // --- 1. Network Background --- (Code เดิมของคุณ Fai ทำงานได้ดีครับ)
    const canvas = document.getElementById('network-canvas');
    const ctx = canvas.getContext('2d');
    let dots = [];
    const dotCount = 80;
    const maxDistance = 150;

    function init() {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        dots = [];
        for (let i = 0; i < dotCount; i++) {
            dots.push({
                x: Math.random() * canvas.width,
                y: Math.random() * canvas.height,
                vx: (Math.random() - 0.5) * 0.5,
                vy: (Math.random() - 0.5) * 0.5,
                size: Math.random() * 2 + 1
            });
        }
    }

    function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        for (let i = 0; i < dots.length; i++) {
            let d = dots[i];
            d.x += d.vx; d.y += d.vy;
            if (d.x < 0 || d.x > canvas.width) d.vx *= -1;
            if (d.y < 0 || d.y > canvas.height) d.vy *= -1;
            ctx.beginPath();
            ctx.arc(d.x, d.y, d.size, 0, Math.PI * 2);
            ctx.fillStyle = "rgba(56, 189, 248, 0.4)";
            ctx.fill();
            for (let j = i + 1; j < dots.length; j++) {
                let d2 = dots[j];
                let dist = Math.hypot(d.x - d2.x, d.y - d2.y);
                if (dist < maxDistance) {
                    ctx.beginPath();
                    ctx.moveTo(d.x, d.y);
                    ctx.lineTo(d2.x, d2.y);
                    ctx.strokeStyle = `rgba(56, 189, 248, ${1 - dist / maxDistance - 0.5})`;
                    ctx.lineWidth = 0.5;
                    ctx.stroke();
                }
            }
        }
        requestAnimationFrame(draw);
    }
    window.addEventListener('resize', init);
    init(); draw();

    // --- 2. Typing Effect ---
    const textElement = document.getElementById("typing-effect");
    const text = "System Maintenance & Analytics";
    let typeIndex = 0;
    let isDeleting = false;

    function type() {
        const currentText = text.substring(0, typeIndex);
        if (textElement) textElement.innerHTML = currentText;
        if (!isDeleting && typeIndex < text.length) {
            typeIndex++;
            setTimeout(type, 100);
        } else if (isDeleting && typeIndex > 0) {
            typeIndex--;
            setTimeout(type, 50);
        } else if (!isDeleting && typeIndex === text.length) {
            isDeleting = true;
            setTimeout(type, 2000);
        } else {
            isDeleting = false;
            setTimeout(type, 500);
        }
    }

    // --- 3. Optimized Loading Logic ---
    window.currentFullName = ""; // ตัวแปรเก็บชื่อ Global

    // ฟังก์ชันช่วยดึงชื่อ
    function fetchName(userCode) {
        if (!userCode) return;
        return $.get('@Url.Action("GetFirstName", "Home")', { username: userCode.trim() }, function(data) {
            if (data && data.firstName) {
                window.currentFullName = data.firstName;
            }
        });
    }

    // เมื่อพิมพ์รหัสเสร็จแล้วย้ายไปช่องอื่น
    $('input[name="username"]').on('blur', function() {
        fetchName($(this).val());
    });

    const loginForm = document.querySelector('form');
    if (loginForm) {
        loginForm.onsubmit = async function(e) {
            e.preventDefault(); // หยุดการส่งฟอร์มชั่วคราวเพื่อเล่น Animation

            const userCode = $('input[name="username"]').val();
            
            // ถ้าชื่อยังไม่มา (กรณีพิมพ์เสร็จแล้วกด Enter ทันที) ให้รอเรียก AJAX อีกรอบ
            if (!window.currentFullName) {
                await fetchName(userCode);
            }

            const displayName = window.currentFullName || "พนักงาน Zycoda";
            const loader = document.getElementById('git-loader');
            const statusText = document.querySelector('.loading-text');
            const progressBar = document.getElementById('git-progress');

            if (loader) loader.style.display = 'flex';

            const statusSteps = [
                `สวัสดีค่ะคุณ ${displayName}...`,
                "กำลังจัดเตรียมพื้นที่ทำงานให้คุณ...",
                "เชื่อมต่อฐานข้อมูล Zycoda...",
                "ตรวจสอบสิทธิ์การเข้าถึง...",
                "เรียบร้อยแล้ว! กำลังนำคุณเข้าสู่ระบบ..."
            ];

            let progressValue = 0;
            const loadingInterval = setInterval(() => {
                progressValue += Math.floor(Math.random() * 15) + 5;
                if (progressValue > 100) progressValue = 100;

                if (progressBar) progressBar.style.width = progressValue + "%";

                let stepIndex = Math.min(Math.floor(progressValue / 21), statusSteps.length - 1);
                if (statusText) statusText.innerText = statusSteps[stepIndex];

                if (progressValue >= 100) {
                    clearInterval(loadingInterval);
                    // เมื่อโหลดครบ 100% ให้ส่งฟอร์มจริงๆ ไปยัง Controller
                    loginForm.submit();
                }
            }, 300);
        };
    }

    document.addEventListener("DOMContentLoaded", type);
</script>

    </body>

</html>