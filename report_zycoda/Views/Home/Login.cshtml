@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Zycoda Report</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            font-family: 'Inter', 'Segoe UI', sans-serif;
        }

        body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #0f172a; /* พื้นหลังสีเข้มเพื่อให้เส้นโครงข่ายเด่น */
            overflow: hidden;
            position: relative;
        }

        /* Canvas สำหรับวาดโครงข่ายขยับได้ */
        #network-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
        }

        .login-box {
            background: rgba(255, 255, 255, 0.08); /* เอฟเฟกต์กระจกใส */
            padding: 50px 40px;
            border-radius: 24px;
            width: 400px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            z-index: 1;
            position: relative;
        }

        .brand-logo {
            text-align: center;
            margin-bottom: 35px;
        }

            .brand-logo h1 {
                margin: 0;
                font-size: 28px;
                color: #ffffff;
                letter-spacing: 1px;
                font-weight: 600;
                text-shadow: 0 2px 10px rgba(0,0,0,0.3);
            }

            .brand-logo p {
                color: #cbd5e1;
                font-size: 14px;
                margin-top: 8px;
                font-weight: 300;
            }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            font-size: 12px;
            font-weight: 600;
            color: #94a3b8;
            display: block;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        input {
            width: 100%;
            padding: 14px 16px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            transition: all 0.3s ease;
            font-size: 15px;
            background: rgba(255, 255, 255, 0.05);
            color: white;
        }

            input::placeholder {
                color: #64748b;
            }

            input:focus {
                outline: none;
                border-color: #38bdf8;
                background: rgba(255, 255, 255, 0.1);
                box-shadow: 0 0 0 4px rgba(56, 189, 248, 0.2);
            }

        .btn-login {
            width: 100%;
            padding: 14px;
            background: #38bdf8;
            color: #0f172a;
            border: none;
            border-radius: 12px;
            margin-top: 10px;
            cursor: pointer;
            font-weight: 700;
            font-size: 16px;
            transition: all 0.3s ease;
        }

            .btn-login:hover {
                background: #7dd3fc;
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(56, 189, 248, 0.3);
            }

        .error-msg {
            color: #fb7185;
            font-size: 13px;
            margin-bottom: 15px;
            text-align: center;
            background: rgba(251, 113, 133, 0.1);
            padding: 10px;
            border-radius: 8px;
            border: 1px solid rgba(251, 113, 133, 0.2);
        }

        .footer-text {
            text-align: center;
            margin-top: 30px;
            font-size: 11px;
            color: #64748b;
            letter-spacing: 0.5px;
        }

        .typing-text {
            color: #cbd5e1;
            font-size: 14px;
            margin-top: 8px;
            font-weight: 300;
            /* 🚩 ส่วนหัวใจของ Typewriter Effect */
            display: inline-block;
            overflow: hidden; /* ซ่อนตัวอักษรที่ยังพิมพ์ไม่ถึง */
            border-right: 2px solid #38bdf8; /* เส้น Cursor กระพริบ */
            white-space: nowrap; /* ห้ามขึ้นบรรทัดใหม่ */
            margin: 0 auto;
            letter-spacing: 1px;
            /* สั่งให้เล่น Animation: พิมพ์ 3.5 วินาที, Cursor กระพริบตลอดเวลา */
            animation: typing 3.5s steps(30, end), blink-caret .75s step-end infinite;
        }

        /* Animation สำหรับการพิมพ์ (ขยายความกว้างจาก 0 ไป 100%) */
        @@keyframes typing {
            from

        {
            width: 0
        }

        to {
            width: 100%
        }

        }

        .cursor {
            color: #38bdf8;
            font-weight: bold;
            margin-left: 2px;
            animation: blink 0.7s infinite;
        }

        @@keyframes blink {
            0%, 100% {
                opacity: 1;
            }

            50% {
                opacity: 0;
            }
        }

        /* Animation สำหรับ Cursor กระพริบ */
        @@keyframes blink-caret {
            from, to

            {
                border-color: transparent
            }

            50% {
                border-color: #38bdf8
            }

        }

        #loading-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.85);
            z-index: 9999;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            color: white;
            font-size: 14px;
            letter-spacing: 1px;
        }

        .spinner {
            border: 5px solid rgba(255,255,255,0.2);
            border-top: 5px solid #38bdf8;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            animation: spin 0.8s linear infinite;
            margin-bottom: 10px;
        }

        @@keyframes spin {
            0%

        {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }

        }


    </style>
</head>

<body>
    <canvas id="network-canvas"></canvas>

    <div class="login-box">
        <div class="brand-logo">
            <h1>ZYCODA REPORT</h1>
            <p style="color: #cbd5e1; font-size: 14px; margin-top: 8px; font-weight: 300; min-height: 20px;">
                <span id="typing-effect"></span><span class="cursor">|</span>
            </p>
        </div>

        <form method="post" asp-controller="Home" asp-action="Login">
            <div class="form-group">
                <label>Username</label>
                <input type="text" name="username" placeholder="ระบุรหัสพนักงาน" required autocomplete="off" />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" placeholder="ระบุรหัสผ่าน" required />
            </div>

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="error-msg">
                    @ViewBag.ErrorMessage
                </div>
            }

            <button type="submit" class="btn-login">Sign In</button>
        </form>

        <div class="footer-text">
            &copy; 2026 Zycoda. All rights reserved.
        </div>
        <div id="loading-overlay">
            <div class="spinner"></div>
            <p>Signing in...</p>
        </div>
    </div>
   


    <script>
        const canvas = document.getElementById('network-canvas');
        const ctx = canvas.getContext('2d');
        let dots = [];
        const dotCount = 80; // จำนวนจุด
        const maxDistance = 150; // ระยะห่างที่จะเชื่อมเส้น

        function init() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            dots = [];
            for (let i = 0; i < dotCount; i++) {
                dots.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.5,
                    vy: (Math.random() - 0.5) * 0.5,
                    size: Math.random() * 2 + 1
                });
            }
        }

        function draw() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            for (let i = 0; i < dots.length; i++) {
                let d = dots[i];
                d.x += d.vx;
                d.y += d.vy;

                // สะท้อนขอบจอ
                if (d.x < 0 || d.x > canvas.width) d.vx *= -1;
                if (d.y < 0 || d.y > canvas.height) d.vy *= -1;

                ctx.beginPath();
                ctx.arc(d.x, d.y, d.size, 0, Math.PI * 2);
                ctx.fillStyle = "rgba(56, 189, 248, 0.5)";
                ctx.fill();

                // วาดเส้นเชื่อม
                for (let j = i + 1; j < dots.length; j++) {
                    let d2 = dots[j];
                    let dist = Math.hypot(d.x - d2.x, d.y - d2.y);
                    if (dist < maxDistance) {
                        ctx.beginPath();
                        ctx.moveTo(d.x, d.y);
                        ctx.lineTo(d2.x, d2.y);
                        ctx.strokeStyle = `rgba(56, 189, 248, ${1 - dist / maxDistance - 0.5})`;
                        ctx.lineWidth = 0.5;
                        ctx.stroke();
                    }
                }
            }
            requestAnimationFrame(draw);
        }

        window.addEventListener('resize', init);
        init();
        draw();


        //ตอนพิมพ์
        const textElement = document.getElementById("typing-effect");
        const text = "System Maintenance & Analytics";
        let index = 0;
        let isDeleting = false;
        let speed = 100; // ความเร็วในการพิมพ์

        function type() {
            // ตัดคำตาม index ปัจจุบัน
            const currentText = text.substring(0, index);
            textElement.innerHTML = currentText;

            if (!isDeleting && index < text.length) {
                // กำลังพิมพ์
                index++;
                speed = 100;
            } else if (isDeleting && index > 0) {
                // กำลังลบ
                index--;
                speed = 50; // ลบเร็วกว่าพิมพ์นิดนึง
            } else if (!isDeleting && index === text.length) {
                // พิมพ์ครบแล้ว รอ 2 วินาทีก่อนเริ่มลบ
                isDeleting = true;
                speed = 2000;
            } else if (isDeleting && index === 0) {
                // ลบหมดแล้ว เริ่มพิมพ์ใหม่
                isDeleting = false;
                speed = 500;
            }

            setTimeout(type, speed);
        }

        // เริ่มทำงาน
        document.addEventListener("DOMContentLoaded", type);

    </script>
</body>
</html>