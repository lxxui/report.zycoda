@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;
    var version = "1.1.0";
    var assemblyPath = System.Reflection.Assembly.GetExecutingAssembly().Location;
    var buildDate = System.IO.File.GetLastWriteTime(assemblyPath).ToString("dd/MM/yyyy HH:mm");
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Zycoda Report</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --primary: #38bdf8;
            --primary-glow: rgba(56, 189, 248, 0.3);
            --bg-dark: #0f172a;
            --card-bg: rgba(30, 41, 59, 0.7);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --input-bg: rgba(15, 23, 42, 0.6);
        }

        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-main);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* --- Network Canvas Background --- */
        #network-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
        }

        /* --- Login Card Container --- */
        .login-container {
            width: 100%;
            max-width: 420px;
            padding: 20px;
            animation: fadeIn 0.8s ease-out;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .login-card {
            background: var(--card-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 28px;
            padding: 45px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        .brand-logo {
            text-align: center;
            margin-bottom: 35px;
        }

            .brand-logo h1 {
                font-size: 32px;
                font-weight: 700;
                letter-spacing: -1px;
                margin: 0;
                background: linear-gradient(135deg, #38bdf8 0%, #818cf8 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

        .typing-container {
            font-size: 14px;
            color: var(--text-muted);
            margin-top: 8px;
            min-height: 20px;
            font-weight: 300;
        }

        /* --- Form Elements --- */
        .form-group {
            margin-bottom: 24px;
        }

            .form-group label {
                display: block;
                font-size: 13px;
                font-weight: 500;
                color: var(--text-muted);
                margin-bottom: 8px;
                margin-left: 4px;
            }

        .input-wrapper {
            position: relative;
        }

            .input-wrapper i {
                position: absolute;
                left: 16px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--text-muted);
                font-size: 18px;
            }

        input {
            width: 100%;
            padding: 14px 16px 14px 48px;
            background: var(--input-bg);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 14px;
            color: #fff;
            font-size: 15px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-sizing: border-box;
        }

            input:focus {
                outline: none;
                border-color: var(--primary);
                background: rgba(15, 23, 42, 0.8);
                box-shadow: 0 0 0 4px var(--primary-glow);
            }

        .btn-login {
            width: 100%;
            padding: 16px;
            background: var(--primary);
            border: none;
            border-radius: 14px;
            color: #0f172a;
            font-weight: 600;
            font-size: 16px;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 10px;
        }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 20px -5px var(--primary-glow);
                filter: brightness(1.1);
            }

        .footer-text {
            text-align: center;
            margin-top: 35px;
            color: var(--text-muted);
            font-size: 13px;
            line-height: 1.6;
        }

        /* --- Loading Overly (Dark Theme) --- */
        #git-loader {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(10px);
            z-index: 9999;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .bouncing-container {
            position: relative;
            animation: bounce 0.8s cubic-bezier(0.28, 0.84, 0.42, 1) infinite alternate;
            color: var(--primary);
        }

        @@keyframes bounce {
            0% {
                transform: translateY(0);
            }

            100% {
                transform: translateY(-25px);
            }
        }

        .progress-container {
            width: 280px;
            height: 6px;
            background: rgba(255,255,255,0.1);
            border-radius: 10px;
            margin-top: 25px;
            overflow: hidden;
        }

        #git-progress {
            height: 100%;
            background: var(--primary);
            width: 0%;
            transition: width 0.4s ease;
            box-shadow: 0 0 15px var(--primary);
        }

        .cursor {
            animation: blink 1s infinite;
        }

        @@keyframes blink {
            50% {
                opacity: 0;
            }
        }

            .swal2-popup {
                border: 1px solid rgba(5, 150, 105, 0.3) !important; /* ขอบเขียวจางๆ */
                box-shadow: 0 0 20px rgba(0, 0, 0, 0.5), 0 0 15px rgba(5, 150, 105, 0.1) !important;
            }

            .swal2-title {
                font-family: 'Inter', 'Kanit', sans-serif !important;
                /* Custom Style สำหรับ SweetAlert ให้เข้ากับ Zycoda Theme */
                .zycoda-alert-popup {
                    border: 1px solid rgba(56, 189, 248, 0.2) !important; /* ขอบฟ้าจางๆ */
                    border-radius: 24px !important;
                    backdrop-filter: blur(12px) !important; /* ทำ Glassmorphism */
                    box-shadow: 0 0 40px rgba(0, 0, 0, 0.6), 0 0 20px rgba(56, 189, 248, 0.1) !important;
                }

                .zycoda-confirm-btn {
                    padding: 12px 30px !important;
                    border-radius: 12px !important;
                    font-weight: 600 !important;
                    color: #0f172a !important; /* ตัวหนังสือสีเข้มตัดกับปุ่มสีฟ้า */
                    transition: all 0.3s ease !important;
                }

                    .zycoda-confirm-btn:hover {
                        box-shadow: 0 0 15px var(--primary-glow) !important;
                        transform: translateY(-1px);
                    }

                .zycoda-title {
                    padding-top: 10px !important;
                }
    </style>
</head>
<body>

    <canvas id="network-canvas"></canvas>

    <div class="login-container">
        <div class="login-card">
            <div class="brand-logo">
                <h1>ZYCODA REPORT</h1>
                <div class="typing-container">
                    <span id="typing-effect"></span><span class="cursor">|</span>
                </div>
            </div>

            <form method="post" asp-controller="Home" asp-action="Login">
                <div class="form-group">
                    <label>Username</label>
                    <div class="input-wrapper">
                        <i class="bi bi-person"></i>
                        <input type="text" name="username" placeholder="รหัสพนักงาน" required autocomplete="off" />
                    </div>
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <div class="input-wrapper">
                        <i class="bi bi-lock"></i>
                        <input type="password" name="password" placeholder="รหัสผ่าน" required />
                    </div>
                </div>

                <button type="submit" class="btn-login">Sign In</button>
            </form>

            <div class="footer-text">
                &copy; 2026 Zycoda Analytics. All rights reserved.<br />
                <span style="opacity: 0.6; font-size: 11px;">v.@version | Build: @buildDate</span>
            </div>
        </div>
    </div>

    <!-- Modern Loader Overlay -->
    <div id="git-loader">
        <div class="bouncing-container">
            <i class="bi bi-cpu" style="font-size: 3.5rem;"></i>
        </div>
        <div class="loading-text" style="margin-top: 20px; font-weight: 500; letter-spacing: 0.5px;">กำลังเตรียมข้อมูล...</div>
        <div class="progress-container">
            <div id="git-progress"></div>
        </div>
    </div>

    <!-- นำเข้า Library ที่จำเป็นให้ครบ -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            console.log("🚀 System: Zycoda Login Ready!");

            // --- 1. จัดการ UI & Animations ---
            try {
                initNetwork();
                type();
                console.log("🎨 UI Animations: Online");
            } catch (e) {
                console.error("🎨 UI Error:", e);
            }

            // --- 2. ตรวจสอบ Error จากฝั่ง Controller ---
            var errorMsg = `@Html.Raw(TempData["ErrorMessage"] ?? "")`;
            console.log("📝 Server Message (TempData):", errorMsg);

            if (errorMsg && errorMsg !== "null" && errorMsg.trim() !== "") {
                console.error("❌ Login Fail Detail:", errorMsg);
               Swal.fire({
                icon: 'error',
                // ปรับหัวข้อให้ดู Modern ขึ้น
                title: '<span style="color: #f8fafc; font-weight: 700; letter-spacing: -0.5px;">Login Required</span>',
                text: errorMsg,
    
                // Theme Matching (Matching กับ --bg-dark และ --primary)
                background: '#0f172a', 
                color: '#94a3b8',
                iconColor: '#38bdf8', // สีฟ้า Glow แบบในหน้า Login
    
                showConfirmButton: true,
                confirmButtonText: 'Try Again',
                confirmButtonColor: '#38bdf8', // สีฟ้า Primary
                buttonsStyling: true,

                customClass: {
                    popup: 'zycoda-alert-popup',
                    confirmButton: 'zycoda-confirm-btn',
                    title: 'zycoda-title'
                },
    
                // Animation การแสดงผล (Fade + Scale)
                showClass: {
                    popup: 'animate__animated animate__zoomIn animate__faster'
                },
                hideClass: {
                    popup: 'animate__animated animate__fadeOut animate__faster'
                }
            });
            }

            // --- 3. AJAX ดึงชื่อพนักงานตอน Blur (แค่แสดงผลสวยๆ) ---
            window.currentFullName = "";
            $('input[name="username"]').on('blur', function() {
                const val = $(this).val();
                if(val) {
                    console.log("🔍 Fetching info for:", val);
                    $.get('@Url.Action("GetFirstName", "Home")', { username: val.trim() })
                     .done(function(data) {
                        if (data && data.firstName) {
                            window.currentFullName = data.firstName;
                            console.log("✅ User Identified:", window.currentFullName);
                        }
                     })
                     .fail(function(err) {
                        console.warn("⚠️ API GetFirstName failed (Maybe user doesn't exist yet)");
                     });
                }
            });

            // --- 4. ก้อนหลัก: จัดการการส่งฟอร์ม (Submit) ---
            // ใช้ Selector 'form' เพื่อความชัวร์ว่าครอบคลุมแน่นอน
            $('form').on('submit', function (e) {
                console.log("🔘 Action: Sign In Clicked");
                e.preventDefault(); // หยุด Default Submit เพื่อเล่น Animation

                const form = this;
                const $loader = $('#git-loader');
                const $statusText = $('.loading-text');
                const $progressBar = $('#git-progress');

                // แสดง Loader
                $loader.css('display', 'flex');
                console.log("⏳ Loader: Started");

                const displayName = window.currentFullName || "User";
                const steps = [
                    `ยินดีต้อนรับคุณ ${displayName}`,
                    "กำลังยืนยันตัวตน...",
                    "เชื่อมต่อ Secure Gateway...",
                    "เรียบร้อย! กำลังพาคุณเข้าสู่ระบบ..."
                ];

                let progress = 0;
                const interval = setInterval(() => {
                    progress += Math.floor(Math.random() * 20) + 5;
                    if (progress > 100) progress = 100;

                    $progressBar.css('width', progress + "%");
                
                    // คำนวณ Step ข้อความ
                    let stepIdx = Math.min(Math.floor(progress / 26), steps.length - 1);
                    $statusText.text(steps[stepIdx]);

                    console.log(`📊 Progress: ${progress}% | Status: ${steps[stepIdx]}`);

                    if (progress >= 100) {
                        clearInterval(interval);
                        console.log("✅ Ready! Submitting form to Controller...");
                    
                        // สั่งส่งฟอร์มจริง
                        try {
                            form.submit();
                        } catch (submitError) {
                            console.error("🛑 Native Submit Error:", submitError);
                            // Fallback กรณี form.submit() พัง
                            $(form).off('submit').submit();
                        }
                    }
                }, 200);
            });
        });

        // --- 5. Supporting Functions (Background & Typing) ---
        function initNetwork() {
            const canvas = document.getElementById('network-canvas');
            if(!canvas) return;
            const ctx = canvas.getContext('2d');
            let dots = [];
            const dotCount = 100;

            function resize() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
                dots = [];
                for (let i = 0; i < dotCount; i++) {
                    dots.push({
                        x: Math.random() * canvas.width,
                        y: Math.random() * canvas.height,
                        vx: (Math.random() - 0.5) * 0.4,
                        vy: (Math.random() - 0.5) * 0.4,
                        size: Math.random() * 1.5 + 0.5
                    });
                }
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                ctx.fillStyle = "rgba(56, 189, 248, 0.3)";
                for (let i = 0; i < dots.length; i++) {
                    let d = dots[i];
                    d.x += d.vx; d.y += d.vy;
                    if (d.x < 0 || d.x > canvas.width) d.vx *= -1;
                    if (d.y < 0 || d.y > canvas.height) d.vy *= -1;
                    ctx.beginPath();
                    ctx.arc(d.x, d.y, d.size, 0, Math.PI * 2);
                    ctx.fill();
                    for (let j = i + 1; j < dots.length; j++) {
                        let d2 = dots[j];
                        let dist = Math.hypot(d.x - d2.x, d.y - d2.y);
                        if (dist < 150) {
                            ctx.beginPath();
                            ctx.strokeStyle = `rgba(56, 189, 248, ${0.15 - dist / 1000})`;
                            ctx.lineWidth = 0.5;
                            ctx.moveTo(d.x, d.y);
                            ctx.lineTo(d2.x, d2.y);
                            ctx.stroke();
                        }
                    }
                }
                requestAnimationFrame(draw);
            }
            window.addEventListener('resize', resize);
            resize(); draw();
        }

        function type() {
            const textElement = document.getElementById("typing-effect");
            if(!textElement) return;
            const phrases = ["System Maintenance & Analytics", "Real-time Data Processing", "Secure Cloud Infrastructure"];
            let pIdx = 0, cIdx = 0, isDel = false;

            function loop() {
                const current = phrases[pIdx];
                textElement.textContent = isDel ? current.substring(0, cIdx--) : current.substring(0, cIdx++);
                let speed = isDel ? 50 : 100;
                if (!isDel && cIdx > current.length) { isDel = true; speed = 2000; }
                else if (isDel && cIdx < 0) { isDel = false; pIdx = (pIdx + 1) % phrases.length; speed = 500; }
                setTimeout(loop, speed);
            }
            loop();
        }
    </script>
</body>
</html>