@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Zycoda Report</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            font-family: 'Inter', 'Segoe UI', sans-serif;
        }

        body {
            /* ปรับ Gradient ให้ดูซอฟต์และแพงขึ้น */
            background: radial-gradient(circle at top left, #1e3c72 0%, #2a5298 100%);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0;
        }

        .login-box {
            background: rgba(255, 255, 255, 0.95);
            padding: 50px 40px;
            border-radius: 20px;
            width: 400px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
            backdrop-filter: blur(10px); /* สไตล์กระจกฝ้าเล็กน้อย */
        }

        .brand-logo {
            text-align: center;
            margin-bottom: 30px;
        }

            .brand-logo h1 {
                margin: 0;
                font-size: 28px;
                color: #1e3c72;
                letter-spacing: -1px;
                font-weight: 600;
            }

            .brand-logo p {
                color: #666;
                font-size: 14px;
                margin-top: 5px;
            }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            font-size: 13px;
            font-weight: 600;
            color: #444;
            display: block;
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        input {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid #ddd;
            border-radius: 8px;
            transition: all 0.3s ease;
            font-size: 15px;
        }

            input:focus {
                outline: none;
                border-color: #2a5298;
                box-shadow: 0 0 0 4px rgba(42, 82, 152, 0.1);
            }

        .btn-login {
            width: 100%;
            padding: 14px;
            background: #1e3c72;
            color: white;
            border: none;
            border-radius: 8px;
            margin-top: 10px;
            cursor: pointer;
            font-weight: 600;
            font-size: 16px;
            transition: transform 0.2s, background 0.3s;
        }

            .btn-login:hover {
                background: #2a5298;
                transform: translateY(-1px);
            }

            .btn-login:active {
                transform: translateY(0);
            }

        .footer-text {
            text-align: center;
            margin-top: 25px;
            font-size: 12px;
            color: #888;
        }
    </style>
</head>

<body>
    <div class="login-box">
        <div class="brand-logo">
            <h1>ZYCODA REPORT</h1>
            <p>System Maintenance & Analytics</p>
        </div>

        @* 🚩 ปรับให้ยิงไปที่ Home/Login เพื่อเช็ครหัส 723582 *@
        @* --- จุดที่ 1: แก้ไข Action และ Controller --- *@
        <form method="post" asp-controller="Home" asp-action="Login">
            <div class="form-group">
                <label>Username</label>
                @* --- จุดที่ 2: name ต้องเป็น "username" ตัวเล็กตาม Model --- *@
                <input type="text" name="username" placeholder="ระบุรหัสพนักงาน" required />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" placeholder="ระบุรหัสผ่าน" required />
            </div>

            @if (ViewBag.ErrorMessage != null)
            {
                <div style="color: #ff4d4d; font-size: 13px; margin-bottom: 15px; text-align: center;">
                    @ViewBag.ErrorMessage
                </div>
            }

            <button type="submit" class="btn-login">Sign In</button>
        </form>
        <div class="footer-text">
            &copy; 2026 Zycoda. All rights reserved.
        </div>
    </div>
</body>
</html>