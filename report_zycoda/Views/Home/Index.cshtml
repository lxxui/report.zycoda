@model List<report_zycoda.Models.MaintenanceReport>

@{
    var jobtype = Context.Request.Query["jobtype"].ToString();
    var start = Context.Request.Query["start"].ToString();
    var end = Context.Request.Query["end"].ToString();
}

<h2>Maintenance Report</h2>

<form method="get" style="margin-bottom:20px">

    Job Type
    <select name="jobtype">
        <option value="EM" selected="@(jobtype == "EM")">EM</option>
        <option value="CM" selected="@(jobtype == "CM")">CM</option>
        <option value="EM,CM" selected="@(jobtype == "EM,CM")">EM + CM</option>
    </select>

    Start
    <input type="date" name="start" value="@start">

    End
    <input type="date" name="end" value="@end">

    <button type="submit">Search</button>

</form>

<p>
    Total Records :
    <b>@(Model != null ? Model.Count : 0)</b>
</p>

<table border="1" cellpadding="8" style="width:100%;border-collapse:collapse">

    <thead style="background:#f2f2f2">
        <tr>
            <th>ID</th>
            <th>Machine</th>
            <th>Problem</th>
            <th>Cause</th>
            <th>Downtime</th>
            <th>Status</th>
            <th>Create By</th>
        </tr>
    </thead>

    <tbody>

        @if (Model != null && Model.Count > 0)
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.id</td>
                    <td>@item.fldetail</td>
                    <td>@item.problem</td>
                    <td>@item.causes</td>
                    <td>@item.downtime นาที</td>
                    <td>@item.statustext</td>
                    <td>@item.usercreate</td>
                </tr>
            }
        }

        else
        {
            <tr>
                <td colspan="7" style="text-align:center">
                    No data found
                </td>
            </tr>
        }

    </tbody>

</table>