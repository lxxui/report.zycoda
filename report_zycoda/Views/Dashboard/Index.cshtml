@{
    ViewData["Title"] = "Report Dashboard";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-navy">ZYCODA REPORT SYSTEM</h2>
        <p class="text-muted">เลือกรายงานที่คุณต้องการตรวจสอบข้อมูล</p>
        <hr class="mx-auto" style="width: 50px; border: 2px solid #1e3c72;">
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <a asp-controller="Maintenance" asp-action="Index" asp-route-v="myjob" class="card-link">
                <div class="card h-100 shadow-sm border-0 report-card dashboard-main">
                    <div class="card-body p-4">
                        <div class="icon-box mb-3 text-navy"><i class="bi bi-speedometer2"></i></div>
                        <h5 class="card-title fw-bold">ภาพรวมข้อมูลงานแจ้งซ่อม</h5>
                        <p class="card-text text-muted small">Dashboard สรุปสถานะงานซ่อมทั้งหมด กรองข้อมูลตามประเภทงานและวันที่</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a asp-controller="Maintenance" asp-action="ReportReceiver" class="card-link">
                <div class="card h-100 shadow-sm border-0 report-card">
                    <div class="card-body p-4">
                        <div class="icon-box mb-3"><i class="bi bi-clipboard-check"></i></div>
                        <h5 class="card-title fw-bold">ติดตาม Job (ผู้รับแจ้ง)</h5>
                        <p class="card-text text-muted small">ตรวจสอบความคืบหน้างานสำหรับเจ้าหน้าที่รับแจ้งงาน</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a asp-controller="Maintenance" asp-action="ReportSender" class="card-link">
                <div class="card h-100 shadow-sm border-0 report-card">
                    <div class="card-body p-4">
                        <div class="icon-box mb-3 text-success"><i class="bi bi-person-badge"></i></div>
                        <h5 class="card-title fw-bold">ติดตาม Job (ผู้แจ้ง)</h5>
                        <p class="card-text text-muted small">สำหรับหน่วยงานที่เป็นผู้แจ้งงานตรวจสอบสถานะ</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-4">
            <a href="#" class="card-link">
                <div class="card h-100 shadow-sm border-0 report-card">
                    <div class="card-body p-4">
                        <div class="icon-box mb-3 text-danger"><i class="bi bi-exclamation-triangle"></i></div>
                        <h5 class="card-title fw-bold">รายงานปัญหาเครื่องจักร</h5>
                        <p class="card-text text-muted small">รวบรวมปัญหาที่เกิดขึ้นเพื่อวางแผนป้องกัน</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-4">
            <a href="#" class="card-link">
                <div class="card h-100 shadow-sm border-0 report-card highlight">
                    <div class="card-body p-4">
                        <div class="icon-box mb-3 text-info"><i class="bi bi-megaphone"></i></div>
                        <h5 class="card-title fw-bold">รายงาน HOTLINE</h5>
                        <p class="card-text text-muted small">สรุปภาพรวมตามหน่วยงานเพื่อส่งผู้บริหาร</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-4">
            <a href="#" class="card-link">
                <div class="card h-100 shadow-sm border-0 report-card">
                    <div class="card-body p-4">
                        <div class="icon-box mb-3 text-secondary"><i class="bi bi-clock-history"></i></div>
                        <h5 class="card-title fw-bold">ประวัติการซ่อม</h5>
                        <p class="card-text text-muted small">ดูข้อมูลย้อนหลังการซ่อมบำรุงเครื่องจักรรายตัว</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-6 col-lg-4">
            <a href="#" class="card-link">
                <div class="card h-100 shadow-sm border-0 report-card monthly">
                    <div class="card-body p-4">
                        <div class="icon-box mb-3 text-primary"><i class="bi bi-calendar3"></i></div>
                        <h5 class="card-title fw-bold">รายงานรายเดือน</h5>
                        <p class="card-text text-muted small">สรุปสถิติจำนวน Job และ KPI รายเดือน</p>
                    </div>
                </div>
            </a>
        </div>
    </div>
</div>


<link rel="stylesheet" href="~/css/index_dashboard.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">