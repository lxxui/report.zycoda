@model List<report_zycoda.Models.MaintenanceApiModels>

@{
    ViewData["Title"] = "Today's Jobs";

    var sectionList = ViewBag.SectionList as List<SectionApiModels> ?? new List<SectionApiModels>();
    var statusList = ViewBag.StatusList as List<StatusApiModels> ?? new List<StatusApiModels>();
    var reports = Model ?? new List<report_zycoda.Models.MaintenanceApiModels>();
}

<style>
    :root {
        --navy: #1a237e;
        --light-gray: #f8f9fa;
    }

    .text-navy {
        color: var(--navy);
    }

    .bg-navy {
        background-color: var(--navy);
    }

    .card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }

    .table thead th {
        background-color: var(--light-gray);
        color: var(--navy);
        font-size: 0.85rem;
        border: none;
    }

    .job-id {
        color: var(--navy);
        font-weight: 700;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .badge-status {
        font-weight: 500;
        padding: 0.5em 1em;
        border-radius: 6px;
    }
</style>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h4 class="text-navy fw-bold mb-1">
                <i class="fas fa-calendar-day me-2"></i>
                งานประจำวัน
            </h4>

            <span class="badge bg-navy bg-opacity-10 text-navy px-3">
                ข้อมูล ณ วันที่ @DateTime.Now.ToString("dd/MM/yyyy")
            </span>
        </div>

        <div class="d-flex gap-2">
            <button type="button"
                    class="btn btn-success shadow-sm"
                    onclick="shareToLine()">

                <i class="fab fa-line me-1"></i>
                แชร์สรุปงาน
            </button>

            <a href="@Url.Action("Index")"
               class="btn btn-outline-secondary shadow-sm">

                <i class="fas fa-arrow-left me-1"></i>
                กลับหน้าหลัก
            </a>
        </div>
    </div>

    <div class="card overflow-hidden">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0" id="jobTable">

                <thead>
                    <tr>
                        <th class="ps-4">Job Info</th>
                        <th>Type</th>
                        <th style="width:30%">สถานที่</th>
                        <th>ผู้แจ้ง</th>
                        <th>สถานะ</th>
                        <th class="text-end pe-4">เวลาแจ้ง</th>
                        <th>ผู้ที่ถูกมอบหมายงาน</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="job-row"
                                data-detail="@item.detail"
                                data-location="@item.fldetail"
                                data-status="@item.status"
                                data-userassign="@item.uassign"
                                data-time="@(string.IsNullOrEmpty(item.timecreate) ? "-": DateTime.Parse(item.timecreate).ToString("HH:mm"))">
                                <td class="ps-4">
                                    <div class="job-id">@item.id</div>
                                    <div class="text-muted small">@item.fl</div>
                                </td>
                                <td>
                                    <span class="badge @(item.jobtype == "EM" ? "bg-danger" : "bg-info")">
                                        @item.jobtype
                                    </span>
                                </td>

                                <td>
                                    <div class="fw-bold text-primary small">
                                        @item.fl (@item.fldetail)
                                    </div>

                                    <div class="text-muted small text-truncate"
                                         style="max-width:300px;">

                                        @item.detail
                                    </div>

                                    <div class="text-muted small">
                                        @item.sectioncreate
                                    </div>
                                </td>

                                <td class="small">
                                    <i class="fas fa-user-edit text-muted me-1"></i>
                                    @item.usercreate
                                </td>

                                <td>
                                    <span class="badge badge-status
                                        @(item.status == "Create"
                                              ? "bg-warning text-dark"
                                              : item.status == "Finish"
                                                  ? "bg-success"
                                                  : "bg-primary")">
                                        @item.status
                                    </span>
                                </td>

                                <td class="text-end pe-4 small text-muted">

                                    @if (!string.IsNullOrEmpty(item.timecreate))
                                    { @DateTime.Parse(item.timecreate).ToString("HH:mm น.")}

                                </td>
                                <td class="small">
                                    <i class="fas fa-user-edit text-muted me-1"></i>
                                    @item.uassign
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">

                                <div class="text-muted">
                                    <i class="fas fa-inbox fa-3x mb-3 opacity-20"></i>
                                    <br />

                                    ไม่พบข้อมูลงานประจำวันที่ @ViewBag.CurrentStart
                                </div>

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        async function shareToLine() {

            const rows = document.querySelectorAll('#jobTable .job-row');

            if (rows.length === 0) {
                alert("ไม่มีข้อมูลงานสำหรับแชร์");
                return;
            }

            const date = "@DateTime.Now.ToString("dd/MM/yyyy")";

            let message = `🔧 สรุปงานซ่อมบำรุง วันที่ ${date}\n`;
            message += `📋 ทั้งหมด ${rows.length} งาน\n`;
            message += `${"─".repeat(32)}\n\n`;

            rows.forEach((row, i) => {

                const jobId = row.querySelector('.job-id')?.innerText || '-';

                const detail =
                    (row.dataset.detail || '-').substring(0, 120);

                const location =
                    (row.dataset.location || '-').substring(0, 80);

                const status =
                    row.dataset.status || '-';

                const userAssign =
                    row.dataset.userassign || '-';

                const time =
                    row.dataset.time || '-';

                const statusIcon =
                    status === 'Create' ? '🟡'
                    : status === 'Accept' ? '🔵'
                    : status === 'Finish' ? '✅'
                    : '⚪';

                message += `${i + 1}. 📌 ${jobId}\n`;
                message += `🏭 ${location}\n`;
                message += `🔩 ${detail}\n`;
                message += `👨‍🔧 ผู้รับผิดชอบ: ${userAssign}\n`;
                message += `${statusIcon} ${status} ⏰ ${time}\n\n`;

            });

            // Mobile Share API
            if (navigator.share) {

                try {

                    await navigator.share({
                        title: 'สรุปงานซ่อมบำรุง',
                        text: message
                    });

                    return;

                } catch (err) {

                    console.log(err);

                }
            }

            // Desktop fallback
            try {

                await navigator.clipboard.writeText(message);

                alert("คัดลอกข้อความแล้ว กรุณาวางใน LINE");

                window.open("https://line.me", "_blank");

            } catch (err) {

                console.log(err);

                alert("ไม่สามารถคัดลอกข้อความได้");

            }
        }

    </script>

}