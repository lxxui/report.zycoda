@model List<MaintenanceApiModels>

@{
    var Status = Context.Request.Query["Status"].ToString();
    var start = Context.Request.Query["start"].ToString();
    var end = Context.Request.Query["end"].ToString();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-navy mb-0"><i class="bi bi-megaphone-fill me-2"></i>รายงานติดตาม Job (สำหรับผู้แจ้งงาน)</h4>
            <p class="text-muted small mb-0">ตรวจสอบสถานะงานที่คุณแจ้งซ่อมและประวัติการทำรายการ</p>
        </div>
        <div class="btn-group shadow-sm">
            <button type="button" onclick="printReport(1)" class="btn btn-outline-navy bg-white text-navy border-0 px-3">
                <i class="bi bi-printer me-1"></i> รูปแบบ 1
            </button>
            <button type="button" onclick="printReport(2)" class="btn btn-outline-navy bg-white text-navy border-0 px-3 border-start">
                <i class="bi bi-printer me-1"></i> รูปแบบ 2
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="row g-3">
                <div class="col-12">
                    <div class="card border-0 shadow-sm p-3 border-start border-primary border-4">
                        <small class="text-muted fw-bold">งานแจ้งทั้งหมด</small>
                        <div class="h3 fw-bold text-primary mb-0">@Model.Count</div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="card border-0 shadow-sm p-3 border-start border-warning border-4">
                        <small class="text-muted fw-bold">รอดำเนินการ</small>
                        <div class="h3 fw-bold text-warning mb-0">@Model.Count(x => x.status == "Create")</div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="card border-0 shadow-sm p-3 border-start border-success border-4">
                        <small class="text-muted fw-bold">ซ่อมเสร็จแล้ว</small>
                        <div class="h3 fw-bold text-success mb-0">@Model.Count(x => x.status == "Confirm")</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 p-3" style="border-radius: 12px;">
                <h6 class="fw-bold text-navy small mb-3">สัดส่วนสถานะงาน</h6>
                <div style="height: 180px;"><canvas id="statusPieChart"></canvas></div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100 p-3" style="border-radius: 12px;">
                <h6 class="fw-bold text-navy small mb-3">สถิติการแจ้งซ่อมรายวัน (7 วันล่าสุด)</h6>
                <div style="height: 180px;"><canvas id="dailyTrendChart"></canvas></div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
        <div class="card-body bg-light-blue p-3">
            <form method="get" asp-action="ReportSender" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-bold">วันที่แจ้ง (เริ่ม)</label>
                    <input type="text" name="start" id="start_date" class="form-control border-0 shadow-sm" value="@ViewBag.Start">
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">วันที่แจ้ง (สิ้นสุด)</label>
                    <input type="text" name="end" id="end_date" class="form-control border-0 shadow-sm" value="@ViewBag.End">
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold">สถานะ</label>
                    <select name="Status" class="form-select border-0 shadow-sm">
                        <option value="">-- ทั้งหมด --</option>
                        @if (ViewBag.Status != null) {
                            foreach (var Stat in (List<report_zycoda.Models.StatusApiModels>)ViewBag.Status) {
                                <option value="@Stat.id" selected="@(Status == Stat.name)">@Stat.name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 text-end">
                    <button type="submit" class="btn btn-navy w-100 shadow-sm py-2">
                        <i class="bi bi-search me-2"></i>ค้นหาข้อมูล
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 12px; overflow: hidden;">
        <div class="table-responsive py-3">
            <table id="senderTable" class="table table-hover align-middle mb-0 w-100">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4" style="width: 100px;">เลขที่</th>
                        <th style="width: 150px;">วันที่แจ้ง</th>
                        <th style="width: 150px;">หน่วยงาน</th>
                        <th>ชื่อเครื่องจักร / รายละเอียด</th>
                        <th class="text-center" style="width: 140px;">สถานะ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="ps-4 fw-bold text-navy">#@item.id</td>
                            <td>
                                @if (DateTime.TryParse(item.timecreate, out DateTime dt)) {
                                    <div class="fw-bold small">@dt.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted" style="font-size: 0.7rem;">@dt.ToString("HH:mm") น.</div>
                                } else {
                                    <span class="small">@item.timecreate</span>
                                }
                            </td>
                            <td><span class="badge bg-white text-dark border fw-normal">@item.sectioncreate</span></td>
                            <td>
                                <div class="fw-bold text-primary" style="font-size: 0.9rem;">@item.fl (@item.fldetail)</div>
                                <div class="text-muted text-truncate small" style="max-width: 450px;">@item.detail</div>
                            </td>
                          <td class="text-center">
                                @* ใช้ StatusCssClass ที่คุณเขียน Logic ไว้ใน Model *@
                                <span class="badge rounded-pill @item.StatusCssClass px-3 py-2" style="font-size: 0.75rem; min-width: 90px;">
                                    @item.statustext
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .text-navy { color: #1e3c72; }
    .btn-navy { background-color: #1e3c72; color: white; border: none; }
    .btn-navy:hover { background-color: #2a5298; color: white; }
    .bg-light-blue { background-color: #f0f4f8; border-radius: 8px; }
    .bg-navy { background-color: #1e3c72; }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<script>
    $(document).ready(function () {
        // 1. DataTable Configuration
        $('#senderTable').DataTable({
            "pageLength": 15,
            "lengthMenu": [10, 15, 25, 50],
            "language": { "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/th.json" },
            "order": [[0, "desc"]],
            // 🚩 ใส่ Padding px-4 และ pt-2 เพื่อไม่ให้ชิดขอบการ์ด
            "dom": '<"d-flex justify-content-between align-items-center px-4 pt-2 mb-3"lf>rt<"d-flex justify-content-between align-items-center px-4 pb-3 mt-3"ip>'
        });

        // 2. Date Picker
        const flatConfig = { dateFormat: "Y-m-d", altInput: true, altFormat: "d/m/Y" };
        flatpickr("#start_date", flatConfig);
        flatpickr("#end_date", flatConfig);

        // 3. Status Pie Chart
        new Chart(document.getElementById('statusPieChart'), {
            type: 'doughnut',
            data: {
                labels: ['รอดำเนินการ', 'รับงานแล้ว', 'สำเร็จ'],
                datasets: [{
                    data: [
                        @Model.Count(x => x.status == "Create"),
                        @Model.Count(x => x.status == "Accept"),
                        @Model.Count(x => x.status == "Confirm")
                    ],
                    backgroundColor: ['#ffc107', '#0dcaf0', '#198754'],
                    borderWidth: 0,
                    cutout: '70%'
                }]
            },
            options: { maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { boxWidth: 12 } } } }
        });

        // 4. Daily Trend Chart (Logic ตัวอย่างดึง 7 วันล่าสุด)
        @{
            var trendData = Model.Where(x => DateTime.TryParse(x.timecreate, out _))
                                 .GroupBy(x => DateTime.Parse(x.timecreate).ToString("dd/MM"))
                                 .Select(g => new { Day = g.Key, Count = g.Count() })
                                 .Take(7).ToList();
            var tLabels = trendData.Select(x => x.Day).ToList();
            var tValues = trendData.Select(x => x.Count).ToList();
        }

        new Chart(document.getElementById('dailyTrendChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(tLabels)),
                datasets: [{
                    label: 'งานที่แจ้ง',
                    data: @Html.Raw(Json.Serialize(tValues)),
                    borderColor: '#1e3c72',
                    backgroundColor: 'rgba(30, 60, 114, 0.1)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: { 
                maintainAspectRatio: false, 
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });
    });

    function printReport(type) {
        const params = new URLSearchParams(window.location.search);
        window.open(`/Maintenance/ReportReceiver?type=${type}&${params.toString()}`, '_blank');
    }
</script>