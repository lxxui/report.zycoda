@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model List<report_zycoda.Models.MaintenanceApiModels>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    body {
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        background-color: #f8fafc;
        color: #1e293b;
    }
    .text-navy { color: #0f172a !important; }
    .bg-navy-gradient {
        background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    }
    
    /* Luxury Dashboard Header */
    .glass-header {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid rgba(226, 232, 240, 0.8);
    }

    /* Premium Nav Pills & Tabs */
    .custom-nav-pills {
        background: #f1f5f9;
        padding: 6px;
        border-radius: 14px;
        border: none;
    }
    .custom-nav-pills .nav-link {
        color: #64748b;
        border-radius: 10px;
        padding: 10px 20px;
        font-weight: 600;
        transition: all 0.25s ease;
    }
    .custom-nav-pills .nav-link.active {
        background: #ffffff !important;
        color: #0f172a !important;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08) !important;
    }
    .custom-nav-pills .nav-link:hover:not(.active) {
        color: #334155;
        background: rgba(255,255,255,0.5);
    }

    /* Elegant Cards */
    .premium-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.015);
    }

    /* Sleek Modern Tables */
    .modern-table {
        border-collapse: separate;
        border-spacing: 0 8px !important;
    }
    .modern-table thead th {
        background: transparent !important;
        border: none !important;
        color: #94a3b8 !important;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        padding: 12px 24px;
    }
    .modern-table tbody tr {
        background: #ffffff;
        box-shadow: 0 2px 6px rgba(15, 23, 42, 0.02);
        transition: all 0.2s ease;
    }
    .modern-table tbody tr:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.06);
        background: #ffffff !important;
    }
    .modern-table tbody td {
        padding: 18px 24px !important;
        border: none !important;
        background: transparent !important;
    }
    .modern-table tbody tr td:first-child {
        border-top-left-radius: 12px !important;
        border-bottom-left-radius: 12px !important;
    }
    .modern-table tbody tr td:last-child {
        border-top-right-radius: 12px !important;
        border-bottom-right-radius: 12px !important;
    }

    /* Minimalist Glow Buttons */
    .btn-action {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        transition: all 0.2s ease;
        background: #f8fafc;
    }
    .btn-action-edit { color: #3b82f6; }
    .btn-action-edit:hover { background: #dbeafe; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.2); }
    .btn-action-delete { color: #ef4444; }
    .btn-action-delete:hover { background: #fee2e2; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.2); }

    .btn-add-new {
        background: #0f172a;
        color: #ffffff;
        font-weight: 600;
        border: none;
        padding: 10px 24px;
        border-radius: 12px;
        transition: all 0.2s ease;
    }
    .btn-add-new:hover {
        background: #1e293b;
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(15, 23, 42, 0.15);
        color: #ffffff;
    }

    /* Advanced DataTables UI Overrides */
    .dataTables_wrapper .dataTables_filter input {
        border: 1px solid #e2e8f0 !important;
        padding: 8px 16px !important;
        border-radius: 10px !important;
        background: #ffffff !important;
        font-size: 0.9rem;
        outline: none;
    }
    .dataTables_wrapper .dataTables_filter input:focus {
        border-color: #94a3b8 !important;
        box-shadow: 0 0 0 3px rgba(148, 163, 184, 0.1);
    }
    .paginate_button.page-item.active .page-link {
        background-color: #0f172a !important;
        border-color: #0f172a !important;
    }
    .page-link { color: #475569; border-radius: 8px !important; margin: 0 2px; border: none !important; background: #f1f5f9; }
</style>

@{
    ViewData["Title"] = "Admin Management";
}

<div class="container-fluid py-4 px-md-5">
    
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between p-4 mb-4 glass-header shadow-sm">
        <div class="d-flex align-items-center mb-3 mb-md-0">
            <div class="bg-navy-gradient text-white rounded-3 p-3 me-3 d-flex align-items-center justify-content-center shadow" style="width: 56px; height: 56px; border-radius: 14px !important;">
                <i class="bi bi-grid-1x2-fill fs-4"></i>
            </div>
            <div>
                <h4 class="fw-bold text-navy mb-1">Admin Management Center</h4>
                <p class="text-muted small mb-0">ศูนย์สั่งการควบคุมข้อมูลเครื่องจักร สิทธิ์บุคลากร และดาต้าซิงค์โครงข่ายล่าสุด</p>
            </div>
        </div>
        <div>
            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill fw-semibold">
                <span class="spinner-grow spinner-grow-sm text-success me-2" role="status"></span>System Operational
            </span>
        </div>
    </div>

    <ul class="nav nav-pills mb-4 custom-nav-pills shadow-sm" id="adminTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active d-flex align-items-center" id="machine-tab" data-bs-toggle="tab" data-bs-target="#machine-pane" type="button" role="tab">
                <i class="bi bi-cpu fs-5 me-2"></i> เครื่องจักรคลังระบบ
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link d-flex align-items-center" id="section-tab" data-bs-toggle="tab" data-bs-target="#section-pane" type="button" role="tab">
                <i class="bi bi-diagram-3 fs-5 me-2"></i> สังกัด / แผนกงาน
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link d-flex align-items-center" id="user-tab" data-bs-toggle="tab" data-bs-target="#user-pane" type="button" role="tab">
                <i class="bi bi-shield-lock fs-5 me-2"></i> คุมสิทธิ์ผู้ใช้งาน
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link d-flex align-items-center" id="sync-tab" data-bs-toggle="tab" data-bs-target="#sync-pane" type="button" role="tab">
                <i class="bi bi-cloud-check fs-5 me-2"></i> บันทึกสถิติซิงค์ล่าสุด
            </button>
        </li>
    </ul>

    <div class="tab-content" id="adminTabContent">
        
        <div class="tab-pane fade show active" id="machine-pane" role="tabpanel">
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-white rounded-4 border-0 shadow-sm d-flex align-items-center">
                        <div class="p-2.5 bg-primary-subtle text-primary rounded-3 me-3"><i class="bi bi-box-seam fs-4"></i></div>
                        <div><small class="text-muted d-block">เครื่องจักรทั้งหมด</small><span class="fw-bold fs-5">124 เครื่อง</span></div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="p-3 bg-white rounded-4 border-0 shadow-sm d-flex align-items-center">
                        <div class="p-2.5 bg-success-subtle text-success rounded-3 me-3"><i class="bi bi-activity fs-4"></i></div>
                        <div><small class="text-muted d-block">Active Status</small><span class="fw-bold fs-5">120 เครื่อง</span></div>
                    </div>
                </div>
            </div>

            <div class="card premium-card">
                <div class="card-body p-4">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-3">
                        <h5 class="fw-bold mb-0 text-navy">ทะเบียนทรัพยากรเครื่องจักร</h5>
                        <button class="btn btn-add-new shadow-sm" onclick="openAddMachineModal()">
                            <i class="bi bi-plus-lg me-2"></i>เพิ่มเครื่องจักรใหม่
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table modern-table align-middle" id="machineTable">
                            <thead>
                                <tr>
                                    <th width="25%">รหัสเครื่องจักร (Machine ID)</th>
                                    <th width="45%">ชื่อเครื่องจักรประจำการ</th>
                                    <th width="15%">สถานะเซิร์ฟเวอร์</th>
                                    <th width="15%" class="text-center">การจัดการ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-bold text-navy">MC-001</td>
                                    <td class="fw-medium text-secondary">CNC Lathe Intelligent V2</td>
                                    <td><span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5 rounded-pill fw-semibold">Operational</span></td>
                                    <td class="text-center">
                                        <button class="btn-action btn-action-edit me-1" onclick="openEditModal('MC-001', 'CNC Lathe Intelligent V2')" title="แก้ไขข้อมูล">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <button class="btn-action btn-action-delete" onclick="deleteMachine('MC-001')" title="ลบออกจากระบบ">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="section-pane" role="tabpanel">
            <div class="card premium-card">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0 text-navy">โครงสร้างหน่วยงาน / ฝ่ายปฏิบัติการ</h5>
                        <button class="btn btn-add-new shadow-sm">
                            <i class="bi bi-plus-lg me-2"></i>เพิ่มแผนกใหม่
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table modern-table align-middle" id="sectionTable">
                            <thead>
                                <tr>
                                    <th width="25%">Section ID</th>
                                    <th width="60%">ชื่อหน่วยงานประจำโรงงาน</th>
                                    <th width="15%" class="text-center">การจัดการ</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-bold text-navy">SEC-101</td>
                                    <td class="fw-medium text-secondary">ฝ่ายซ่อมบำรุงวิศวกรรมหลัก (Engineering Maintenance Department)</td>
                                    <td class="text-center">
                                        <button class="btn-action btn-action-edit me-1"><i class="bi bi-pencil-fill"></i></button>
                                        <button class="btn-action btn-action-delete" onclick="deleteSection('SEC-101')"><i class="bi bi-trash3-fill"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="user-pane" role="tabpanel">
            <div class="card premium-card">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0 text-navy"><i class="bi bi-people-fill me-2"></i>ทะเบียนสิทธิ์และคุมบัญชีพนักงาน</h5>
                        <div>
                            <input type="file" id="excelFileInput" accept=".xlsx, .xls" style="display: none;" onchange="uploadExcelFile()" />

                            <button class="btn btn-success rounded-3 px-4 py-2 fw-bold shadow-sm border-0 bg-success" onclick="document.getElementById('excelFileInput').click()">
                                <i class="bi bi-file-earmark-excel-fill me-2"></i> นำเข้าข้อมูลพนักงาน (Import Excel)
                            </button>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table modern-table align-middle" id="userTable">
                            <thead>
                                <tr>
                                    <th>ชื่อผู้ใช้งาน</th>
                                    <th>ชื่อ-นามสกุลพนักงาน</th>
                                    <th>ฝ่ายงานต้นสังกัด</th>
                                    <th>ระดับความปลอดภัย (Class)</th>
                                    <th class="text-center">จัดการสิทธิ์</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-bold text-navy">admin_zycoda</td>
                                    <td class="text-secondary fw-medium">สมชาย มั่นคงเจริญ</td>
                                    <td class="text-muted small">Automation Engineering</td>
                                    <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1.5 rounded-pill fw-bold">Class 9 (Root Admin)</span></td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-dark px-3 rounded-3 fw-semibold">
                                            <i class="bi bi-shield-shaded me-1"></i> ปรับระดับสิทธิ์
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-pane fade" id="sync-pane" role="tabpanel">
            <div class="card premium-card">
                <div class="card-body p-4">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 border-bottom pb-4">
                        <div>
                            <h5 class="fw-bold mb-1 text-navy">สถานะดาต้าเกตเวย์เว็บเซิร์ฟเวอร์</h5>
                            <p class="text-muted small mb-0">ข้อมูลบันทึกสถิติรวมของระบบ RawData ล่าสุดจาก API เครือข่ายหลัก</p>
                        </div>
                        <button class="btn btn-success rounded-3 px-4 py-2.5 fw-bold shadow-sm border-0 bg-success" onclick="triggerManualSync()" style="box-shadow: 0 4px 14px rgba(25, 135, 84, 0.3) !important;">
                            <i class="bi bi-arrow-clockwise me-2"></i>บังคับซิงค์ข้อมูลเดี๋ยวนี้ (Sync Global)
                        </button>
                    </div>
                    
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="p-4 border border-slate rounded-4 bg-light shadow-none">
                                <div class="text-muted small mb-1 fw-semibold text-uppercase">ปริมาณข้อมูลสต็อก (RawData)</div>
                                <div class="fw-bold text-dark fs-3">@Model?.Count <span class="fs-6 text-muted font-monospace">records</span></div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-4 border border-slate rounded-4 bg-light shadow-none">
                                <div class="text-muted small mb-1 fw-semibold text-uppercase">Auto Sync ล่าสุดเครือข่าย</div>
                                <div class="fw-bold text-success fs-5 pt-1"><i class="bi bi-check-all me-1"></i>วันนี้, 16:33 น.</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-4 border border-slate rounded-4 bg-light shadow-none">
                                <div class="text-muted small mb-1 fw-semibold text-uppercase">Node API Connection</div>
                                <div class="pt-1"><span class="badge bg-success px-3 py-2 rounded-pill fw-semibold"><i class="bi bi-hdd-network-fill me-1"></i> Connected / Stable</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="modal fade" id="editMachineModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow:hidden;">
            <div class="modal-header bg-navy-gradient text-white py-3 px-4 border-0">
                <h5 class="modal-title fw-bold d-flex align-items-center"><i class="bi bi-sliders2-vertical me-2.5"></i>แก้ไขข้อมูลเครื่องจักรเทคนิค</h5>
                <button type="button" class="btn-close btn-close-white shadow-none" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 bg-white">
                <div class="mb-3">
                    <label class="form-label small fw-bold text-uppercase text-muted">Machine ID (รหัสระบบล็อก)</label>
                    <input type="text" id="editMachineID" class="form-control bg-light border-0 fw-bold px-3 py-2.5 text-secondary rounded-3" readonly />
                </div>
                <div class="mb-2">
                    <label class="form-label small fw-bold text-uppercase text-muted">Machine Name (ชื่อเครื่องจักรใหม่)</label>
                    <input type="text" id="editMachineName" class="form-control px-3 py-2.5 border-slate rounded-3" placeholder="กรอกชื่อใหม่ประจำการ..." style="border: 1px solid #cbd5e1;" />
                </div>
            </div>
            <div class="modal-footer bg-light border-0 py-3 px-4">
                <button type="button" class="btn btn-link text-muted fw-bold text-decoration-none" data-bs-dismiss="modal">ปิดหน้าต่าง</button>
                <button type="button" class="btn btn-dark px-4 py-2 rounded-3 fw-bold shadow-sm" onclick="saveMachineChange()" style="background:#0f172a;">
                    <i class="bi bi-save2 me-2"></i>อัปเดตข้อมูล
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // โหลดโมเดิร์น DataTables
            $('#machineTable, #sectionTable, #userTable').DataTable({
                "pageLength": 10,
                "lengthChange": false,
                "ordering": false,
                "language": {
                    "search": "",
                    "searchPlaceholder": "🔍 พิมพ์คำเพื่อค้นหาข้อมูลด่วน...",
                    "paginate": {
                        "next": "<i class='bi bi-chevron-right'></i>",
                        "previous": "<i class='bi bi-chevron-left'></i>"
                    },
                    "info": "แสดงลำดับที่ _START_ ถึง _END_ จากทั้งหมด _TOTAL_ รายการในระบบ"
                }
            });
            
            // ขยับช่องเสิร์ชไปด้านขวาให้เนียนตาแบบสากล
            $('.dataTables_filter').addClass('text-end mb-2');
        });

        function openEditModal(id, name) {
            $('#editMachineID').val(id);
            $('#editMachineName').val(name);
            var myModal = new bootstrap.Modal(document.getElementById('editMachineModal'));
            myModal.show();
        }

        function saveMachineChange() {
            var id = $('#editMachineID').val();
            var newName = $('#editMachineName').val();

            if(!newName.trim()) {
                Swal.fire({ icon: 'warning', title: 'กรุณาระบุข้อมูล', text: 'ชื่อเครื่องจักรห้ามเป็นค่าว่างเปล่าครับพี่', confirmButtonColor: '#0f172a' });
                return;
            }

            Swal.fire({
                title: 'กำลังเชื่อมโยงเซิร์ฟเวอร์...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            setTimeout(() => {
                Swal.fire({
                    icon: 'success',
                    title: 'บันทึกสำเร็จ!',
                    text: 'อัปเดตข้อมูลเครื่องจักรระบบรหัส ' + id + ' เรียบร้อย',
                    confirmButtonColor: '#0f172a'
                }).then(() => {
                    $('#editMachineModal').modal('hide');
                });
            }, 1000);
        }

        function deleteMachine(id) {
            Swal.fire({
                title: 'ยืนยันการทำลายข้อมูล?',
                text: "พี่มั่นใจไหมที่จะลบเครื่องจักร " + id + " ออกจากฐานข้อมูลถาวร?",
                icon: 'error',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'ใช่, ฉันต้องการลบ',
                cancelButtonText: 'ยกเลิกข้อมูล',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({ icon: 'success', title: 'ลบข้อมูลสำเร็จ!', text: 'ระบบลบเครื่องออกจากสารบบแล้วครับ', confirmButtonColor: '#0f172a' });
                }
            });
        }

        function triggerManualSync() {
            Swal.fire({
                title: 'ดึงสัญญาณดาต้าเกตเวย์...',
                html: 'ระบบกำลังดึง Cache และแปลงไฟล์ฐานข้อมูล JSON ล่าสุด',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            setTimeout(() => {
                Swal.fire({
                    icon: 'success',
                    title: 'Sync Global Success',
                    text: 'ฐานข้อมูลระบบทั้งหมดถูกซิงโครไนซ์สมบูรณ์แล้วครับ',
                    confirmButtonColor: '#0f172a'
                });
            }, 1800);
        }
    </script>
}