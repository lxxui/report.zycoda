@model List<MaintenanceApiModels>

@{
    var section = Context.Request.Query["sectioncreate"].ToString();
    var status = Context.Request.Query["status"].ToString();
    var start = Context.Request.Query["start"].ToString() ?? DateTime.Now.ToString("yyyy-MM-dd");
    var end = Context.Request.Query["end"].ToString() ?? DateTime.Now.ToString("yyyy-MM-dd");
}
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-navy mb-0"><i class="bi bi-journal-text me-2"></i>รายงานติดตาม Job (สำหรับผู้รับแจ้ง)</h4>
            <p class="text-muted small mb-0">ตรวจสอบและวิเคราะห์สถานะงานซ่อมบำรุงที่ได้รับแจ้งตามแผนก</p>
        </div>
        <div class="btn-group shadow-sm">
            <button type="button" onclick="printReport(1)" class="btn btn-outline-navy bg-white text-navy fw-bold border-0 px-3">
                <i class="bi bi-printer me-2"></i>พิมพ์รายงาน
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md">
            <div class="card border-0 shadow-sm text-center py-3 border-top border-primary border-4 h-100">
                <div class="text-muted small fw-bold text-uppercase">งานทั้งหมด</div>
                <div class="h2 fw-bold text-primary mb-0 mt-1">@Model.Count</div>
            </div>
        </div>
        <div class="col-md">
            <div class="card border-0 shadow-sm text-center py-3 border-top border-danger border-4 h-100">
                <div class="text-muted small fw-bold text-uppercase">แจ้งงานใหม่</div>
                <div class="h2 fw-bold text-danger mb-0 mt-1">@Model.Count(x => x.status == "Create")</div>
            </div>
        </div>
        <div class="col-md">
            <div class="card border-0 shadow-sm text-center py-3 border-top border-warning border-4 h-100">
                <div class="text-muted small fw-bold text-uppercase">รับงานแล้ว</div>
                <div class="h2 fw-bold text-warning mb-0 mt-1">@Model.Count(x => x.status == "Accept")</div>
            </div>
        </div>
        <div class="col-md">
            <div class="card border-0 shadow-sm text-center py-3 border-top border-success border-4 h-100">
                <div class="text-muted small fw-bold text-uppercase">ปิดงานแล้ว</div>
                <div class="h2 fw-bold text-success mb-0 mt-1">@Model.Count(x => x.status == "Confirm")</div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 p-3" style="border-radius: 15px;">
                <h6 class="fw-bold text-navy mb-3">สรุปสถานะการดำเนินการ</h6>
                <div style="height: 200px;"><canvas id="statusChart"></canvas></div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card border-0 shadow-sm h-100 p-3" style="border-radius: 15px;">
                <h6 class="fw-bold text-navy mb-3">จำนวนงานแยกตามหน่วยงานที่แจ้ง (Top 10)</h6>
                <div style="height: 200px;"><canvas id="sectionChart"></canvas></div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4" style="border-radius: 15px;">
        <div class="card-body bg-light p-4" style="border-radius: 15px;">
            <form method="get" asp-action="ReportReceiver">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-navy">หน่วยงานผู้แจ้ง</label>
                        <select name="sectioncreate" class="form-select border-0 shadow-sm">
                            <option value="">-- ทุกหน่วยงาน --</option>
                            @if (ViewBag.Section != null) {
                                foreach (var sec in (List<report_zycoda.Models.SectionApiModels>)ViewBag.Section) {
                                    <option value="@sec.section" selected="@(section == sec.section)">
                                        @(sec.section + " - " + sec.name)
                                    </option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-navy">ช่วงวันที่แจ้ง</label>
                        <div class="input-group shadow-sm">
                            <input type="text" name="start" id="start_date" class="form-control border-0 bg-white" value="@ViewBag.Start">
                            <span class="input-group-text bg-white border-0 text-muted">-</span>
                            <input type="text" name="end" id="end_date" class="form-control border-0 bg-white" value="@ViewBag.End">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold text-navy">สถานะใบแจ้งงาน</label>
                        <select name="status" class="form-select border-0 shadow-sm">
                            <option value="">-- ทั้งหมด --</option>
                            @if (ViewBag.status != null) {
                                foreach (var stat in (List<report_zycoda.Models.StatusApiModels>)ViewBag.Status) {
                                    <option value="@stat.id" selected="@(status == stat.name)">@stat.name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-navy w-100 py-2 shadow-sm fw-bold">
                            <i class="bi bi-search me-2"></i>ค้นหา
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
        <div class="table-responsive py-3">
            <table id="receiverTable" class="table table-hover align-middle mb-0 w-100">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Job ID</th>
                        <th>วันที่แจ้ง</th>
                        <th>หน่วยงานผู้แจ้ง</th>
                        <th>เครื่องจักร / อาการเสีย</th>
                        <th class="text-center">สถานะ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="ps-4 fw-bold text-navy">@item.id</td>
                            <td>
                                @if (DateTime.TryParse(item.timecreate, out DateTime dt)) {
                                    <div class="fw-bold" style="font-size: 0.85rem;">@dt.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted small">@dt.ToString("HH:mm:ss") น.</div>
                                } else {
                                    <div class="small">@item.timecreate</div>
                                }
                            </td>
                            <td><span class="badge bg-primary-soft text-primary px-2 py-1">@item.sectioncreate</span></td>
                            <td>
                                <div class="fw-bold">@item.fl <small class="text-muted fw-normal">(@item.fldetail)</small></div>
                                <div class="text-truncate text-muted small" style="max-width: 500px;" title="@item.detail">@item.detail</div>
                            </td>
                            <td class="text-center">
                                <span class="badge rounded-pill @item.StatusCssClass px-3 py-2" style="font-size: 0.75rem;">
                                    @item.status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .text-navy { color: #002d5b; }
    .btn-navy { background-color: #002d5b; color: white; }
    .btn-navy:hover { background-color: #001a35; color: white; }
    .bg-primary-soft { background-color: #eef4ff; }
</style>

<script>
    $(document).ready(function () {
        // 1. Initialize DataTable
        $('#receiverTable').DataTable({
            "pageLength": 15,
            "lengthMenu": [10, 15, 25, 50],
            "language": { "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/th.json" },
            "order": [[0, "desc"]],
            // 🚩 แก้ไขระยะห่าง: เพิ่ม px-4 และ pt-2 เพื่อไม่ให้ชิดขอบการ์ด
            "dom": '<"d-flex justify-content-between align-items-center px-4 pt-2 mb-3"lf>rt<"d-flex justify-content-between align-items-center px-4 pb-3 mt-3"ip>'
        });

        // 2. Setup Flatpickr
        const config = { dateFormat: "Y-m-d", altInput: true, altFormat: "d/m/Y" };
        flatpickr("#start_date", config);
        flatpickr("#end_date", config);

        // 3. Status Chart (Pie)
        new Chart(document.getElementById('statusChart'), {
            type: 'pie',
            data: {
                labels: ['แจ้งงานใหม่', 'รับงานแล้ว', 'ปิดงาน'],
                datasets: [{
                    data: [
                        @Model.Count(x => x.status == "Create"),
                        @Model.Count(x => x.status == "Accept"),
                        @Model.Count(x => x.status == "Confirm")
                    ],
                    backgroundColor: ['#dc3545', '#ffc107', '#198754']
                }]
            },
            options: { maintainAspectRatio: false, plugins: { legend: { position: 'right' } } }
        });

        // 4. Section Chart (Bar)
        @{
            var sectionData = Model.GroupBy(x => x.sectioncreate)
                                   .Select(g => new { Name = g.Key, Count = g.Count() })
                                   .OrderByDescending(x => x.Count).Take(10).ToList();
            var labels = sectionData.Select(x => x.Name).ToList();
            var values = sectionData.Select(x => x.Count).ToList();
        }
        
        new Chart(document.getElementById('sectionChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(labels)),
                datasets: [{
                    label: 'จำนวนงานที่แจ้ง',
                    data: @Html.Raw(Json.Serialize(values)),
                    backgroundColor: '#002d5b',
                    borderRadius: 5
                }]
            },
            options: { maintainAspectRatio: false, plugins: { legend: { display: false } } }
        });
    });

    function printReport(type) {
        const params = new URLSearchParams(window.location.search);
        window.open(`/Maintenance/ReportReceiver?type=${type}&${params.toString()}`, '_blank');
    }
</script>