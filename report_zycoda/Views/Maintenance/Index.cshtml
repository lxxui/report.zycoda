        #loader-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw; /* เต็มความกว้างหน้าจอ */
        height: 100vh; /* เต็มความสูงหน้าจอ */
        background: rgba(15, 23, 42, 0.8); /* สีน้ำเงินเข้มโปร่งแสง */
        backdrop-filter: blur(12px); /* เอฟเฟกต์กระจกฝ้า */
        -webkit-backdrop-filter: blur(12px);
        z-index: 10000;
        /* หัวใจหลักของการจัดกึ่งกลาง */
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        color: white;
        font-family: 'Sarabun', sans-serif;
        }

        .loader-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        }

        /* เอฟเฟกต์เรืองแสงรอบไอคอน */
        .icon-wrapper {
        position: relative;
        font-size: 4.5rem;
        color: #22d3ee;
        margin-bottom: 1.5rem;
        filter: drop-shadow(0 0 15px rgba(34, 211, 238, 0.4));
