    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>

    @section Scripts {
        <script>
            $(document).ready(function () {

                // ==================================================
                // ส่วนที่ 1: เตรียมข้อมูลและชุดสี (Centralized Config)
                // ==================================================
                const sectionCounts = {};
                const machineCounts = {};

                const zycodaPalette = [
                    'rgba(0, 31, 63, 0.85)',
                    'rgba(56, 189, 248, 0.85)',
                    'rgba(16, 185, 129, 0.85)',
                    'rgba(139, 92, 246, 0.85)',
                    'rgba(244, 114, 182, 0.85)',
                    'rgba(245, 158, 11, 0.85)',
                    'rgba(71, 85, 105, 0.85)'
                ];

                $('.job-row').each(function () {
                    const sectionId = $(this).data('sectioncreate') || 'ไม่ระบุ';
                    const sectionName = (typeof getSectionName === "function") ? getSectionName(sectionId) : sectionId;
                    sectionCounts[sectionName] = (sectionCounts[sectionName] || 0) + 1;

                    const machineName = $(this).data('machine');
                    if (machineName && machineName !== '-' && machineName !== 'null') {
                        machineCounts[machineName] = (machineCounts[machineName] || 0) + 1;
                    }
                });

                // ==================================================
                // ส่วนที่ 2: Doughnut Chart (Section Analysis)
                // ==================================================
                const sectionLabels = Object.keys(sectionCounts);
                const sectionData = Object.values(sectionCounts);
                const sectionColors = sectionLabels.map((_, i) => zycodaPalette[i % zycodaPalette.length]);

                const pieCtx = document.getElementById('maintenancePieChart').getContext('2d');
                new Chart(pieCtx, {
                    type: 'doughnut',
                    data: {
                        labels: sectionLabels,
                        datasets: [{
                            data: sectionData,
                            backgroundColor: sectionColors,
                            hoverOffset: 15,
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        maintainAspectRatio: false,
                        cutout: '72%',
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { usePointStyle: true, padding: 15, font: { family: 'Segoe UI', size: 12 } }
                            },
                            tooltip: {
                                backgroundColor: '#0f172a',
                                callbacks: { label: (ctx) => ` ${ctx.label}: ${ctx.raw} งาน` }
                            }
                        }
                    }
                });

                // ==================================================
                // ส่วนที่ 3: Bar Chart (Top 10 Machines)
                // ==================================================
                const sortedMachines = Object.entries(machineCounts)
                    .sort((a, b) => b[1] - a[1])
                    .slice(0, 10);

                const barLabels = sortedMachines.map(item => item[0]);
                const barValues = sortedMachines.map(item => item[1]);
                const barBgColors = barValues.map((_, i) => zycodaPalette[i % zycodaPalette.length]);
                const barBorderColors = barBgColors.map(c => c.replace('0.85', '1'));

                const barCtx = document.getElementById('maintenanceBarChart').getContext('2d');
                new Chart(barCtx, {
                    type: 'bar',
                    data: {
                        labels: barLabels,
                        datasets: [{
                            label: 'จำนวนครั้งที่ซ่อม',
                            data: barValues,
                            backgroundColor: barBgColors,
                            borderColor: barBorderColors,
                            borderWidth: 1.5,
                            borderRadius: 6,
                            barThickness: 22,
                            hoverBackgroundColor: '#001f3f'
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: { backgroundColor: '#0f172a' }
                        },
                        scales: {
                            x: {
                                beginAtZero: true,
                                grid: { color: 'rgba(148, 163, 184, 0.1)', drawBorder: false },
                                ticks: { stepSize: 1, color: '#94a3b8' }
                            },
                            y: {
                                grid: { display: false },
                                ticks: { color: '#475569', font: { family: 'Segoe UI', weight: '600', size: 12 } }
                            }
                        },
                        animation: {
                            duration: 1200,
                            easing: 'easeOutQuart'
                        }
                    }
                });
            });
        </script>

        <script>
            // ==================================================
            // 1. GLOBAL VARIABLES
            // ==================================================
            let lastKnownJob = null;
            let lastJobId = 0;
            const sectionLookup = {};

            @if (ViewBag.SectionList != null)
            {
                foreach (var item in (List<report_zycoda.Models.SectionApiModels>)ViewBag.SectionList)
                {
                    <text>
                        sectionLookup["@item.Sections?.Trim()"] = "@Html.Raw(item.Name?.Replace("\"", "\\\""))";
                    </text>
                }
            }

            // ==================================================
            // 2. HELPERS
            // ==================================================
            function getSectionName(code) {
                if (!code || code === '-') return '-';
                return sectionLookup[String(code).trim()] || code;
            }

            function formatDT(dateStr) {
                if (!dateStr || dateStr === '-' || dateStr === '0001-01-01T00:00:00') return '-';
                try {
                    const d = new Date(dateStr);
                    if (isNaN(d.getTime())) return dateStr;
                    return new Intl.DateTimeFormat('en-GB', {
                        day: '2-digit', month: '2-digit', year: 'numeric',
                        hour: '2-digit', minute: '2-digit', hour12: false
                    }).format(d).replace(/\//g, '-');
                } catch {
                    return dateStr;
                }
            }

            function updateClock() {
                const el = document.getElementById('realtime-clock');
                if (!el) return;
                el.innerText = new Date().toLocaleString('th-TH', {
                    day: '2-digit', month: '2-digit', year: '2-digit',
                    hour: '2-digit', minute: '2-digit', second: '2-digit',
                    hour12: false
                });
            }

            // ==================================================
            // 3. STATE
            // ==================================================
            function updateLastJobId() {
                $('.job-row').each(function () {
                    const id = parseInt($(this).data('id'));
                    if (id > lastJobId) lastJobId = id;
                });
            }

            // ==================================================
            // 4. FLATPICKR CONFIG
            // ==================================================
            const commonConfig = {
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "d/m/Y",
                locale: "en",
                allowInput: true,
                disableMobile: true,
                onReady: function (_, __, instance) {
                    const defaultVal = instance.element.dataset.default;
                    if (defaultVal) instance.setDate(flatpickr.parseDate(defaultVal, "Y-m-d"), false);
                },
                onChange: function (_, dateStr, instance) {
                    instance.element.dataset.default = dateStr;
                }
            };

            let fpStart = null;
            let fpEnd = null;

            function initDatePickers() {
                if (fpStart) fpStart.destroy();
                if (fpEnd) fpEnd.destroy();

                fpStart = flatpickr("#startDatePicker", commonConfig);
                fpEnd = flatpickr("#endDatePicker", commonConfig);

                const startVal = document.getElementById("startDatePicker").dataset.default;
                const endVal = document.getElementById("endDatePicker").dataset.default;
                if (startVal) fpStart.setDate(startVal, true, "Y-m-d");
                if (endVal) fpEnd.setDate(endVal, true, "Y-m-d");
            }

            // ==================================================
            // 5. DASHBOARD REFRESH
            // ==================================================
            function refreshDashboard() {
                $.get(window.location.href, function (data) {
                    const newHtml = $(data);
                    $('.row.g-3.mb-4.text-center').html(newHtml.find('.row.g-3.mb-4.text-center').html());
                    $('#maintenanceTable tbody').html(newHtml.find('#maintenanceTable tbody').html());
                    updateLastJobId();
                    console.log("Dashboard refreshed");
                });
            }

            // ==================================================
            // 6. CHECK UPDATE
            // ==================================================
            function checkUpdates() {
                $.get('/Maintenance/GetStatusUpdate', function (data) {
                    if (!data || data.length === 0) return;
                    const newest = data[0];
                    if (lastKnownJob === null) {
                        lastKnownJob = newest.jobNo;
                        return;
                    }
                    if (newest.jobNo !== lastKnownJob) {
                        Swal.fire({
                            title: 'มีใบงานใหม่! 🆕',
                            text: `ใบงานเลขที่: ${newest.jobNo} (${newest.status})`,
                            icon: 'info',
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 5000
                        });
                        lastKnownJob = newest.jobNo;
                        refreshDashboard();
                    }
                });
            }

            // ==================================================
            // 7. PRINT REPORT
            // ==================================================
            function PrintReport(reportType) {
                const start = fpStart?.selectedDates?.length ? fpStart.formatDate(fpStart.selectedDates[0], "Y-m-d") : "";
                const end = fpEnd?.selectedDates?.length ? fpEnd.formatDate(fpEnd.selectedDates[0], "Y-m-d") : "";

                const params = new URLSearchParams({
                    start,
                    end,
                    status: document.getElementById("filterStatus")?.value || "",
                    sectionFrom: document.getElementById("sectionFrom")?.value || "",
                    sectionTo: document.getElementById("sectionTo")?.value || "",
                    jobtype: document.getElementById("jobtype")?.value || "",
                    view: document.querySelector('input[name="view"]:checked')?.value || "followup",
                    rptType: reportType
                });

                window.open(`/Report/PrintReport?${params.toString()}`, '_blank');
                $('#printSelectModal').modal('hide');
            }

            // ==================================================
            // 8. INIT
            // ==================================================
            $(document).ready(function () {
                initDatePickers();

                if (!$.fn.DataTable.isDataTable('#maintenanceTable')) {
                    $('#maintenanceTable').DataTable({
                        pageLength: 10,
                        lengthMenu: [[10, 15, 25, 50, 100], [10, 15, 25, 50, 100]],
                        language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/th.json" },
                        order: [[0, "desc"]],
                        dom: '<"d-flex justify-content-between align-items-center px-3 pt-2 mb-2"l f>rt<"d-flex justify-content-between align-items-center px-3 pb-3 mt-2"i p>'
                    });
                }

                $(document).on('click', '.job-row', function () {
                    const $el = $(this);
                    $('#mId').text($el.data('id'));
                    $('#mMachine').text($el.data('machine') || '-');
                    $('#mType').text($el.data('type') || '-');
                    $('#mUser').text($el.data('user') || '-');
                    $('#mDetail').text($el.data('detail') || '-');
                    $('#mStatus')
                        .text($el.data('status'))
                        .removeClass()
                        .addClass('badge rounded-pill ' + ($el.data('css') || 'bg-secondary'));
                    $('#mSectionCreateName').text(getSectionName($el.data('sectioncreate')));
                    $('#mSection').text(getSectionName($el.data('section')));
                    $('#mAssign').text($el.data('uassign') || 'ยังไม่มอบหมาย');
                    $('#mAccept').text($el.data('useraccept') || 'ยังไม่มีผู้รับงาน');
                    $('#mFinish').text($el.data('userfinish') || '-');
                    $('#mTimeCreate').text(formatDT($el.data('timecreate')));
                    $('#mTimeAccept').text(formatDT($el.data('timeaccept')));
                    $('#mTimeAssign').text(formatDT($el.data('timeassign')));
                    $('#mApprove').text($el.data('userapprove') || '-');
                    $('#mTimeApprove').text(formatDT($el.data('timeapprove')));
                    $('#jobDetailModal').modal('show');
                });

                $('form').on('submit', function () {
                    $('#loader-wrapper').fadeIn(200);
                    $('button[type="submit"]').prop('disabled', true);
                });

                setInterval(updateClock, 1000);
                setInterval(checkUpdates, 30000);
                setInterval(refreshDashboard, 60000);

                updateClock();
                updateLastJobId();
            });
        </script>

        <script>
            $(window).on('load', function () {
                $('#loader-wrapper').fadeOut(500, function () {
                    $(this).css('display', 'none');
                });
            });

            setTimeout(function () {
                if ($('#loader-wrapper').is(':visible')) {
                    $('#loader-wrapper').fadeOut(300);
                }
            }, 5000);

            function shareToLine(item) {
                // ดึงข้อมูลจาก JSON/Object ที่คุณส่งมา
                const jobId = item.id;
                const location = item.fl; // ที่อยู่เครื่องจักร/จุดเกิดเหตุ
                const flDetail = item.fldetail; // รายการอุปกรณ์
                const detail = item.detail; // รายละเอียดแจ้งซ่อม
                const jobType = item.jobtype; // CM หรือ PM
                const priority = item.priority; // ระดับความสำคัญ
                const assignTo = item.uassign ? item.uassign.join(', ') : '-'; // ช่างที่ได้รับมอบหมาย
                const status = item.status;

                // จัดรูปแบบข้อความให้ช่างอ่านง่าย (มี Emoji ช่วยแบ่งส่วน)
                const message = 
            `🛠 *ใบแจ้งซ่อมใหม่ (Job #${jobId})*
            ----------------------------
            📌 *สถานที่:* ${location}
            📦 *อุปกรณ์:* ${flDetail}
            📝 *อาการ:* ${detail}
            ----------------------------
            🔧 *ประเภทงาน:* ${jobType}
            ⚠️ *ความสำคัญ:* ${priority}
            👤 *ช่างผู้รับผิดชอบ:* ${assignTo}
            🚩 *สถานะปัจจุบัน:* ${status}

            🔗 ดูรายละเอียด/กดรับงาน: ${window.location.origin}/Maintenance/Details/${jobId}`;
    
                const lineUrl = "https://line.me/R/msg/text/?" + encodeURIComponent(message);
                window.open(lineUrl, '_blank');
            }

            function copyToClipboard(text) {
                const dummy = document.createElement("input");
                document.body.appendChild(dummy);
                dummy.value = text;
                dummy.select();
                document.execCommand("copy");
                document.body.removeChild(dummy);
            }
        </script>


    }


</body>

</html>









