                        int GetSecInt(string secCode)
                        {
                            return int.TryParse(secCode, out int result) ? result : 0;
                        }

                        // --- 1. ฝั่งบางชัน ---
                        bool IsPdBangchan(SectionApiModels sec)
                        {
                            int code = GetSecInt(sec.Sections);
                            return (code >= 321000 && code <= 321110);
                        }

                        bool IsPlanBangchan(SectionApiModels sec)
                        {
                            int code = GetSecInt(sec.Sections);
                            return (code >= 322000 && code <= 322030);
                        }

                        // --- 2. ฝั่งลาดกระบัง ---
                        bool IsWhLadkrabang(SectionApiModels sec)
                        {
                            int code = GetSecInt(sec.Sections);
                            return (code >= 310012 && code <= 310014);
                        }

                        bool IsPdLadkrabang(SectionApiModels sec)
                        {
                            int code = GetSecInt(sec.Sections);
                            return (code >= 311010 && code <= 311090) ||
                                   (code >= 312010 && code <= 312090) ||
                                   (code >= 313010 && code <= 313090) ||
                                   (code >= 314010 && code <= 314090);
                        }

                        // --- 3. วิศวกรรม / เทคนิคฝั่งลาดกระบัง (อัปเดตเพิ่มเติม) ---
                        bool IsEngBangchan(SectionApiModels sec)
                        {
                            int code = GetSecInt(sec.Sections);
                            return code == 320100 || code == 317310 || code == 317381 || (code >= 317320 && code <= 317374);
                        }

                        bool IsEngLadkrabang(SectionApiModels sec)
                        {
                            int code = GetSecInt(sec.Sections);
                            return code == 317375 || code == 317380 || code == 317390 || (code >= 317020 && code <= 317050);
                        }

                        bool IsTechServLadkrabang(SectionApiModels sec) => sec.Sections == "310099";

                        bool IsTechProdLadkrabang(SectionApiModels sec)
                        {
                            int code = GetSecInt(sec.Sections);
                            return (code >= 317110 && code <= 317150);
                        }

                        bool IsMaintLadkrabang(SectionApiModels sec)
                        {
                            int code = GetSecInt(sec.Sections);
                            return (code >= 317210 && code <= 317240);
                        }

                        // --- 4. กลุ่มย่อยอื่นๆ ---
