@section Scripts {
    <script>
        // ==================================================
        // 1. GLOBAL VARIABLES & LOOKUPS
        // ==================================================
        let lastKnownJob = null;
        let lastJobId = 0;
        let fpStart = null;
        let fpEnd = null;
        const sectionLookup = {};

        @if (ViewBag.SectionList != null)
        {
            foreach (var item in (List<report_zycoda.Models.SectionApiModels>)ViewBag.SectionList)
            {
                if (item != null && !string.IsNullOrEmpty(item.Sections))
                {
                    <text>
                        sectionLookup["@item.Sections.Trim()"] = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(item.Name ?? ""));
                    </text>
                }
            }
        }

        // Instance สำหรับ Chart ป้องกัน Error Canvas ค้าง
        let pieChartInstance = null;
        let barChartInstance = null;

        // ==================================================
        // 2. HELPER FUNCTIONS
        // ==================================================
        function getSectionName(code) {
            if (!code || code === '-') return '-';
            return sectionLookup[String(code).trim()] || code;
        }

        function formatDT(dateStr) {
            if (!dateStr || dateStr === '-' || dateStr === '0001-01-01T00:00:00') return '-';
            try {
                const d = new Date(dateStr);
                if (isNaN(d.getTime())) return dateStr;
                return new Intl.DateTimeFormat('en-GB', {
                    day: '2-digit', month: '2-digit', year: 'numeric',
                    hour: '2-digit', minute: '2-digit', hour12: false
                }).format(d).replace(/\//g, '-');
            } catch {
                return dateStr;
            }
        }

        function updateClock() {
            const el = document.getElementById('realtime-clock');
            if (!el) return;
            el.innerText = new Date().toLocaleString('th-TH', {
                day: '2-digit', month: '2-digit', year: '2-digit',
                hour: '2-digit', minute: '2-digit', second: '2-digit',
                hour12: false
            });
        }

        function updateLastJobId() {
            $('.job-row').each(function () {
                const id = parseInt($(this).attr('data-id') || $(this).data('id'));
                if (id && id > lastJobId) lastJobId = id;
            });
        }

        // ==================================================
        // 3. DYNAMIC COUNTERS & CHARTS PROCESSING
        // ==================================================
        function processDataAndRenderComponents() {
            let totalJobs = 0, pending = 0, accept = 0, assign = 0, success = 0, reject = 0;
            const sectionCounts = {};
            const machineCounts = {};
            const zycodaPalette = [
                'rgba(0, 31, 63, 0.85)', 'rgba(56, 189, 248, 0.85)', 'rgba(16, 185, 129, 0.85)',
                'rgba(139, 92, 246, 0.85)', 'rgba(244, 114, 182, 0.85)', 'rgba(245, 158, 11, 0.85)',
                'rgba(71, 85, 105, 0.85)'
            ];

            // 3.1 วนลูปนับข้อมูลจริงจากตาราง (.job-row)
            $('.job-row').each(function () {
                totalJobs++;
                const status = ($(this).attr('data-status') || $(this).data('status') || '').toUpperCase().trim();

                if (status === 'PENDING' || status === 'CREATE') pending++;
                else if (status === 'ACCEPT') accept++;
                else if (status === 'ASSIGN') assign++;
                else if (status === 'SUCCESS') success++;
                else if (status === 'REJECT' || status === 'DENY') reject++;

                const sectionId = $(this).attr('data-sectioncreate') || $(this).data('sectioncreate') || 'ไม่ระบุ';
                const sectionName = getSectionName(sectionId);
                sectionCounts[sectionName] = (sectionCounts[sectionName] || 0) + 1;

                const machineName = $(this).attr('data-machine') || $(this).data('machine');
                if (machineName && machineName !== '-' && machineName !== 'null') {
                    machineCounts[machineName] = (machineCounts[machineName] || 0) + 1;
                }
            });

            // 3.2 อัปเดตตัวเลขลงบน Cards
            $('#count-all-jobs, .card:contains("ALL JOBS") h3, .card:contains("ALL JOBS") .display-4').text(totalJobs);
            $('#count-pending, .card:contains("PENDING") h3, .card:contains("PENDING") .display-4').text(pending);
            $('#count-accept, .card:contains("ACCEPT") h3, .card:contains("ACCEPT") .display-4').text(accept);
            $('#count-assign, .card:contains("ASSIGN") h3, .card:contains("ASSIGN") .display-4').text(assign);
            $('#count-success, .card:contains("SUCCESS") h3, .card:contains("SUCCESS") .display-4').text(success);
            $('#count-reject, .card:contains("REJECT") h3, .card:contains("REJECT") .display-4').text(reject);

            // 3.3 Render Doughnut Chart (สัดส่วนงานซ่อมตามแผนก)
            try {
                const sectionLabels = Object.keys(sectionCounts);
                const sectionData = Object.values(sectionCounts);
                const chartEl = document.getElementById('maintenancePieChart');

                if (pieChartInstance) pieChartInstance.destroy();

                if (sectionLabels.length > 0 && chartEl && typeof Chart !== 'undefined') {
                    pieChartInstance = new Chart(chartEl.getContext('2d'), {
                        type: 'doughnut',
                        data: {
                            labels: sectionLabels,
                            datasets: [{
                                data: sectionData,
                                backgroundColor: sectionLabels.map((_, i) => zycodaPalette[i % zycodaPalette.length]),
                                hoverOffset: 15,
                                borderWidth: 2,
                                borderColor: '#ffffff'
                            }]
                        },
                        options: {
                            maintainAspectRatio: false,
                            cutout: '72%',
                            plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, padding: 15 } } }
                        }
                    });
                }
            } catch (e) {
                console.error("Pie Chart Error:", e);
            }

            // 3.4 Render Bar Chart (Top 10 เครื่องจักรที่แจ้งซ่อม)
            try {
                const sortedMachines = Object.entries(machineCounts).sort((a, b) => b[1] - a[1]).slice(0, 10);
                const chartEl = document.getElementById('maintenanceBarChart');

                if (barChartInstance) barChartInstance.destroy();

                if (sortedMachines.length > 0 && chartEl && typeof Chart !== 'undefined') {
                    barChartInstance = new Chart(chartEl.getContext('2d'), {
                        type: 'bar',
                        data: {
                            labels: sortedMachines.map(item => item[0]),
                            datasets: [{
                                label: 'จำนวนครั้งที่ซ่อม',
                                data: sortedMachines.map(item => item[1]),
                                backgroundColor: sortedMachines.map((_, i) => zycodaPalette[i % zycodaPalette.length]),
                                borderWidth: 1.5,
                                borderRadius: 6,
                                barThickness: 22
                            }]
                        },
                        options: {
                            indexAxis: 'y',
                            maintainAspectRatio: false,
                            plugins: { legend: { display: false } },
                            scales: { x: { beginAtZero: true, ticks: { stepSize: 1 } } }
                        }
                    });
                }
            } catch (e) {
                console.error("Bar Chart Error:", e);
            }
        }

        // ==================================================
        // 4. FLATPICKR DATEPICKER INIT (ย้อนหลังสูงสุด 2 ปี)
                // ==================================================
               // 1. ตั้งค่า Common Config สำหรับ Flatpickr
        const commonConfig = {
            dateFormat: "Y-m-d",      // ฟอร์แมตส่งค่าเข้า Backend
            altInput: true,
            altFormat: "d/m/Y",       // ฟอร์แมตแสดงผลในช่อง
            allowInput: true,
            disableMobile: true,
            // บังคับให้ Flatpickr Parse วันที่เป็น ค.ศ. (Gregorian) เสมอ ป้องกันการสับสนกับ พ.ศ.
            parseDate: (datestr, format) => {
                return flatpickr.parseDate(datestr, format);
            }
        };

        function initDatePickers() {
            if (fpStart) fpStart.destroy();
            if (fpEnd) fpEnd.destroy();

            // คำนวณ minDate ย้อนหลัง 2 ปีจากวันนี้แบบ dynamic (ไม่ hardcode)
            const today = new Date();
            const minDateObj = new Date(today.getFullYear() - 2, today.getMonth(), today.getDate());
            console.log('DEBUG minDateObj:', minDateObj); // เพิ่มบรรทัดนี้ชั่วคราว

            // แปลงเป็น string รูปแบบ Y-m-d โดยไม่พึ่ง toISOString (กัน timezone เพี้ยน)
            const pad = (n) => String(n).padStart(2, '0');
            const minDateStr = `${minDateObj.getFullYear()}-${pad(minDateObj.getMonth() + 1)}-${pad(minDateObj.getDate())}`;

            const customConfig = {
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "d/m/Y",
                allowInput: true,
                disableMobile: true,
                minDate: minDateStr,   // ย้อนหลัง 2 ปีจากวันนี้เสมอ
                maxDate: "today"       // ให้ flatpickr ใช้วันปัจจุบันเป็นขอบเขตบน ไม่ต้องแก้มือทุกปี
            };

            fpStart = flatpickr("#startDatePicker", customConfig);
            fpEnd = flatpickr("#endDatePicker", customConfig);

            const startInput = document.getElementById("startDatePicker");
            const endInput = document.getElementById("endDatePicker");

            if (startInput && startInput.dataset.default) {
                fpStart.setDate(startInput.dataset.default, false, "Y-m-d");
            }
            if (endInput && endInput.dataset.default) {
                fpEnd.setDate(endInput.dataset.default, false, "Y-m-d");
            }
        }
        // ==================================================
        // 5. BACKEND INTEGRATION & EXTERNAL ACTIONS
        // ==================================================
        function refreshDashboard() {
            $.get(window.location.href, function (data) {
                const newHtml = $(data);

                if ($.fn.DataTable.isDataTable('#maintenanceTable')) {
                    $('#maintenanceTable').DataTable().destroy();
                }

                $('#maintenanceTable tbody').html(newHtml.find('#maintenanceTable tbody').html());

                $('#maintenanceTable').DataTable({
                    pageLength: 10,
                    lengthMenu: [[10, 15, 25, 50, 100], [10, 15, 25, 50, 100]],
                    language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/th.json" },
                    order: [[0, "desc"]],
                    dom: '<"d-flex justify-content-between align-items-center px-3 pt-2 mb-2"l f>rt<"d-flex justify-content-between align-items-center px-3 pb-3 mt-2"i p>'
                });

                updateLastJobId();
                processDataAndRenderComponents();

                const syncTextEl = document.getElementById('sync-time-text');
                if (syncTextEl) syncTextEl.innerText = "อัปเดตสำเร็จ";

                $('#loader-wrapper').fadeOut(200);
            }).fail(function () {
                $('#loader-wrapper').fadeOut(200);
            });
        }

        function checkUpdates() {
            $.get('/Maintenance/GetStatusUpdate', function (data) {
                if (!data || data.length === 0) return;
                const newest = data[0];
                if (lastKnownJob === null) {
                    lastKnownJob = newest.jobNo;
                    return;
                }
                if (newest.jobNo !== lastKnownJob) {
                    Swal.fire({
                        title: 'มีใบงานใหม่! 🆕',
                        text: `ใบงานเลขที่: ${newest.jobNo} (${newest.status})`,
                        icon: 'info',
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 5000
                    });
                    lastKnownJob = newest.jobNo;
                }
            });
        }

        function PrintReport(reportType) {
            const currentParams = new URLSearchParams(window.location.search);
            const params = new URLSearchParams({
                start: currentParams.get("start") || (fpStart?.selectedDates?.length ? fpStart.formatDate(fpStart.selectedDates[0], "Y-m-d") : ""),
                end: currentParams.get("end") || (fpEnd?.selectedDates?.length ? fpEnd.formatDate(fpEnd.selectedDates[0], "Y-m-d") : ""),
                status: currentParams.get("Status") || currentParams.get("status") || document.getElementById("filterStatus")?.value || "",
                sectionFrom: currentParams.get("sectionFrom") || document.getElementById("sectionFrom")?.value || "",
                sectionTo: currentParams.get("sectionTo") || document.getElementById("sectionTo")?.value || "",
                jobtype: currentParams.get("jobtype") || document.getElementById("jobtype")?.value || "EM,CM",
                view: currentParams.get("view") || document.querySelector('input[name="view"]:checked')?.value || "followup",
                rptType: reportType
            });
            window.open(`/Report/PrintReport?${params.toString()}`, '_blank');
            $('#printSelectModal').modal('hide');
        }
        window.PrintReport = PrintReport;

        function checkLastSyncTime() {
            const syncText = document.getElementById('sync-time-text');
            const syncIcon = document.getElementById('sync-icon');
            if (syncIcon) syncIcon.classList.add('spin-animation');

            fetch('/api/sync/last-time')
                .then(response => response.json())
                .then(data => {
                    if (data.success && syncText) syncText.innerText = data.lastSync;
                })
                .catch(err => console.error("Error fetching sync time:", err))
                .finally(() => {
                    setTimeout(() => { if (syncIcon) syncIcon.classList.remove('spin-animation'); }, 1000);
                });
        }

        function shareToLine(item) {
            const jobId = item.id;
            const location = item.fl;
            const flDetail = item.fldetail;
            const detail = item.detail;
            const jobType = item.jobtype;
            const priority = item.priority;
            const assignTo = item.uassign ? item.uassign.join(', ') : '-';
            const status = item.status;
            const creator = item.usercreate ? item.usercreate : '-';
            const rawSectionCode = item.sectioncreate;
            let sectionName = getSectionName(rawSectionCode);

            const message = `🛠 *ใบแจ้งซ่อมใหม่ (Job #${jobId})*\n----------------------------\n👤 *คนแจ้งงาน:* ${creator}\n🏬 *หน่วยงานที่แจ้ง:* ${sectionName}\n📌 *สถานที่:* ${location}\n📦 *อุปกรณ์:* ${flDetail}\n📝 *อาการ:* ${detail}\n----------------------------\n🔧 *ประเภทงาน:* ${jobType}\n⚠️ *ความสำคัญ:* ${priority}\n👤 *ช่างผู้รับผิดชอบ:* ${assignTo}\n🚩 *status:* ${status}\n\n🔗 *ดูรายละเอียด/กดรับงาน:* ${window.location.origin}/Maintenance/Details/${jobId}`;
            window.open("https://line.me/R/msg/text/?" + encodeURIComponent(message), '_blank');
        }

        // ==================================================
        // 6. MAIN INITIALIZATION (DOM READY)
        // ==================================================
        $(document).ready(function () {
            initDatePickers();
            checkLastSyncTime();

            if (!$.fn.DataTable.isDataTable('#maintenanceTable')) {
                $('#maintenanceTable').DataTable({
                    pageLength: 10,
                    lengthMenu: [[10, 15, 25, 50, 100], [10, 15, 25, 50, 100]],
                    language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/th.json" },
                    order: [[0, "desc"]],
                    dom: '<"d-flex justify-content-between align-items-center px-3 pt-2 mb-2"l f>rt<"d-flex justify-content-between align-items-center px-3 pb-3 mt-2"i p>'
                });
            }

            // คำนวณยอดและวาดกราฟรอบแรก
            processDataAndRenderComponents();

            // Event Click แถวตารางเปิด Modal
            $(document).on('click', '.job-row', function () {
                const $el = $(this);
                const getId = $el.attr('data-id') || $el.data('id');

                $('#mId').text(getId);
                $('#mMachine').text($el.attr('data-machine') || $el.data('machine') || '-');
                $('#mType').text($el.attr('data-type') || $el.data('type') || '-');
                $('#mUser').text($el.attr('data-user') || $el.data('user') || '-');
                $('#mDetail').text($el.attr('data-detail') || $el.data('detail') || '-');

                $('#mStatus').text($el.attr('data-status') || $el.data('status'))
                    .removeClass()
                    .addClass('badge rounded-pill ' + ($el.attr('data-css') || $el.data('css') || 'bg-secondary'));

                $('#mSectionCreateName').text(getSectionName($el.attr('data-sectioncreate') || $el.data('sectioncreate')));
                $('#mSection').text(getSectionName($el.attr('data-section') || $el.data('section')));

                $('#mAssign').text($el.attr('data-uassign') || $el.data('uassign') || 'ยังไม่มอบหมาย');
                $('#mAccept').text($el.attr('data-useraccept') || $el.data('useraccept') || 'ยังไม่มีผู้รับงาน');
                $('#mFinish').text($el.attr('data-userfinish') || $el.data('userfinish') || '-');

                $('#mTimeCreate').text(formatDT($el.attr('data-timecreate') || $el.data('timecreate')));
                $('#mTimeAccept').text(formatDT($el.attr('data-timeaccept') || $el.data('timeaccept')));
                $('#mTimeAssign').text(formatDT($el.attr('data-timeassign') || $el.data('timeassign')));
                $('#mEffect').text($el.attr('data-effect') || $el.data('effect') || '-');

                // ข้อมูล ApproveCreate
                const approveData = $el.data('approvecreate');

                if (approveData && approveData.length > 0) {
                    const approver = approveData[0];
                    $('#mApprove').text(approver.name || '-');

                    if (approver.datetime) {
                        const parts = approver.datetime.split('T');
                        $('#mDateApprove').text(parts[0] || '-');
                        $('#mDateApprove').text(parts[0] || '-');
                        $('#mTimeApprove').text(parts[1] ? parts[1].substring(0, 5) : '-');
                    } else {
                        $('#mDateApprove').text('-');
                        $('#mTimeApprove').text('-');
                    }
                } else {
                    $('#mApprove').text($el.attr('data-userapprove') || $el.data('userapprove') || '-');

                    const oldTime = $el.attr('data-timeapprove') || $el.data('timeapprove');
                    if (oldTime) {
                        const parts = oldTime.split('T');
                        $('#mDateApprove').text(parts[0] || '-');
                        $('#mTimeApprove').text(parts[1] ? parts[1].substring(0, 5) : '-');
                    } else {
                        $('#mDateApprove').text('-');
                        $('#mTimeApprove').text('-');
                    }
                }

                $('#jobDetailModal').modal('show');
            });

            // Filter Loader Progress
            document.getElementById('filterForm')?.addEventListener('submit', function () {
                const $loader = document.getElementById('loader-wrapper');
                const $progressBar = document.getElementById('loader-progress');
                const $statusText = document.getElementById('loader-status-text');

                if ($loader) $loader.style.display = 'flex';

                const steps = [
                    "กำลังตรวจสอบเงื่อนไขการค้นหา...",
                    "กำลังดึงข้อมูลจากระบบ...",
                    "กำลังประมวลผลกราฟและตาราง...",
                    "เกือบเสร็จแล้ว..."
                ];

                let progress = 0;
                const interval = setInterval(() => {
                    progress += Math.floor(Math.random() * 15) + 5;
                    if (progress > 95) progress = 95;
                    if ($progressBar) $progressBar.style.width = progress + "%";

                    const stepIdx = Math.min(Math.floor((progress / 100) * steps.length), steps.length - 1);
                    if ($statusText) $statusText.textContent = steps[stepIdx];

                    if (progress >= 95) clearInterval(interval);
                }, 150);
            });

            $('#loader-wrapper').fadeOut(200);

            // Intervals
            setInterval(updateClock, 1000);
            setInterval(checkUpdates, 30000);
            setInterval(refreshDashboard, 60000);
            setInterval(checkLastSyncTime, 5 * 60 * 1000);

            updateClock();
            updateLastJobId();
        });

        $(window).on('load', function () {
            $('#loader-wrapper').fadeOut(300);
        });

        // กัน BFCache
        window.addEventListener('pageshow', function (event) {
            if (event.persisted) {
                const loader = document.getElementById('loader-wrapper');
                if (loader) loader.style.display = 'none';
            }
        });
    </script>
}
</body>
</html>
