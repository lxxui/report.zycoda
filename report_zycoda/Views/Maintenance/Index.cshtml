@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model List<report_zycoda.Models.MaintenanceApiModels>

@{
    var mode = Context.Request.Query["mode"].ToString() ?? "myjob";
    var jobtype = Context.Request.Query["jobtype"].ToString();
    var section = Context.Request.Query["sectioncreate"].ToString();
    var status = Context.Request.Query["status"].ToString();
    var reports = Model ?? new List<report_zycoda.Models.MaintenanceApiModels>();
    var culture = System.Globalization.CultureInfo.InvariantCulture;

    var start = Context.Request.Query["start"].ToString();
    var end = Context.Request.Query["end"].ToString();

    if (string.IsNullOrEmpty(start)) start = DateTime.Now.ToString("yyyy-MM-dd", culture);
    if (string.IsNullOrEmpty(end)) end = DateTime.Now.ToString("yyyy-MM-dd", culture);

    // Logic จัดกลุ่ม Machine (Top 10)
    var machineGroups = reports
        .Where(x => !string.IsNullOrEmpty(x.fldetail))
        .GroupBy(x => x.fldetail)
        .Select(g => new { Name = g.Key, Count = g.Count() })
        .OrderByDescending(x => x.Count)
        .Take(10).ToList();

    var machineLabels = machineGroups.Select(x => x.Name).ToList();
    var machineData = machineGroups.Select(x => x.Count).ToList();
}

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container-fluid py-4">
    <div class="nav-tabs-custom d-flex">
        <a href="@Url.Action("Index", new { mode = "myjob", jobtype = jobtype })" 
           class="nav-link-custom @(mode != "follow" ? "active" : "")">
           <i class="bi bi-person-workspace me-2"></i>งานของฉัน
        </a>
        <a href="@Url.Action("Index", new { mode = "follow", jobtype = jobtype })" 
           class="nav-link-custom @(mode == "follow" ? "active" : "")">
           <i class="bi bi-eye-fill me-2"></i>ติดตามงาน (Accepted)
        </a>
    </div>

    <div class="row g-3 mb-4 row-cols-md-5">
        <div class="col">
            <div class="card stat-card bg-light shadow-sm text-center p-3">
                <small class="text-muted fw-bold">ทั้งหมด</small>
                <h3 class="mb-0">@reports.Count</h3>
            </div>
        </div>
        <div class="col">
            <div class="card stat-card border-start border-4 border-danger shadow-sm text-center p-3">
                <small class="text-danger fw-bold">PENDING/CREATE</small>
                <h3 class="mb-0">@reports.Count(x => x.status == "Pending" || x.status == "Create")</h3>
            </div>
        </div>
        <div class="col">
            <div class="card stat-card border-start border-4 border-warning shadow-sm text-center p-3">
                <small class="text-warning fw-bold">ACCEPTED</small>
                <h3 class="mb-0">@reports.Count(x => x.status == "Accept")</h3>
            </div>
        </div>
        <div class="col">
            <div class="card stat-card border-start border-4 border-primary shadow-sm text-center p-3">
                <small class="text-primary fw-bold">ASSIGNED</small>
                <h3 class="mb-0">@reports.Count(x => x.status == "Assigned")</h3>
            </div>
        </div>
        <div class="col">
            <div class="card stat-card border-start border-4 border-success shadow-sm text-center p-3">
                <small class="text-success fw-bold">FINISHED</small>
                <h3 class="mb-0">@reports.Count(x => x.status == "Finish" || x.status == "Confirm")</h3>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm h-100 p-3" style="border-radius: 15px;">
                <h6 class="fw-bold text-muted mb-3">สัดส่วนสถานะงาน</h6>
                <div style="height: 280px;"><canvas id="maintenancePieChart"></canvas></div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card border-0 shadow-sm h-100 p-3" style="border-radius: 15px;">
                <h6 class="fw-bold text-muted mb-3">Top 10 เครื่องจักรที่แจ้งซ่อมบ่อย</h6>
                <div style="height: 280px;"><canvas id="maintenanceBarChart"></canvas></div>
            </div>
        </div>
    </div>

    <div class="filter-box shadow-sm mb-4">
        <form method="get" class="row g-3 align-items-end">
            <input type="hidden" name="mode" value="@mode" />
            <div class="col-md-2">
                <label class="form-label small fw-bold">ประเภทงาน</label>
                <select name="jobtype" class="form-select border-0 shadow-sm">
                    <option value="EM,CM" selected="@(jobtype == "EM,CM")">-- ทั้งหมด --</option>
                    <option value="EM" selected="@(jobtype == "EM")">EM (Emergency)</option>
                    <option value="CM" selected="@(jobtype == "CM")">CM (General)</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold">วันที่</label>
                <div class="input-group">
                    <input type="text" id="startDatePicker" name="start" class="form-control border-0 shadow-sm" value="@start">
                    <span class="input-group-text bg-white border-0 shadow-sm">-</span>
                    <input type="text" id="endDatePicker" name="end" class="form-control border-0 shadow-sm" value="@end">
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold">สถานะ</label>
                <select name="status" class="form-select border-0 shadow-sm">
                    <option value="">-- ทั้งหมด --</option>
                    @if (ViewBag.Status != null) {
                        foreach (var stat in (List<report_zycoda.Models.StatusApiModels>)ViewBag.Status) {
                            <option value="@stat.id" selected="@(status == stat.name)">@stat.name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-1">
                <button type="submit" id="btnSearch" class="btn btn-primary w-100 shadow-sm py-2">ค้นหา</button>
            </div>
        </form>
    </div>

    <div class="table-container shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">ID</th>
                    <th>เครื่องจักร / อุปกรณ์</th>
                    <th>รายละเอียด</th>
                    <th class="text-center">Downtime</th>
                    <th class="text-center">สถานะ</th>
                    <th>ผู้แจ้ง</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in reports) {
                    <tr>
                        <td class="ps-3 fw-bold">#@item.id</td>
                        <td><div class="text-primary fw-bold">@item.fldetail</div></td>
                        <td><div class="text-truncate" style="max-width: 250px;">@item.detail</div></td>
                        <td class="text-center">
                            <span class="badge bg-light text-dark border"><i class="bi bi-clock me-1"></i>@item.downtime m</span>
                        </td>
                        <td class="text-center">
                            <span class="badge rounded-pill @item.StatusCssClass px-3">@item.status</span>
                        </td>
                        <td><small class="text-muted">@item.usercreate</small></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    // ==========================================
    // 1. เตรียมข้อมูลพื้นฐาน (Raw Data)
    // ==========================================
    const statusLabels = ['แจ้งงานใหม่', 'รับงานแล้ว', 'ปิดงาน'];
    const statusValues = [
        @reports.Count(x => x.status?.Trim() == "Create"),
        @reports.Count(x => x.status?.Trim() == "Accept"),
        @reports.Count(x => x.status?.Trim() == "Confirm")
    ];

    const dateConfig = { dateFormat: "Y-m-d", altInput: true, altFormat: "d/m/Y" };
    flatpickr("#startDatePicker", dateConfig);
    flatpickr("#endDatePicker", dateConfig);

    // สีหลักสำหรับ Theme (Modern Flat UI)
    const modernColors = ['#F9A602', '#01C6D9', '#01A182']; // ส้ม, ฟ้า, เขียว
    const hoverColors = ['#FDCA5C', '#84EAED', '#03CB98'];

    // ==========================================
    // 2. Doughnut Chart (สรุปสถานะงาน)
    // ==========================================
    const ctxPie = document.getElementById('maintenancePieChart');
    if (ctxPie) {
        new Chart(ctxPie, {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusValues,
                    backgroundColor: modernColors,
                    hoverBackgroundColor: hoverColors,
                    borderColor: '#ffffff',
                    borderWidth: 2,
                    hoverOffset: 15,
                    borderRadius: 5
                }]
            },
            options: {
                maintainAspectRatio: false,
                cutout: '70%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { padding: 20, font: { size: 14, family: 'Tahoma' } }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let total = context.chart.getDatasetMeta(0).total;
                                let percentage = Math.round((context.raw / total) * 100);
                                return ` ${context.label}: ${context.raw} งาน (${percentage}%)`;
                            }
                        }
                    }
                }
            }
        });
    }

    // ==========================================
    // 3. Bar Chart (แยกตามเครื่องจักร - พร้อมระบบเรียงลำดับ)
    // ==========================================
    const ctxBar = document.getElementById('maintenanceBarChart');
    if (ctxBar) {
        const barCanvas = ctxBar.getContext('2d');
        
        // ดึงข้อมูลจาก Razor
        let rawMachineLabels = @Html.Raw(Json.Serialize(machineLabels));
        let rawMachineData = @Html.Raw(Json.Serialize(machineData));

        // --- Logic การเรียงลำดับ (Sort Data) ---
        // รวม Label และ Data เข้าด้วยกันเพื่อทำการ Sort ตามจำนวนงาน (มากไปน้อย)
        let sortedMachineList = rawMachineLabels.map((label, index) => {
            return { label: label, value: rawMachineData[index] };
        }).sort((a, b) => b.value - a.value); // b - a คือเรียงจากมากไปน้อย

        const finalLabels = sortedMachineList.map(item => item.label);
        const finalData = sortedMachineList.map(item => item.value);

        // สร้าง Gradient แนวขวาง (เพราะเราจะใช้ indexAxis: 'y')
        let gradientBar = barCanvas.createLinearGradient(0, 0, 500, 0);
        gradientBar.addColorStop(0, '#01C6D9');
        gradientBar.addColorStop(1, 'rgba(1, 198, 217, 0.1)');

        new Chart(barCanvas, {
            type: 'bar',
            data: {
                labels: finalLabels,
                datasets: [{
                    label: 'จำนวนงาน',
                    data: finalData,
                    backgroundColor: gradientBar,
                    borderColor: '#01C6D9',
                    borderWidth: 1,
                    borderRadius: 5,
                    barPercentage: 0.7
                }]
            },
            options: {
                indexAxis: 'y', // แสดงผลแนวนอนเพื่อให้ชื่อเครื่องจักรยาวๆ อ่านง่าย
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        grid: { color: '#f0f0f0' },
                        ticks: { stepSize: 1 }
                    },
                    y: {
                        grid: { display: false },
                        ticks: { font: { size: 12, weight: 'bold' } }
                    }
                }
            }
        });
    }
});
</script>
