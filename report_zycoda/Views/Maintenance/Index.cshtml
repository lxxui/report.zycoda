                                {
                                    <option value="@sec.Sections" selected="@(selectedValue == sec.Sections)">@sec.Sections - @sec.Name</option>
                                }
                            </optgroup>
                        
                            <optgroup label="📄 ธุรการ สวัสดิการ พัฒนาทรัพยากรบุคคล">
                                @foreach (var sec in allSections.Where(IsAdminHR))
                                {
                                    <option value="@sec.Sections" selected="@(selectedValue == sec.Sections)">@sec.Sections - @sec.Name</option>
                                }
                            </optgroup>
                            <optgroup label="🚚 จัดส่ง ยานยนต์ Logistics">
                                @foreach (var sec in allSections.Where(IsTransport))
                                {
                                    <option value="@sec.Sections" selected="@(selectedValue == sec.Sections)">@sec.Sections - @sec.Name</option>
                                }
                            </optgroup>
                            <optgroup label="🏭 ฝ่ายผลิตลาดกระบัง">
                                @foreach (var sec in allSections.Where(IsPdLadkrabang))
                                {
                                    <option value="@sec.Sections" selected="@(selectedValue == sec.Sections)">@sec.Sections - @sec.Name</option>
                                }
                            </optgroup>
                            <optgroup label="🔬 ฝ่ายผลิต ควบคุมคุณภาพ (QC)">
                                @foreach (var sec in allSections.Where(IsQcLadkrabang))
                                {
                                    <option value="@sec.Sections" selected="@(selectedValue == sec.Sections)">@sec.Sections - @sec.Name</option>
                                }
                            </optgroup>
                            <optgroup label="🛠️ วิศวกรรมลาดกระบัง">
                                @foreach (var sec in allSections.Where(IsEngLadkrabang))
                                {
                                    <option value="@sec.Sections" selected="@(selectedValue == sec.Sections)">@sec.Sections - @sec.Name</option>
                                }
                            </optgroup>
                            <optgroup label="🛠️ วิศวกรรมบางชัน">
                                @foreach (var sec in allSections.Where(IsEngBangchan))
                                {
                                    <option value="@sec.Sections" selected="@(selectedValue == sec.Sections)">@sec.Sections - @sec.Name</option>
                                }
                            </optgroup>
                            <optgroup label="🧪 ฝ่ายวิจัยและพัฒนา">
                                @foreach (var sec in allSections.Where(IsRD))
                                {
                                    <option value="@sec.Sections" selected="@(selectedValue == sec.Sections)">@sec.Sections - @sec.Name</option>
                                }
                            </optgroup>
                            <optgroup label="🏢 บำรุงรักษาอาคาร">
                                @foreach (var sec in allSections.Where(IsBuildingMaint))
                                {
                                    <option value="@sec.Sections" selected="@(selectedValue == sec.Sections)">@sec.Sections - @sec.Name</option>
                                }
                            </optgroup>
                            <optgroup label="🏭 ฝ่ายผลิตบางชัน">
                                @foreach (var sec in allSections.Where(IsPdBangchan))
                                {
                                    <option value="@sec.Sections" selected="@(selectedValue == sec.Sections)">@sec.Sections - @sec.Name</option>
                                }
                            </optgroup>
                            <optgroup label="📦 คลังวัตถุดิบ ประกันคุณภาพ บางชัน">
                                @foreach (var sec in allSections.Where(IsWhQaBangchan))
                                {
                                    <option value="@sec.Sections" selected="@(selectedValue == sec.Sections)">@sec.Sections - @sec.Name</option>
                                }
                            </optgroup>
                            <optgroup label="🏢 อื่นๆ">
                                @foreach (var sec in allSections.Where(x => !IsMatchedAny(x)))
                                {
                                    <option value="@sec.Sections" selected="@(selectedValue == sec.Sections)">@sec.Sections - @sec.Name</option>
                                }
                            </optgroup>
                        }
                    }

