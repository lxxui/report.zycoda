@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model List<report_zycoda.Models.MaintenanceApiModels>

@{
    var mode = Context.Request.Query["mode"].ToString() ?? "myjob";
    var jobtype = Context.Request.Query["jobtype"].ToString();
    var section = Context.Request.Query["sectioncreate"].ToString();
    var status = Context.Request.Query["status"].ToString();
    var reports = Model ?? new List<report_zycoda.Models.MaintenanceApiModels>();
    var culture = System.Globalization.CultureInfo.InvariantCulture;

    var start = Context.Request.Query["start"].ToString();
    var end = Context.Request.Query["end"].ToString();

    if (string.IsNullOrEmpty(start)) start = DateTime.Now.ToString("yyyy-MM-dd", culture);
    if (string.IsNullOrEmpty(end)) end = DateTime.Now.ToString("yyyy-MM-dd", culture);

    // Logic จัดกลุ่ม Machine (Top 10)
    var machineGroups = reports
        .Where(x => !string.IsNullOrEmpty(x.fldetail))
        .GroupBy(x => x.fldetail)
        .Select(g => new { Name = g.Key, Count = g.Count() })
        .OrderByDescending(x => x.Count)
        .Take(10).ToList();

    var machineLabels = machineGroups.Select(x => x.Name).ToList();
    var machineData = machineGroups.Select(x => x.Count).ToList();
}
<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // ใช้ฟังก์ชันตรวจสอบความพร้อม
    function initDataTable() {
    if ($.fn.DataTable) { // ถ้า Library มาแล้ว
    if (!$.fn.DataTable.isDataTable('#maintenanceTable')) { // ถ้ายังไม่ได้ Init
        $('#maintenanceTable').DataTable({
        "pageLength": 15,
        "lengthMenu": [10, 15, 20, 25],
        "language": {
        "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/th.json"
            },
                "order": [[0, "desc"]],
                    "columnDefs": [
                    { "orderable": false, "targets": [2] }
                        ],
                                // 🚩 ปรับตรงนี้: เพิ่ม class 'px-3 pt-2' เพื่อให้มีระยะห่างจากขอบซ้ายขวาและด้านบน
                                "dom": '<"d-flex justify-content-between align-items-center px-3 pt-2 mb-2"lf>rt<"d-flex justify-content-between align-items-center px-3 pb-3 mt-2"ip>'
                                });
                            }
                        } else {
                    // ถ้ายังไม่มา ให้รอ 100ms แล้วลองใหม่
                    setTimeout(initDataTable, 100);
                }
            }

        $(document).ready(function () {
        initDataTable();
    });
</script>
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-navy mb-0">รายงานภาพรวมงานแจ้งซ่อม (Overall Dashboard)</h4>
            <p class="text-muted small mb-0">สรุปข้อมูลการซ่อมบำรุงและสถานะเครื่องจักรทั้งหมดในระบบ</p>
        </div>
        <div class="text-end">
            <span class="badge bg-primary-soft text-primary p-2">
                <i class="bi bi-calendar3 me-2"></i>@start ถึง @end
            </span>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md">
            <div class="card stat-card border-0 shadow-sm text-center p-3 h-100" style="border-top: 4px solid #6c757d;">
                <small class="text-muted fw-bold text-uppercase">งานทั้งหมด</small>
                <h2 class="fw-bold mb-0 mt-2">@reports.Count</h2>
            </div>
        </div>
        <div class="col-md">
            <div class="card stat-card border-0 shadow-sm text-center p-3 h-100" style="border-top: 4px solid #dc3545;">
                <small class="text-danger fw-bold text-uppercase">Pending / Create</small>
                <h2 class="fw-bold mb-0 mt-2">@reports.Count(x => x.status == "Pending" || x.status == "Create")</h2>
            </div>
        </div>
        <div class="col-md">
            <div class="card stat-card border-0 shadow-sm text-center p-3 h-100" style="border-top: 4px solid #ffc107;">
                <small class="text-warning fw-bold text-uppercase">Accepted</small>
                <h2 class="fw-bold mb-0 mt-2">@reports.Count(x => x.status == "Accept")</h2>
            </div>
        </div>
        <div class="col-md">
            <div class="card stat-card border-0 shadow-sm text-center p-3 h-100" style="border-top: 4px solid #0d6efd;">
                <small class="text-primary fw-bold text-uppercase">Assigned</small>
                <h2 class="fw-bold mb-0 mt-2">@reports.Count(x => x.status == "Assigned")</h2>
            </div>
        </div>
        <div class="col-md">
            <div class="card stat-card border-0 shadow-sm text-center p-3 h-100" style="border-top: 4px solid #198754;">
                <small class="text-success fw-bold text-uppercase">Finished</small>
                <h2 class="fw-bold mb-0 mt-2">@reports.Count(x => x.status == "Finish" || x.status == "Confirm")</h2>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4" style="border-radius: 15px;">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-end">

                <!-- ประเภทงาน -->
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-navy">
                        <i class="bi bi-funnel-fill me-1"></i>ประเภทงาน
                    </label>
                    <select name="jobtype" class="form-select border-light bg-light">
                        <option value="EM,CM" selected="@(jobtype == "EM,CM")">-- ทุกประเภท --</option>
                        <option value="EM" selected="@(jobtype == "EM")">EM (Emergency)</option>
                        <option value="CM" selected="@(jobtype == "CM")">CM (General)</option>
                    </select>
                </div>

                <!-- วันที่ -->
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-navy">
                        <i class="bi bi-calendar-range-fill me-1"></i>ช่วงวันที่แจ้ง
                    </label>
                    <div class="input-group">
                        <input type="text" id="startDatePicker" name="start" class="form-control border-light bg-light" value="@start">
                        <span class="input-group-text bg-light border-light text-muted">-</span>
                        <input type="text" id="endDatePicker" name="end" class="form-control border-light bg-light" value="@end">
                    </div>
                </div>

                <!-- สถานะ -->
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-navy">
                        <i class="bi bi-check-circle-fill me-1"></i>สถานะ
                    </label>
                    <select name="Status" class="form-select border-light bg-light">
                        <option value="">-- ทั้งหมด --</option>
                        @foreach (var Stat in (List<report_zycoda.Models.StatusApiModels>)ViewBag.Status)
                        {
                            <option value="@Stat.id"
                                    selected="@(ViewBag.CurrentStatus == Stat.id ? "selected" : null)">
                                @Stat.name
                            </option>
                        }
                    </select>
                </div>

                <!-- 🔥 Section -->
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-navy">
                        <i class="bi bi-diagram-3-fill me-1"></i>หน่วยงานรับแจ้ง (สำหรับวิศวะ)
                    </label>
                    <select name="Sectioncreate" class="form-select border-light bg-light">
                        <option value="">-- ทั้งหมด --</option>

                        @* <optgroup label="🏭 หน่วยงานผลิต">
                            <option value="product_lkb">ลาดกระบัง</option>
                            <option value="product_bc">บางชัน</option>
                        </optgroup> *@

                        <optgroup label="⚙️ หน่วยงานวิศวกรรม">
                            <option value="engineer_lkb">ลาดกระบัง</option>
                            <option value="engineer_bc">บางชัน</option>
                        </optgroup>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-navy">
                        <i class="bi bi-diagram-3-fill me-1"></i>หน่วยงานแจ้งงาน (สำหรับผลิต)
                    </label>
                    <select name="Sectioncreate" class="form-select border-light bg-light">
                        <option value="">-- ทั้งหมด --</option>
                        <optgroup label="🏭 หน่วยงานผลิต">
                            <option value="product_lkb">ลาดกระบัง</option>
                            <option value="product_bc">บางชัน</option>
                        </optgroup>

                    </select>
                </div>

                <!-- ปุ่ม -->
                <div class="col-md-2 d-flex gap-2">

                    <!-- ค้นหา -->
                    <button type="submit" id="btnSearch" class="btn btn-navy w-100 py-2 fw-bold shadow-sm">
                        <i class="bi bi-search me-1"></i>ค้นหา
                    </button>

                    <!-- 🔥 ปริ้น -->
                    <button type="button" onclick="printReport()" class="btn btn-outline-navy w-100 py-2 fw-bold shadow-sm">
                        <i class="bi bi-printer me-1"></i>พิมพ์
                    </button>

                </div>

            </form>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm h-100 p-3" style="border-radius: 15px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-navy mb-0">สัดส่วนสถานะงานซ่อม</h6>
                </div>
                <div style="height: 280px;"><canvas id="maintenancePieChart"></canvas></div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card border-0 shadow-sm h-100 p-3" style="border-radius: 15px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-navy mb-0">Top 10 เครื่องจักรที่แจ้งซ่อมบ่อยที่สุด</h6>
                </div>
                <div style="height: 280px;"><canvas id="maintenanceBarChart"></canvas></div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
        <div class="card-header bg-white border-0 py-3">
            <h6 class="fw-bold text-navy mb-0"><i class="bi bi-table me-2"></i>รายการข้อมูลงานแจ้งซ่อม</h6>
        </div>
        <div class="table-responsive">
            <table id="maintenanceTable" class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4" style="width: 100px;">Job ID</th>
                        <th style="width: 140px;">วันที่</th>
                        <th style="width: 120px;">หน่วยงาน</th>
                        <th class="text-center">ประเภท</th> <!-- 🔥 เพิ่ม -->
                        <th>รายละเอียด</th>
                        @* <th class="text-center">Downtime</th> *@
                        <th class="text-center">สถานะ</th>
                        <th class="pe-4">ผู้แจ้ง</th>
                    </tr>
                </thead>

                <tbody class="border-top-0">
                    @foreach (var item in reports)
                    {
                        <tr>
                            <!-- Job ID -->
                            <td class="ps-4 fw-bold text-navy">#@item.id</td>

                            <!-- วันที่ -->
                            <td>
                                @if (DateTime.TryParse(item.timecreate, out DateTime dt))
                                {
                                    <div class="fw-bold small">@dt.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted" style="font-size: 0.7rem;">@dt.ToString("HH:mm") น.</div>
                                }
                                else
                                {
                                    <span class="small">@item.timecreate</span>
                                }
                            </td>

                            <!-- หน่วยงาน -->
                            <td>
                                <span class="badge bg-white text-dark border fw-normal">
                                    @item.sectioncreate
                                </span>
                            </td>

                            <!-- 🔥 ประเภทงาน -->
                            <td class="text-center">
                                @item.jobtype
                            </td>


                            <!-- รายละเอียด -->
                            <td>
                                <div class="fw-bold text-primary small">
                                    @item.fl (@item.fldetail)
                                </div>

                                <div class="text-muted small text-truncate"
                                     style="max-width: 400px;"
                                     title="@item.detail">
                                    @item.detail
                                </div>
                            </td>

                            <!-- Downtime -->
                            @* <td class="text-center">
                                <span class="badge bg-light text-dark">
                                    <i class="bi bi-clock-history me-1 text-primary"></i>
                                    @item.downtime m
                                </span>
                            </td> *@

                            <!-- สถานะ -->
                            <td class="text-center">
                                <span class="badge rounded-pill @item.StatusCssClass px-3 py-2 small">
                                    @item.status
                                </span>
                            </td>

                        

                            <!-- ผู้แจ้ง -->
                            <td class="pe-4">
                                @{
                                    string displayUser = "";

                                    if (item.usercreate != null)
                                    {
                                        if (item.usercreate is string nameStr)
                                        {
                                            displayUser = nameStr;
                                        }
                                        else
                                        {
                                            var jsonUser = Newtonsoft.Json.Linq.JObject.FromObject(item.usercreate);
                                            displayUser = jsonUser["name"]?.ToString() ?? "";
                                        }
                                    }
                                }

                                @if (!string.IsNullOrEmpty(displayUser))
                                {
                                    <span title="@displayUser">
                                        @(displayUser.Length > 12 ? displayUser.Substring(0, 12) + "..." : displayUser)
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
document.addEventListener("DOMContentLoaded", function () {

    // ==========================================
    // 🔹 1. Date Picker
    // ==========================================
    const dateConfig = {
        dateFormat: "Y-m-d",
        altInput: true,
        altFormat: "d/m/Y",
        allowInput: true
    };

    flatpickr("#startDatePicker", dateConfig);
    flatpickr("#endDatePicker", dateConfig);

    // ==========================================
    // 🔹 2. เตรียมข้อมูลสถานะ (Pie Chart)
    // ==========================================
    const statusLabels = ['แจ้งงานใหม่', 'รับงานแล้ว', 'ปิดงาน'];

    const statusValues = [
        @reports.Count(x => x.status?.Trim() == "Create"),
        @reports.Count(x => x.status?.Trim() == "Accept"),
        @reports.Count(x => x.status?.Trim() == "Confirm")
    ];

    const modernColors = ['#F9A602', '#01C6D9', '#01A182'];
    const hoverColors = ['#FDCA5C', '#84EAED', '#03CB98'];

    // ==========================================
    // 🔹 3. Doughnut Chart
    // ==========================================
    const ctxPie = document.getElementById('maintenancePieChart');

    if (ctxPie) {
        new Chart(ctxPie, {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusValues,
                    backgroundColor: modernColors,
                    hoverBackgroundColor: hoverColors,
                    borderColor: '#ffffff',
                    borderWidth: 2,
                    hoverOffset: 15,
                    borderRadius: 5
                }]
            },
            options: {
                maintainAspectRatio: false,
                cutout: '70%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 20,
                            font: { size: 14, family: 'Tahoma' }
                        }
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let total = context.chart.getDatasetMeta(0).total;
                                let percentage = Math.round((context.raw / total) * 100);
                                return ` ${context.label}: ${context.raw} งาน (${percentage}%)`;
                            }
                        }
                    }
                }
            }
        });
    }

    // ==========================================
    // 🔹 4. Bar Chart (Machine Ranking)
    // ==========================================
    const ctxBar = document.getElementById('maintenanceBarChart');

    if (ctxBar) {
        const barCanvas = ctxBar.getContext('2d');

        // ดึงข้อมูลจาก Razor
        let rawMachineLabels = @Html.Raw(Json.Serialize(machineLabels));
        let rawMachineData = @Html.Raw(Json.Serialize(machineData));

        // 🔥 รวม + sort มาก → น้อย
        let sortedMachineList = rawMachineLabels.map((label, index) => ({
            label: label,
            value: rawMachineData[index]
        })).sort((a, b) => b.value - a.value);

        const finalLabels = sortedMachineList.map(x => x.label);
        const finalData = sortedMachineList.map(x => x.value);

        // gradient
        let gradientBar = barCanvas.createLinearGradient(0, 0, 500, 0);
        gradientBar.addColorStop(0, '#01C6D9');
        gradientBar.addColorStop(1, 'rgba(1, 198, 217, 0.1)');

        new Chart(barCanvas, {
            type: 'bar',
            data: {
                labels: finalLabels,
                datasets: [{
                    label: 'จำนวนงาน',
                    data: finalData,
                    backgroundColor: gradientBar,
                    borderColor: '#01C6D9',
                    borderWidth: 1,
                    borderRadius: 5,
                    barPercentage: 0.7
                }]
            },
            options: {
                indexAxis: 'y',
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    x: {
                        beginAtZero: true,
                        grid: { color: '#f0f0f0' },
                        ticks: { stepSize: 1 }
                    },
                    y: {
                        grid: { display: false },
                        ticks: {
                            font: { size: 12, weight: 'bold' }
                        }
                    }
                }
            }
        });
    }

});
</script>
