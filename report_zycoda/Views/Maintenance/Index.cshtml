        /* เส้นสแกนที่ดูทันสมัยขึ้น */
        .scanner-line {
        position: absolute;
        top: 0;
        left: -10%;
        width: 120%;
        height: 3px;
        background: linear-gradient(90deg, transparent, #fff, transparent);
        box-shadow: 0 0 10px #fff;
        animation: scan-vertical 2s ease-in-out infinite;
        }

        @@keyframes scan-vertical {
        0% {
        top: 0%;
        opacity: 0;
        }

        50% {
        opacity: 1;
        }

        100% {
        top: 100%;
        opacity: 0;
        }
        }

        .loading-text {
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: 0.2rem;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
        }

        .loading-text span {
        display: inline-block;
        animation: wave 1.5s infinite ease-in-out;
        }

        /* หน่วงเวลาแต่ละตัวอักษรให้เป็นคลื่น */
        .loading-text span:nth-child(1) {
        animation-delay: 0.1s;
        }

        .loading-text span:nth-child(2) {
        animation-delay: 0.2s;
        }

        .loading-text span:nth-child(3) {
        animation-delay: 0.3s;
        }

        .loading-text span:nth-child(4) {
        animation-delay: 0.4s;
        }

        .loading-text span:nth-child(5) {
        animation-delay: 0.5s;
        }

        .loading-text span:nth-child(6) {
        animation-delay: 0.6s;
        }

        .loading-text span:nth-child(7) {
        animation-delay: 0.7s;
        }

        .loading-text span:nth-child(8) {
        animation-delay: 0.8s;
        }

        .loading-text span:nth-child(9) {
        animation-delay: 0.9s;
        }

        .loading-text span:nth-child(10) {
        animation-delay: 1.0s;
        }

        #loader-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        background-color: rgba(255, 255, 255, 0.9); /* พื้นหลังขาวจางๆ ให้เห็นข้างหลังนิดหน่อย */
        display: flex;
        justify-content: center; /* จัดกลางแนวนอน */
        align-items: center; /* จัดกลางแนวตั้ง */
        z-index: 9999; /* ให้อยู่ชั้นบนสุดของทุกอย่าง */
        }

        .loader-content {
        text-align: center; /* จัดตัวอักษรข้างในให้ตรงกลาง */
        }

        /* ตกแต่ง Icon เพิ่มเติมเพื่อให้ดู Modern */
        .icon-wrapper {
        position: relative;
        font-size: 4rem;
        color: #001f3f; /* สี Navy ของฝ้าย */
        margin-bottom: 20px;
        }

        /* ตัวอย่างการทำ Animation ให้ตัวอักษรค่อยๆ เด้ง */
        .loading-text span {
        display: inline-block;
        font-weight: 800;
        letter-spacing: 5px;
        color: #001f3f;
        animation: pulse 1.5s infinite;
        }

        @@keyframes pulse {
        0%, 100% {
        opacity: 0.3;
        transform: scale(1);
        }

        50% {
        opacity: 1;
        transform: scale(1.1);
        }
        }

        /* หน่วงเวลาให้ตัวอักษรแต่ละตัวเต้นไม่พร้อมกัน */
        .loading-text span:nth-child(1) {
        animation-delay: 0.1s;
        }

        .loading-text span:nth-child(2) {
        animation-delay: 0.2s;
        }

        .loading-text span:nth-child(3) {
        animation-delay: 0.3s;
        }

        @@keyframes wave {
        0%, 100% {
        transform: translateY(0);
        opacity: 0.3;
        }

        50% {
        transform: translateY(-5px);
        opacity: 1;
        color: #06B6D4;
        }
        }

        .sub-text {
        color: rgba(255,255,255,0.6);
        font-size: 0.9rem;
        margin-top: 10px;
        }

        /* ปรับแต่ง Radio Button ให้ดูโมเดิร์นขึ้น */
        .btn-check:checked + .btn-outline-primary {
        background-color: #0d6efd;
        color: white;
        box-shadow: inset 0 3px 5px rgba(0,0,0,0.125);
        }

        .btn-outline-primary {
        border-color: #dee2e6;
        color: #6c757d;
        background-color: #f8f9fa;
        }

        .btn-outline-primary:hover {
        background-color: #e9ecef;
        color: #0d6efd;
        border-color: #0d6efd;
        }


        /* ปรับขนาดเพื่อให้ 9 Card เรียงกันสวยๆ บนจอใหญ่ */
        @@media (min-width: 1200px) {
        .col-lg-1-5 {
        flex: 0 0 auto;
        width: 11.11%; /* 100% / 9 cards */
        }
        }

        /* เพิ่มเพื่อให้ col-lg-1-2 ทำงาน (แบ่ง 10-12 ส่วนในแถวเดียวบนจอใหญ่) */
        @@media (min-width: 992px) {
        .col-lg-1-2 {
        flex: 0 0 auto;
        width: 10%; /* 100% / 10 = 10% ต่อ Card */
        }
        }

    </style>


</head>
<body>
    <div class="container-fluid py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold text-navy mb-0">รายงานภาพรวมงานแจ้งซ่อม (Overall Dashboard)</h4>
                <p class="text-muted small mb-0">สรุปข้อมูลการซ่อมบำรุงและสถานะเครื่องจักรทั้งหมดในระบบ</p>
            </div>
            <div class="text-end">
                <div class="badge bg-primary-soft text-primary p-2 shadow-sm" style="border-radius: 8px;">
                    <i class="bi bi-clock-history me-2"></i>
                    <span id="realtime-clock" class="fw-bold">กำลังโหลดเวลา...</span>
                </div>
            </div>
        </div>


        <div class="row g-2 mb-4 text-center">
            <!-- 1. ALL JOBS -->
            <div class="col-2 col-md-4-cols col-lg-6-cols">
                <div class="card border-0 shadow-sm p-2 h-100 bg-dark text-white status-card">
                    <div class="d-flex justify-content-between align-items-start px-1">
                        <small class="fw-bold card-label">ALL JOBS</small>
                        <i class="bi bi-grid-fill opacity-50 small"></i>
                    </div>
                    <h2 class="fw-bold mb-0 mt-1 card-value">@reports.Count</h2>
                </div>
            </div>

            <!-- 2. PENDING / CREATE -->
            <div class="col-2 col-md-4-cols col-lg-6-cols">
                <div class="card border-0 shadow-sm p-2 h-100 status-card" style="border-top: 4px solid #dc3545; background-color: #fff5f5;">
                    <div class="d-flex justify-content-between align-items-start px-1">
                        <small class="text-danger fw-bold card-label">PENDING / CREATE</small>
                        <i class="bi bi-clock-history text-danger opacity-50 small"></i>
                    </div>
                    @{
                        var pCount = reports.Count(x => (x.statustext ?? "").Trim().Equals("Pending", StringComparison.OrdinalIgnoreCase));
                        var cCount = reports.Count(x => (x.statustext ?? "").Trim().Equals("Create", StringComparison.OrdinalIgnoreCase));
                    }
                    <h2 class="fw-bold mb-0 mt-1 text-danger card-value">@(pCount + cCount)</h2>
                    <div class="mt-auto pt-1 d-flex justify-content-between border-top border-danger border-opacity-10" style="font-size: 0.6rem;">
                        <span class="text-danger">P: <strong>@pCount</strong></span>
                        <span class="text-danger">C: <strong>@cCount</strong></span>
                    </div>
                </div>
            </div>

            <!-- 3. ACCEPT -->
            <div class="col-2 col-md-4-cols col-lg-6-cols">
                <div class="card border-0 shadow-sm p-2 h-100 status-card" style="border-top: 4px solid #ffc107; background-color: #fffdf2;">
                    <div class="d-flex justify-content-between align-items-start px-1">
                        <small class="text-warning fw-bold card-label">ACCEPT</small>
                        <i class="bi bi-bookmark-check-fill text-warning opacity-50 small"></i>
                    </div>
                    <h2 class="fw-bold mb-0 mt-1 text-warning card-value">
                        @reports.Count(x => (x.statustext ?? "").Trim().Equals("Accept", StringComparison.OrdinalIgnoreCase))
                    </h2>
                </div>
            </div>

            <!-- 4. ASSIGN -->
            <div class="col-2 col-md-4-cols col-lg-6-cols">
                <div class="card border-0 shadow-sm p-2 h-100 status-card" style="border-top: 4px solid #0d6efd; background-color: #f5faff;">
                    <div class="d-flex justify-content-between align-items-start px-1">
                        <small class="text-primary fw-bold card-label">ASSIGN</small>
                        <i class="bi bi-person-badge-fill text-primary opacity-50 small"></i>
                    </div>
                    <h2 class="fw-bold mb-0 mt-1 text-primary card-value">
                        @reports.Count(x => (x.statustext ?? "").Contains("Assign", StringComparison.OrdinalIgnoreCase))
                    </h2>
                </div>
            </div>

            <!-- 5. SUCCESS -->
            <div class="col-2 col-md-4-cols col-lg-6-cols">
                <div class="card border-0 shadow-sm p-2 h-100 status-card" style="border-top: 4px solid #198754; background-color: #f5fff9;">
                    <div class="d-flex justify-content-between align-items-start px-1">
                        <small class="text-success fw-bold card-label">SUCCESS</small>
                        <i class="bi bi-check-all text-success opacity-50 small"></i>
                    </div>
                    @{
                        var finCount = reports.Count(x => (x.statustext ?? "").Trim().Equals("Finish", StringComparison.OrdinalIgnoreCase));
                        var conCount = reports.Count(x => (x.statustext ?? "").Trim().Equals("Confirm", StringComparison.OrdinalIgnoreCase));
                    }
                    <h2 class="fw-bold mb-0 mt-1 text-success card-value">@(finCount + conCount)</h2>
                    <div class="mt-auto pt-1 d-flex justify-content-between border-top border-success border-opacity-10" style="font-size: 0.6rem;">
                        <span class="text-success">Fin: <strong>@finCount</strong></span>
                        <span class="text-success">Con: <strong>@conCount</strong></span>
                    </div>
                </div>
            </div>

            <!-- 6. REJECT / DENY -->
            <div class="col-2 col-md-4-cols col-lg-6-cols">
                <div class="card border-0 shadow-sm p-2 h-100 status-card" style="border-top: 4px solid #6c757d; background-color: #f8f9fa;">
                    <div class="d-flex justify-content-between align-items-start px-1">
                        <small class="text-secondary fw-bold card-label">REJECT/DENY</small>
