    <script>
            // --------------------------------------------------
            // 1. เตรียม Lookup Data (ประกาศไว้นอกสุดเพื่อให้ทุกฟังก์ชันเห็น)
            // --------------------------------------------------
            const sectionLookup = {};
            @if (ViewBag.SectionList != null)
            {
                    foreach (var item in (List<report_zycoda.Models.SectionApiModels>)ViewBag.SectionList)
                    {
                            <text>sectionLookup["@item.section?.Trim()"] = "@Html.Raw(item.name?.Replace("\"", "\\\""))";</text>
                    }
            }

            // --------------------------------------------------
            // 2. ฟังก์ชัน Helper (ประกาศแบบ Global)
            // --------------------------------------------------
            function getSectionName(code) {
                if (!code || code === '-') return '-';
                const cleanCode = String(code).trim();
                return sectionLookup[cleanCode] || cleanCode;
            }

            function formatDT(dateStr) {
                if (!dateStr || dateStr === '-' || dateStr === '0001-01-01T00:00:00') return '-';
                try {
                    const d = new Date(dateStr);
                    if (isNaN(d.getTime())) return dateStr;
                    return new Intl.DateTimeFormat('en-GB', {
                        day: '2-digit', month: '2-digit', year: 'numeric',
                        hour: '2-digit', minute: '2-digit', hour12: false
                    }).format(d).replace(/\//g, '-');
                } catch (e) { return dateStr; }
            }

            function updateClock() {
                const now = new Date();
                const options = {
                    day: '2-digit', month: '2-digit', year: '2-digit',
                    hour: '2-digit', minute: '2-digit', second: '2-digit',
                    hour12: false
                };
                const clockElement = document.getElementById('realtime-clock');
                if (clockElement) {
                    clockElement.innerText = now.toLocaleString('th-TH', options);
                }
            }

            // --------------------------------------------------
            // 3. ฟังก์ชัน Print Report
            // --------------------------------------------------
            function PrintReport(reportType) {
                const start = document.getElementById("startDatePicker")?.value || "";
                const end = document.getElementById("endDatePicker")?.value || "";
                const status = document.getElementById("filterStatus")?.value || "";
                const jobType = document.getElementById("filterJobType")?.value || "";
                const sFrom = document.getElementById("secFrom")?.value || document.getElementById("sectionFrom")?.value || "";
                const sTo = document.getElementById("secTo")?.value || document.getElementById("sectionTo")?.value || "";

                const baseUrl = '/Report/PrintReport';
                const url = `${baseUrl}?start=${encodeURIComponent(start)}&end=${encodeURIComponent(end)}&status=${encodeURIComponent(status)}&sectionFrom=${encodeURIComponent(sFrom)}&sectionTo=${encodeURIComponent(sTo)}&jobtype=${encodeURIComponent(jobType)}&rptType=${reportType}`;

                window.open(url, '_blank');
                $('#printSelectModal').modal('hide');
            }

            // --------------------------------------------------
            // 4. ทำงานเมื่อ Document พร้อม
            // --------------------------------------------------
            $(document).ready(function () {
                // นาฬิกา
                setInterval(updateClock, 1000);
                updateClock();

                // DataTable
              if (!$.fn.DataTable.isDataTable('#maintenanceTable')) {
                    $('#maintenanceTable').DataTable({
                        "pageLength": 10,
                        "lengthMenu": [[10, 15, 25, 50, 100], [10, 15, 25, 50, 100]],
                        "language": { "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/th.json" },
                        "order": [[0, "desc"]],
                        "dom": '<"d-flex justify-content-between align-items-center px-3 pt-2 mb-2"l f>rt<"d-flex justify-content-between align-items-center px-3 pb-3 mt-2"i p>'
                    });
                }

                // คำนวณช่วงวันที่
                const today = new Date();
                const minDate = new Date();
                minDate.setFullYear(today.getFullYear() - 2);

                // Start Date
                flatpickr("#startDatePicker", {
                    dateFormat: "Y-m-d",
                    altInput: true,
                    altFormat: "d/m/Y",
                    minDate: minDate,
                    maxDate: today
                });

                // End Date
                flatpickr("#endDatePicker", {
                    dateFormat: "Y-m-d",
                    altInput: true,
                    altFormat: "d/m/Y",
                    minDate: minDate,
                    maxDate: today
                });

                // Click Row เพื่อดู Modal
                $('.job-row').on('click', function() {
                    const $el = $(this);

                    $('#mId').text($el.data('id'));
                    $('#mMachine').text($el.data('machine') || '-');
                    $('#mType').text($el.data('type') || '-');
                    $('#mUser').text($el.data('user') || '-');
                    $('#mDetail').text($el.data('detail') || '-');

                    const status = $el.data('status');
                    const cssClass = $el.data('css') || 'bg-secondary';
                    $('#mStatus').text(status).removeClass().addClass('badge rounded-pill ' + cssClass);

                    const secCreateCode = $el.data('sectioncreate');
                    const secTargetCode = $el.data('section');

                    $('#mSectionCreateName').text(getSectionName(secCreateCode));
                    $('#mSectionCreateCode').text(secCreateCode);
                    $('#mSection').text(getSectionName(secTargetCode));

                    const assignData = $el.data('uassign');
                    $('#mAssign').text(assignData || 'ยังไม่มอบหมาย');

                    const acceptUser = $el.data('useraccept');
                    const finishUser = $el.data('userfinish');
                    $('#mFinish').text(finishUser || 'ยังไม่มีผู้รับงาน');
                    // มี accept / finish 
                    $('#mAccept').text(acceptUser || 'ยังไม่มีผู้รับงาน');

                    $('#mTimeCreate').text(formatDT($el.data('timecreate')));
                    $('#mTimeAccept').text(formatDT($el.data('timeaccept')));

                    $('#jobDetailModal').modal('show');
                });

                // --------------------------------------------------
                // 5. Chart Setup (ย่อโค้ดเพื่อความสะอาด)
                // --------------------------------------------------
                const zycodaPalette = { pending: '#F43F5E', accept: '#F59E0B', finish: '#10B981', primary: '#001f3f', accent: '#06B6D4' };
                const commonFont = { size: 12, family: "'Sarabun', sans-serif", weight: '500' };

                const ctxPie = document.getElementById('maintenancePieChart');
                if (ctxPie) {
                    new Chart(ctxPie, {
                        type: 'doughnut',
                        data: {
                            labels: ['รอดำเนินการ', 'กำลังแก้ไข', 'เสร็จสิ้น'],
                            datasets: [{
                                data: [@reports.Count(x => x.status == "Create" || x.status == "Pending"), @reports.Count(x => x.status == "Accept"), @reports.Count(x => x.status == "Finish" || x.status == "Confirm")],
                                backgroundColor: [zycodaPalette.pending, zycodaPalette.accept, zycodaPalette.finish],
                                cutout: '75%', borderRadius: 8, spacing: 5
                            }]
                        },
                        options: { maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, font: commonFont } } } }
                    });
                }

                const ctxBar = document.getElementById('maintenanceBarChart');
                if (ctxBar) {
                    const gradient = ctxBar.getContext('2d').createLinearGradient(0, 0, 400, 0);
                    gradient.addColorStop(0, '#001f3f'); gradient.addColorStop(1, '#06B6D4');
                    new Chart(ctxBar, {
                        type: 'bar',
                        data: {
                            labels: @Html.Raw(Json.Serialize(machineLabels)),
                            datasets: [{ label: 'จำนวนครั้ง', data: @Html.Raw(Json.Serialize(machineData)), backgroundColor: gradient, borderRadius: 6, barThickness: 18 }]
                        },
                        options: { indexAxis: 'y', maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { beginAtZero: true, ticks: { stepSize: 1 } }, y: { ticks: { font: commonFont } } } }
                    });
                }
            });

            $(document).ready(function () {

                // สั่งให้ทำงานทุก 60 วินาที
                    setInterval(refreshDashboard, 60000);

            $('form').on('submit', function () {
                // เช็คก่อนว่าฟอร์มผ่าน Validation ไหม (ถ้ามี)
                // if ($(this).valid()) {

                    // แสดง Loader กลางหน้าจอ
                    $('#loader-wrapper').fadeIn(200); // หรือใช้ .show()

                    // ปิดปุ่มค้นหาเพื่อกันกดซ้ำ
                    $('button[type="submit"]').prop('disabled', true);



                // }
            });
        });

        function refreshDashboard() {
            // ดึงค่า Query String ปัจจุบัน (เพื่อให้ค้นหาตามเงื่อนไขที่เลือกค้างไว้ได้)
            const params = new URLSearchParams(window.location.search);

            // ใช้ jQuery Load หรือ Fetch ไปดึงข้อมูล (ในที่นี้แนะนำให้เรียก API ที่คุณมีอยู่แล้ว)
            // หรือถ้าเอาแบบกำปั้นทุบดิน คือสั่ง reload เฉพาะส่วน table และ card
            $.get(window.location.href, function(data) {
                // หาเฉพาะส่วนของ Content มาเปลี่ยน
                const newHtml = $(data);
                $('.row.g-3.mb-4.text-center').html(newHtml.find('.row.g-3.mb-4.text-center').html()); // อัปเดต Card ตัวเลข
                $('#maintenanceTable').html(newHtml.find('#maintenanceTable').html()); // อัปเดตตาราง

                // ถ้ามีกราฟ ต้องสั่งทำลายกราฟเก่าแล้ววาดใหม่ด้วย (Chart.js .destroy())
                console.log("Dashboard Updated: " + new Date().toLocaleTimeString());
            });
        }

            // ตัวแปรเก็บ Job ID ล่าสุดที่มีในหน้าจอตอนนี้
            let lastJobId = 0;

            $(document).ready(function() {
                // หา ID ที่สูงที่สุดในตารางตอนโหลดหน้าครั้งแรก
                updateLastJobId();

                // ตั้งเวลาเช็คทุก 1 นาที (60000 ms)
                setInterval(checkNewJob, 60000);
            });

            function updateLastJobId() {
                // ดึงตัวเลขจากคอลัมน์ Job ID (ที่เขียนว่า #12345)
                $('.job-row').each(function() {
                    let id = parseInt($(this).data('id'));
                    if (id > lastJobId) lastJobId = id;
                });
            }

            function checkNewJob() {
                const currentUrl = window.location.href;

                $.get(currentUrl, function(data) {
                    const newHtml = $(data);
                    let hasNewJob = false;

                    // เช็คว่าในข้อมูลใหม่ มี ID ที่มากกว่า lastJobId ไหม
                    newHtml.find('.job-row').each(function() {
                        let id = parseInt($(this).data('id'));
                        if (id > lastJobId) {
                            hasNewJob = true;
                            return false; // ออกจาก loop
                        }
                    });

                    if (hasNewJob) {
                        // 1. แสดง Toast แจ้งเตือน
                        $('#newJobToast').toast({ delay: 5000 }); // แสดง 5 วินาที
                        $('#newJobToast').toast('show');

                        // 2. เล่นเสียงแจ้งเตือน (Optional - ถ้าอยากให้มีเสียง)
                        // playNotificationSound();

                        // 3. อัปเดตข้อมูลในหน้าจอ (เรียกฟังก์ชันเดิม)
                        refreshDashboard();

                        // 4. อัปเดต lastJobId เป็นค่าใหม่ล่าสุด
                        setTimeout(updateLastJobId, 2000);
                    }
                });
            }

            function refreshDashboard() {
                $.get(window.location.href, function(data) {
                    const newHtml = $(data);
                    $('.row.g-3.mb-4.text-center').html(newHtml.find('.row.g-3.mb-4.text-center').html());
                    $('#maintenanceTable tbody').html(newHtml.find('#maintenanceTable tbody').html());
                    // ถ้ามีกราฟ อย่าลืมอัปเดตกราฟที่นี่ด้วยครับ
                });
            }
    </script>
</body>

</html>









