        /* Custom Responsive Grid สำหรับ 6 คอลัมน์ */
        @@media (min-width: 1200px) {
        .col-lg-1-5 {
        flex: 0 0 auto;
        width: 16.66666667%;
        }
        }

        .card {
        transition: transform 0.2s;
        cursor: default;
        }

