@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model List<report_zycoda.Models.MaintenanceApiModels>

@{
    // 1. ดึงค่า State ต่างๆ (ดึงจาก ViewBag ที่ Controller ส่งมาจะแม่นยำกว่า Query ตรงๆ)
    var view = ViewBag.CurrentView ?? "followup";
    var jobtype = ViewBag.CurrentJobType ?? "";
    var selectedStatus = ViewBag.SelectedStatus ?? "All";
    var start = ViewBag.CurrentStart ?? "";
    var end = ViewBag.CurrentEnd ?? "";
    var sectionFrom = ViewBag.CurrentSectionFrom ?? "";
    var sectionTo = ViewBag.CurrentSectionTo ?? "";

    var reports = Model ?? new List<report_zycoda.Models.MaintenanceApiModels>();
    var userClass = User.FindFirst("UserClass")?.Value;

    // 2. จัดการข้อมูลสำหรับ Chart (Top 10 Machines)
    var machineGroups = reports
        .Where(x => !string.IsNullOrEmpty(x.fldetail))
        .GroupBy(x => x.fldetail!.Trim())
        .Select(g => new { Name = g.Key, Count = g.Count() })
        .OrderByDescending(x => x.Count)
        .Take(10)
        .ToList();

    var machineLabels = machineGroups.Select(x => x.Name).ToList();
    var machineData = machineGroups.Select(x => x.Count).ToList();

    // 3. จัดการ Master Data Section
    var sectionList = ViewBag.SectionList as List<report_zycoda.Models.SectionApiModels> ?? new List<report_zycoda.Models.SectionApiModels>();

    // สร้าง Dictionary สำหรับดึงชื่อเต็มแผนก (Key เป็นตัวพิมพ์เล็ก-ใหญ่ก็ได้)
    var sectionDict = sectionList
        .Where(x => !string.IsNullOrEmpty(x.Sections))
        .GroupBy(x => x.Sections!.Trim()) // ป้องกัน Key ซ้ำ
        .ToDictionary(
            g => g.Key,
            g => !string.IsNullOrEmpty(g.First().Name) ? g.First().Name : g.Key,
            StringComparer.OrdinalIgnoreCase
        );
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- 1. CSS Frameworks -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <!-- 2. FIX: Bootstrap Icons (ใช้ CDN เพื่อแก้ปัญหา 404 ในเครื่อง) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
