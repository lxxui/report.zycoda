                                            string deadlineText = "-";
                                            string priorityDisplay = item.priority ?? "0"; // สมมติว่าเก็บเลข 3, 7, 30 เอาไว้

                                            if (DateTime.TryParse(item.timecreate, out DateTime startDate))
                                            {
