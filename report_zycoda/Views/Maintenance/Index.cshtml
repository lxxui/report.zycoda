                        bool IsSafetyBangchan(SectionApiModels sec) => sec.Sections == "310098";
                        bool IsSafetyLadkrabang(SectionApiModels sec) => sec.Sections == "310100";

                        bool IsIT(SectionApiModels sec)
                        {
                            int code = GetSecInt(sec.Sections);
                            return (code >= 140200 && code <= 140700);
                        }

                        bool IsCentralFactory(SectionApiModels sec) => sec.Sections == "310015" || sec.Sections == "310016";
                        bool IsAdminLadkrabang(SectionApiModels sec) => sec.Sections == "310140" || sec.Sections == "310150";
                        bool IsAdminBangchan(SectionApiModels sec) => sec.Sections == "310160";

                        bool IsTransport(SectionApiModels sec)
                        {
                            int code = GetSecInt(sec.Sections);
                            return (code >= 310210 && code <= 310260);
                        }

                        bool IsRD(SectionApiModels sec)
                        {
