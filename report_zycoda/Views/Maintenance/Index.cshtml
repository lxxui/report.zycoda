                                        }
                                    </td>
                                    <td>
                                        <span class="badge text-dark">
                                            @{
                                                var sCode = item.sectioncreate?.Trim() ?? "";
                                                // ถ้ามีใน Dictionary ให้โชว์ชื่อ ถ้าไม่มีให้โชว์รหัสเดิม
