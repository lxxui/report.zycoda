@model List<report_zycoda.Models.MaintenanceReport>


@{
	var jobtype = Context.Request.Query["jobtype"].ToString();
	var start = Context.Request.Query["start"].ToString();
	var end = Context.Request.Query["end"].ToString();
	var section = Context.Request.Query["section"].ToString();
	var reports = Model ?? new List<report_zycoda.Models.MaintenanceReport>();
	// var summary = reports.GroupBy(x => x.statustext).Select(g => new { statustext = g.Key ?? "Unknown", Count = g.Count() }).ToList();
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
	/* ปรับแต่งสี Badge ให้ตรงตามภาพ */
	.st-pending {
		background-color: #f1f3f5;
		color: #495057;
		border-radius: 50px;
	}
	/* เทาอ่อน */
	.st-create {
		background-color: #ffdce0;
		color: #af233a;
		border-radius: 50px;
	}
	/* ชมพู */
	.st-accept {
		background-color: #fff2cc;
		color: #856404;
		border-radius: 50px;
	}
	/* เหลืองนวล */
	.st-assigned {
		background-color: #ffe599;
		color: #000000;
		border-radius: 50px;
		border: 1px solid #ffd966;
	}
	/* เหลืองทอง + ขอบ */
	.st-finish {
		background-color: #e2f0e9;
		color: #155724;
		border-radius: 50px;
	}
	/* เขียวซีด */
	.st-confirm {
		background-color: #b7e4c7;
		color: #084f28;
		border-radius: 50px;
	}
	/* เขียวเข้มขึ้น */

	.badge-statustext {
		padding: 6px 16px;
		font-weight: 600;
		display: inline-flex;
		align-items: center;
		font-size: 0.85rem;
	}
</style>

<div class="container-fluid py-4">
	<div class="card shadow-sm mb-4">
		<div class="card-header bg-primary text-white">
			<h4 class="mb-0"><i class="bi bi-tools"></i> Maintenance Report</h4>
		</div>
		<div class="card-body bg-light">
			<form method="get" class="row g-3 align-items-end">

				<div class="col-md-2">
					<label class="form-label fw-bold">ประเภทงาน</label>
					<select name="jobtype" class="form-select">
						<option value="EM" selected="@(jobtype == "EM")">งานฉุกเฉิน</option>
						<option value="CM" selected="@(jobtype == "CM")">งานทั่วไป</option>
						<option value="EM,CM" selected="@(jobtype == "EM,CM")">-- ทั้งหมด --</option>
					</select>
				</div>

				<div class="col-md-3">
					<label class="form-label fw-bold">หน่วยงาน (Section)</label>
					<select name="section" class="form-select">
						<option value="">-- All Sections --</option>
						@foreach (var sec in ViewBag.Sections)
						{
							<option value="@sec.section" selected="@(section == sec.section)">
								@(sec.section + " - " + sec.name)
							</option>
						}
					</select>
				</div>

				<div class="col-md-2">
					<label class="form-label fw-bold">วันที่เริ่มแจ้ง</label>
					<input type="text" id="startDatePicker" name="start" class="form-control" value="@start">
				</div>

				<div class="col-md-2">
					<label class="form-label fw-bold">สิ้นสุด</label>
					<input type="text" id="endDatePicker" name="end" class="form-control" value="@end">
				</div>

				<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
				<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

				<script>
					// ตั้งค่าให้เลือกวันที่แล้วแสดงผลเป็น วัน/เดือน/ปี
					const config = {
						dateFormat: "Y-m-d",    // รูปแบบที่จะส่งกลับไปที่ Controller (yyyy-mm-dd)
						altInput: true,         // เปิดใช้งานตัวช่วยแสดงผล
						altFormat: "d/m/Y",     // รูปแบบที่คนจะเห็นในช่อง (วัน/เดือน/ปี)
						allowInput: true
					};

					flatpickr("#startDatePicker", config);
					flatpickr("#endDatePicker", config);
				</script>

				<div class="col-md-2">
					<label class="form-label fw-bold">สถานะงาน</label>
					<select name="statustextFilter" class="form-select shadow-sm">
						<option value="">-- ทั้งหมด --</option>
						@{
							// รายการสถานะตาม Logic ที่คุณใช้แสดงผล
							var statustextList = new[] { "Pending", "Create", "Accept", "Assigned", "Finish", "Confirm" };
							var currentstatustext = Context.Request.Query["statustextFilter"].ToString();
						}
						@foreach (var st in statustextList)
						{
							<option value="@st" selected="@(currentstatustext == st)">@st</option>
						}
					</select>
				</div>


				<div class="col-md-1">
					<button type="submit" class="btn btn-primary w-100">
						<i class="bi bi-search"></i> Search
					</button>
				</div>
			</form>
		</div>
	</div>

	<div class="d-flex justify-content-between align-items-center mb-3">
		<h5 class="text-secondary mb-0">
			Total Records: <span class="badge bg-info text-dark">@(Model != null ? Model.Count : 0)</span>
		</h5>
	</div>
	<div class="d-flex flex-wrap gap-2 mb-3">
		<span class="badge-statustext st-pending">Pending (@Model.Count(x => x.statustext == "Pending"))</span>
		<span class="badge-statustext st-create">Create (@Model.Count(x => x.statustext == "Create"))</span>
		<span class="badge-statustext st-accept">Accept (@Model.Count(x => x.statustext == "Accept"))</span>
		<span class="badge-statustext st-assigned">
			<i class="bi bi-flag-fill me-1 text-primary"></i>Assigned (@Model.Count(x => x.statustext == "Assigned"))
		</span>
		<span class="badge-statustext st-finish">Finish (@Model.Count(x => x.statustext == "Finish"))</span>
		<span class="badge-statustext st-confirm">Confirm (@Model.Count(x => x.statustext == "Confirm"))</span>
	</div>

	<div class="card shadow-sm">
		<div class="table-responsive">
			<table class="table table-hover table-striped mb-0" style="table-layout: fixed; width:100%;">
				<thead class="table-dark">
					<tr>
						<th style="width:120px;">เลขที่เอกสาร</th>
						<th style="width:220px;">สถานที่/อุปกรณ์/เครื่องจักร</th>
						<th style="width:220px;">รายละเอียด</th>
						<th style="width:220px;">สาเหตุ/ปัญหา</th>
						<th class="text-center" style="width:140px;">เวลาเครื่องจักรหยุด</th>
						<th class="text-center" style="width:120px;">สถานะ</th>
						<th style="width:160px;">ผู้แจ้งงาน</th>
					</tr>
				</thead>
				<tbody>
					@if (Model != null && Model.Count > 0)
					{
						foreach (var item in Model)
						{
							<tr>
								<td class="fw-bold text-secondary">@item.id</td>
								<td>
									<span class="text-primary text-uppercase small fw-bold d-block">@item.fldetail</span>
								</td>
								<td>@item.problem</td>
								<td>@item.causes</td>
								<td class="text-center" style="min-width: 140px;">
									@{
										// ใช้ .GetValueOrDefault() เพื่อแก้ CS0266 และ CS8629
										int totalMin = item.downtime.GetValueOrDefault();
										string downtimeDisplay = "";

										if (totalMin > 0)
										{
											int d = totalMin / 1440;
											int h = (totalMin % 1440) / 60;
											int m = totalMin % 60;

											if (d > 0) downtimeDisplay += $"{d} วัน ";
											if (h > 0) downtimeDisplay += $"{h} ชม. ";
											if (m > 0 || (d == 0 && h == 0)) downtimeDisplay += $"{m} นาที";
										}
										else
										{
											downtimeDisplay = "0 นาที";
										}
									}
									<span class="badge rounded-pill bg-warning text-dark px-3 shadow-sm">
										@downtimeDisplay
									</span>
								</td>

								<td class="text-center">
									@{
										// ตัวแปรเก็บ Class และ Icon ตามสถานะจาก API
										var statustextStr = item.statustext?.Trim();
										var statustextClass = statustextStr switch
										{
											"Pending" => "st-pending",
											"Create" => "st-create",
											"Accept" => "st-accept",
											"Assigned" => "st-assigned",
											"Finish" => "st-finish",
											"Confirm" => "st-confirm",
											_ => "bg-light text-muted"
										};
									}

									<span class="badge-statustext @statustextClass shadow-sm">
										@if (statustextStr == "Assigned")
										{
											<i class="bi bi-flag-fill me-1 text-primary"></i>
										}
										@statustextStr
									</span>
								</td>
								<td><small class="text-muted">@item.usercreate</small></td>
							</tr>
						}
					}
					else
					{
						<tr>
							<td colspan="7" class="text-center py-5 text-muted">
								<i class="bi bi-inbox fs-1 d-block mb-2"></i>
								No data found for the selected criteria.
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>