@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@model List<report_zycoda.Models.MaintenanceApiModels>

@{
    var mode = Context.Request.Query["mode"].ToString() ?? "myjob";
    var jobtype = Context.Request.Query["jobtype"].ToString();
    var section = Context.Request.Query["sectioncreate"].ToString();
    var status = Context.Request.Query["status"].ToString();
    var reports = Model ?? new List<report_zycoda.Models.MaintenanceApiModels>();
    var culture = System.Globalization.CultureInfo.InvariantCulture;

    var start = Context.Request.Query["start"].ToString();
    var end = Context.Request.Query["end"].ToString();

    if (string.IsNullOrEmpty(start)) start = DateTime.Now.ToString("yyyy-MM-dd", culture);
    if (string.IsNullOrEmpty(end)) end = DateTime.Now.ToString("yyyy-MM-dd", culture);

    // Logic จัดกลุ่ม Machine (Top 10)
    var machineGroups = reports
        .Where(x => !string.IsNullOrEmpty(x.fldetail))
        .GroupBy(x => x.fldetail)
        .Select(g => new { Name = g.Key, Count = g.Count() })
        .OrderByDescending(x => x.Count)
        .Take(10).ToList();

    var machineLabels = machineGroups.Select(x => x.Name).ToList();
    var machineData = machineGroups.Select(x => x.Count).ToList();
}

<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<style>
    .job-row:hover { background-color: rgba(0,0,0,0.02) !important; cursor: pointer; }
    .bg-navy { background-color: #001f3f; }
    .text-navy { color: #001f3f; }
    .btn-navy { background-color: #001f3f; color: white; }
    .btn-navy:hover { background-color: #002d5c; color: white; }
    .btn-outline-navy { border: 1px solid #001f3f; color: #001f3f; }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold text-navy mb-0">รายงานภาพรวมงานแจ้งซ่อม (Overall Dashboard)</h4>
            <p class="text-muted small mb-0">สรุปข้อมูลการซ่อมบำรุงและสถานะเครื่องจักรทั้งหมดในระบบ</p>
        </div>
        <div class="text-end">
            <div class="badge bg-primary-soft text-primary p-2 shadow-sm" style="border-radius: 8px;">
                <i class="bi bi-clock-history me-2"></i>
                <span id="realtime-clock" class="fw-bold">กำลังโหลดเวลา...</span>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4 text-center">
        <div class="col-md">
            <div class="card border-0 shadow-sm p-3 h-100" style="border-top: 4px solid #6c757d;">
                <small class="text-muted fw-bold text-uppercase">งานทั้งหมด</small>
                <h2 class="fw-bold mb-0 mt-2">@reports.Count</h2>
            </div>
        </div>
        <div class="col-md">
            <div class="card border-0 shadow-sm p-3 h-100" style="border-top: 4px solid #dc3545;">
                <small class="text-danger fw-bold text-uppercase">Pending / Create</small>
                <h2 class="fw-bold mb-0 mt-2">@reports.Count(x => x.status == "Pending" || x.status == "Create")</h2>
            </div>
        </div>
        <div class="col-md">
            <div class="card border-0 shadow-sm p-3 h-100" style="border-top: 4px solid #ffc107;">
                <small class="text-warning fw-bold text-uppercase">Accepted</small>
                <h2 class="fw-bold mb-0 mt-2">@reports.Count(x => x.status == "Accept")</h2>
            </div>
        </div>
        <div class="col-md">
            <div class="card border-0 shadow-sm p-3 h-100" style="border-top: 4px solid #0d6efd;">
                <small class="text-primary fw-bold text-uppercase">Assigned</small>
                <h2 class="fw-bold mb-0 mt-2">@reports.Count(x => x.status == "Assigned")</h2>
            </div>
        </div>
        <div class="col-md">
            <div class="card border-0 shadow-sm p-3 h-100" style="border-top: 4px solid #198754;">
                <small class="text-success fw-bold text-uppercase">Finished</small>
                <h2 class="fw-bold mb-0 mt-2">@reports.Count(x => x.status == "Finish" || x.status == "Confirm")</h2>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4" style="border-radius: 15px;">
        <div class="card-body p-4">
<form method="get" class="row g-3 align-items-end" id="filterForm">
    <div class="col-md-2">
        <label class="form-label small fw-bold text-navy">ประเภทงาน</label>
        <select name="jobtype" id="filterJobType" class="form-select border-light bg-light">
            <option value="EM,CM" selected="@(jobtype == "EM,CM")">-- ทุกประเภท --</option>
            <option value="EM" selected="@(jobtype == "EM")">EM (Emergency)</option>
            <option value="CM" selected="@(jobtype == "CM")">CM (General)</option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label small fw-bold text-navy">ช่วงวันที่แจ้ง</label>
        <div class="input-group">
            <input type="text" id="startDatePicker" name="start" class="form-control border-light bg-light" value="@start">
            <span class="input-group-text bg-light border-light text-muted">-</span>
            <input type="text" id="endDatePicker" name="end" class="form-control border-light bg-light" value="@end">
        </div>
    </div>

    <div class="col-md-2">
        <label class="form-label small fw-bold text-navy">สถานะ</label>
        <select name="Status" id="filterStatus" class="form-select border-light bg-light">
            <option value="">-- ทั้งหมด --</option>
            @foreach (var Stat in (List<report_zycoda.Models.StatusApiModels>)ViewBag.Status)
            {
                <option value="@Stat.id" selected="@(ViewBag.CurrentStatus == Stat.id ? "selected" : null)">@Stat.name</option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label small fw-bold text-navy">หน่วยงานรับแจ้ง</label>
        <select name="sectionReceive" id="secReceive" class="form-select border-light bg-light">
            <option value="">-- ทั้งหมด --</option>
            <optgroup label="⚙️ วิศวกรรม">
                <option value="engineer_lkb" selected="@(Context.Request.Query["sectionReceive"] == "engineer_lkb")">วิศวะ ลาดกระบัง</option>
                <option value="engineer_bc" selected="@(Context.Request.Query["sectionReceive"] == "engineer_bc")">วิศวะ บางชัน</option>
            </optgroup>
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label small fw-bold text-navy">หน่วยงานคนแจ้ง</label>
        <select name="sectionRequest" id="secRequest" class="form-select border-light bg-light">
            <option value="">-- ทั้งหมด --</option>
            <optgroup label="🏭 ฝ่ายผลิต">
                <option value="product_lkb" selected="@(Context.Request.Query["sectionRequest"] == "product_lkb")">ผลิต ลาดกระบัง</option>
                <option value="product_bc" selected="@(Context.Request.Query["sectionRequest"] == "product_bc")">ผลิต บางชัน</option>
            </optgroup>
        </select>
    </div>

    <div class="col-md-1 d-flex gap-2">
        <button type="submit" class="btn btn-navy p-2 flex-fill shadow-sm" title="ค้นหา">
            <i class="bi bi-search"></i>
        </button>
      @*   <button type="button" onclick="printReport()" class="btn btn-outline-navy p-2 flex-fill shadow-sm" title="พิมพ์">
            <i class="bi bi-printer"></i>
        </button> *@
        <button type="button" data-bs-toggle="modal" data-bs-target="#printSelectModal" class="btn btn-outline-navy p-2 flex-fill shadow-sm" title="พิมพ์">
            <i class="bi bi-printer"></i>
        </button>
    </div>
</form>        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm h-100 p-3" style="border-radius: 15px;">
                <h6 class="fw-bold text-navy mb-3">สัดส่วนสถานะงานซ่อม</h6>
                <div style="height: 280px;"><canvas id="maintenancePieChart"></canvas></div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card border-0 shadow-sm h-100 p-3" style="border-radius: 15px;">
                <h6 class="fw-bold text-navy mb-3">Top 10 เครื่องจักรที่แจ้งซ่อมบ่อยที่สุด</h6>
                <div style="height: 280px;"><canvas id="maintenanceBarChart"></canvas></div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
        <div class="table-responsive">
            <table id="maintenanceTable" class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Job ID</th>
                        <th>วันที่</th>
                        <th>หน่วยงาน</th>
                        <th class="text-center">ประเภท</th>
                        <th>รายละเอียด</th>
                        <th class="text-center">สถานะ</th>
                        <th class="pe-4">ผู้แจ้ง</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in reports)
                    {
                        <tr class="job-row" 
                            data-id="@item.id" 
                            data-status="@item.status"
                            data-machine="@item.fl (@item.fldetail)"
                            data-type="@item.jobtype"
                            data-detail="@item.detail"
                            data-user="@item.usercreate"
                            data-section="@item.sectioncreate"
                            data-css="@item.StatusCssClass">
                            <td class="ps-4 fw-bold text-navy">#@item.id</td>
                            <td>
                                @if (DateTime.TryParse(item.timecreate, out DateTime dt)) {
                                    <div class="fw-bold small">@dt.ToString("dd/MM/yyyy")</div>
                                    <div class="text-muted" style="font-size: 0.7rem;">@dt.ToString("HH:mm") น.</div>
                                }
                            </td>
                            <td><span class="badge bg-white text-dark border">@item.sectioncreate</span></td>
                            <td class="text-center">@item.jobtype</td>
                            <td>
                                <div class="fw-bold text-primary small">@item.fl (@item.fldetail)</div>
                                <div class="text-muted small text-truncate" style="max-width: 300px;">@item.detail</div>
                            </td>
                            <td class="text-center">
                                <span class="badge rounded-pill @item.StatusCssClass px-3 py-2 small">@item.status</span>
                            </td>
                            <td class="pe-4 small">@item.usercreate</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="jobDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 15px;">
            <div class="modal-header bg-navy text-white">
                <h5 class="modal-title fw-bold">รายละเอียดงาน #<span id="mId"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="small text-muted">สถานะ:</label>
                    <span id="mStatus" class="badge rounded-pill ms-2"></span>
                </div>
                <h6><strong>เครื่องจักร:</strong> <span id="mMachine" class="text-primary"></span></h6>
                <p><strong>ประเภท:</strong> <span id="mType"></span></p>
                <div class="bg-light p-3 rounded mb-3">
                    <strong>อาการเสีย:</strong><br><span id="mDetail"></span>
                </div>
                <div class="row small">
                    <div class="col-6"><strong>ผู้แจ้ง:</strong> <span id="mUser"></span></div>
                    <div class="col-6 text-end"><strong>หน่วยงาน:</strong> <span id="mSection"></span></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="printSelectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 15px;">
            <div class="modal-header bg-navy text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-printer me-2"></i>เลือกประเภทรายงานที่ต้องการพิมพ์</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="list-group">
                    <button type="button" onclick="printReport('JTR')" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                        <i class="bi bi-file-earmark-text text-primary fs-4 me-3"></i>
                        <div>
                            <div class="fw-bold">1. รายงานติดตามความคืบหน้า (สำหรับผู้แจ้งงานตรวจสอบ)</div>
                            <small class="text-muted">ตรวจสอบสถานะ Job รายตัวแบบละเอียด</small>
                        </div>
                    </button>

                    <button type="button" onclick="printReport('PM')" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                        <i class="bi bi-tools text-warning fs-4 me-3"></i>
                        <div>
                            <div class="fw-bold">2. รายงานการซ่อมเครื่องจักร PM</div>
                            <small class="text-muted">สรุปงานบำรุงรักษาเชิงป้องกันประจำงวด</small>
                        </div>
                    </button>

                    <button type="button" onclick="printReport('JTR_INTERNAL')" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                        <i class="bi bi-person-check text-info fs-4 me-3"></i>
                        <div>
                            <div class="fw-bold">3. รายงานติดตามความคืบหน้า (ผู้แจ้งงานตรวจสอบ)</div>
                            <small class="text-muted">เวอร์ชันสรุปสำหรับหน่วยงานภายใน</small>
                        </div>
                    </button>

                    <button type="button" onclick="printReport('HOTLINE')" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                        <i class="bi bi-telephone-outbound text-danger fs-4 me-3"></i>
                        <div>
                            <div class="fw-bold">4. Hot Line รายงานรวมจำนวนทั้งหมด</div>
                            <small class="text-muted">รับงาน / กำลังทำ / ส่งมอบ (สรุปยอดรวม)</small>
                        </div>
                    </button>

                    <button type="button" onclick="printReport('MONTHLY')" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                        <i class="bi bi-calendar-check text-success fs-4 me-3"></i>
                        <div>
                            <div class="fw-bold">5. รายงานติดตามความคืบหน้าแบบรายเดือน</div>
                            <small class="text-muted">สรุปภาพรวม Performance ประจำเดือน</small>
                        </div>
                    </button>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">ยกเลิก</button>
            </div>
        </div>
    </div>
</div>


<script>
   // 1. ฟังก์ชัน Print Report (เปลี่ยนชื่อเป็น printReport ให้ตรงกับปุ่มใน Modal)
    function printReport(reportType) {
        // ดึงค่าจาก Element ID ให้ตรงกับที่ประกาศไว้ใน Form
        var start = document.getElementById("startDatePicker").value;
        var end = document.getElementById("endDatePicker").value;
        var status = document.getElementById("filterStatus").value;
    
        // Mapping ID: secReceive -> sectionTo, secRequest -> sectionFrom 
        // (หรือตาม Logic ที่ Fai วางไว้ใน Controller)
        var secTo = document.getElementById("secReceive").value;
        var secFrom = document.getElementById("secRequest").value;
        var jobType = document.getElementById("filterJobType").value;

        // พื้นฐาน URL ไปที่ Controller หลักที่เราแก้ไว้
        var baseUrl = '/Report/PrintReport';

        // สร้าง Query String
        var url = baseUrl
            + '?start=' + encodeURIComponent(start)
            + '&end=' + encodeURIComponent(end)
            + '&status=' + encodeURIComponent(status)
            + '&sectionFrom=' + encodeURIComponent(secFrom) // เปลี่ยนให้ตรงกับ Parameter ใน Controller
            + '&sectionTo=' + encodeURIComponent(secTo)     // เปลี่ยนให้ตรงกับ Parameter ใน Controller
            + '&jobType=' + encodeURIComponent(jobType)
            + '&rptType=' + reportType;

        // เปิดหน้าต่างใหม่เพื่อพิมพ์
        window.open(url, '_blank');

        // ปิด Modal
        $('#printSelectModal').modal('hide');
    }


    $(document).ready(function () {
        // 2. DataTable
        if (!$.fn.DataTable.isDataTable('#maintenanceTable')) {
            $('#maintenanceTable').DataTable({
                "pageLength": 15,
                "language": { "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/th.json" },
                "order": [[0, "desc"]],
                "dom": '<"d-flex justify-content-between align-items-center px-3 pt-2 mb-2"lf>rt<"d-flex justify-content-between align-items-center px-3 pb-3 mt-2"ip>'
            });
        }

        // 3. Flatpickr
        flatpickr("#startDatePicker", { dateFormat: "Y-m-d", altInput: true, altFormat: "d/m/Y" });
        flatpickr("#endDatePicker", { dateFormat: "Y-m-d", altInput: true, altFormat: "d/m/Y" });

        // 4. Modal Pop-up
        $('.job-row').on('click', function() {
            $('#mId').text($(this).data('id'));
            $('#mStatus').text($(this).data('status')).removeClass().addClass('badge rounded-pill ' + $(this).data('css'));
            $('#mMachine').text($(this).data('machine'));
            $('#mType').text($(this).data('type'));
            $('#mDetail').text($(this).data('detail'));
            $('#mUser').text($(this).data('user'));
            $('#mSection').text($(this).data('section'));
            $('#jobDetailModal').modal('show');
        });

        // 5. Chart.js Implementation
        const commonFont = { size: 13, family: 'Sarabun, sans-serif' };

        // Pie Chart
        const ctxPie = document.getElementById('maintenancePieChart');
        if (ctxPie) {
            new Chart(ctxPie, {
                type: 'doughnut',
                data: {
                    labels: ['Pending/Create', 'Accept', 'Finish/Confirm'],
                    datasets: [{
                        data: [
                            @reports.Count(x => x.status == "Create" || x.status == "Pending"),
                            @reports.Count(x => x.status == "Accept"),
                            @reports.Count(x => x.status == "Finish" || x.status == "Confirm")
                        ],
                        backgroundColor: ['#dc3545', '#ffc107', '#198754'],
                        borderWidth: 2,
                        borderRadius: 5
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    cutout: '65%',
                    plugins: { legend: { position: 'bottom', labels: { font: commonFont } } }
                }
            });
        }

        // Bar Chart
        const ctxBar = document.getElementById('maintenanceBarChart');
        if (ctxBar) {
            new Chart(ctxBar, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(Json.Serialize(machineLabels)),
                    datasets: [{
                        label: 'จำนวนครั้ง',
                        data: @Html.Raw(Json.Serialize(machineData)),
                        backgroundColor: '#01C6D9',
                        borderRadius: 5
                    }]
                },
                options: {
                    indexAxis: 'y',
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { x: { beginAtZero: true, ticks: { stepSize: 1 } } }
                }
            });
        }
    });


    function updateClock() {
        const now = new Date();
        
        // แปลงเป็นวันที่แบบไทย (พ.ศ.)
        // รูปแบบ: วันที่ 30 มี.ค. 2569 15:30:05
        const options = {
            day: '2-digit',
            month: '2-digit',
            year: '2-digit',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: false
        };

        // ใช้ th-TH เพื่อให้เป็น ปี พ.ศ. โดยอัตโนมัติ
        const thaiTime = now.toLocaleString('th-TH', options);
        
        const clockElement = document.getElementById('realtime-clock');
        if (clockElement) {
            clockElement.innerText = thaiTime;
        }
    }

    // เรียกทำงานทันทีที่โหลดหน้า
    updateClock();
    
    // ตั้งให้ทำงานทุกๆ 1 วินาที (1000ms)
    setInterval(updateClock, 1000);

</script>