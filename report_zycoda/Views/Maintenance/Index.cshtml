                                    data-css="@item.StatusCssClass"
                                    data-uassign="@(item.uassign != null && item.uassign.Any() ? string.Join(", ", item.uassign) : "")"
                                    data-useraccept="@item.useraccept"
                                    data-userfinish="@item.userfinish"
                                    data-timecreate="@item.timecreate"
                                    data-timeaccept="@item.timeaccept">

                                    <td class="ps-4 fw-bold text-navy">#@item.id</td>
                                    <td>
                                        @if (DateTime.TryParse(item.timecreate, out DateTime dt))
                                        {
                                            <div class="fw-bold small">@dt.ToString("dd/MM/yyyy")</div>
