        /* สีเฉพาะกลุ่มรายงาน */
        .bg-soft-primary {
        background-color: #e0e7ff;
        color: #4338ca;
        }

        .bg-soft-warning {
        background-color: #fef3c7;
        color: #b45309;
        }

        .bg-soft-info {
        background-color: #e0f2fe;
        color: #0369a1;
        }

