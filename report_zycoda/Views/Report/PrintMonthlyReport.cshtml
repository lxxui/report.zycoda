@model dynamic
@{
    Layout = null;
    var modelEnumerable = Model as System.Collections.IEnumerable;
    var isSummary = modelEnumerable?.Cast<object>().FirstOrDefault() is report_zycoda.Models.ReportSummary;
    var summaryList = isSummary ? (IEnumerable<report_zycoda.Models.ReportSummary>)Model : null;

    var totalAll   = summaryList?.Sum(x => x.OpenedToday + x.CarriedOver) ?? 0;
    var doneAll    = summaryList?.Sum(x => x.Finished) ?? 0;
    var backAll    = summaryList?.Sum(x => x.CarriedOver) ?? 0;
    var openAll    = summaryList?.Sum(x => x.OpenedToday) ?? 0;
    var overallPct = totalAll > 0 ? (int)Math.Round(doneAll * 100.0 / totalAll) : 0;

    var items = summaryList ?? new List<report_zycoda.Models.ReportSummary>();
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>ZYCODA Report System — Professional Cockpit</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Sarabun:wght@400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            /* Palette: Minimalist Dark Emerald & Clean Slate */
            --slate-bg: #f8fafc;
            --panel-white: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            
            /* Signature Theme Colors */
            --emerald-deep: #042f2e;
            --emerald-mid: #0d9488;
            --emerald-light: #f0fdfa;
            --emerald-text: #115e59;
            
            --coral-soft: #fff1f2;
            --coral-text: #9f1239;
            --coral-mid: #f43f5e;
            
            --brand-blue: #0284c7;
            --brand-blue-light: #f0f9ff;
            
            --border-clean: #e2e8f0;
            --shadow-subtle: 0 4px 30px rgba(15, 23, 42, 0.015);
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Plus Jakarta Sans', 'Sarabun', sans-serif;
            background-color: var(--slate-bg);
            color: var(--text-main);
            letter-spacing: -0.01em;
            -webkit-font-smoothing: antialiased;
        }

        .main-layout {
            max-width: 1400px;
            margin: 0 auto;
            padding: 2.5rem 2rem;
        }

        /* Top Executive Header & Quick Summary Integration */
        .header-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 3rem;
            flex-wrap: wrap;
            gap: 1.5rem;
        }
        
        .header-title h1 {
            font-size: 24px;
            font-weight: 700;
            color: var(--emerald-deep);
            letter-spacing: -0.03em;
        }
        
        .header-title p {
            font-size: 13.5px;
            color: var(--text-muted);
            margin-top: 2px;
        }

        .system-status {
            display: flex;
            align-items: center;
            gap: 12px;
            background: var(--panel-white);
            padding: 8px 16px;
            border-radius: 30px;
            box-shadow: var(--shadow-subtle);
            border: 1px solid var(--border-clean);
            font-size: 12px;
            font-weight: 600;
        }
        
        .status-indicator {
            width: 8px;
            height: 8px;
            background-color: var(--emerald-mid);
            border-radius: 50%;
        }

        /* Unified Stats Row (Borderless Ribbon) */
        .stats-ribbon {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1px;
            background-color: var(--border-clean);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: var(--shadow-subtle);
            margin-bottom: 2.5rem;
            border: 1px solid var(--border-clean);
        }

        .ribbon-item {
            background-color: var(--panel-white);
            padding: 1.5rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .ribbon-label {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .ribbon-value {
            font-size: 28px;
            font-weight: 700;
            color: var(--text-main);
            letter-spacing: -0.02em;
        }

        /* Grid Block Separation */
        .dashboard-grid {
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 2rem;
            align-items: start;
        }

        /* Borderless List/Table Panel */
        .data-panel {
            background-color: var(--panel-white);
            border-radius: 16px;
            padding: 1.75rem;
            box-shadow: var(--shadow-subtle);
            border: 1px solid var(--border-clean);
        }

        .panel-heading {
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--emerald-deep);
            margin-bottom: 1.5rem;
        }

        .custom-table {
            width: 100%;
            border-collapse: collapse;
        }

        .custom-table th {
            text-align: left;
            padding: 12px 16px;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-bottom: 1px solid var(--border-clean);
        }

        .custom-table td {
            padding: 16px;
            font-size: 13.5px;
            color: var(--text-main);
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .custom-table tbody tr:last-child td {
            border-bottom: none;
        }

        .custom-table tbody tr:hover td {
            background-color: #fafbfc;
        }

        .dept-bold {
            font-weight: 600;
            color: var(--emerald-deep);
        }

        /* Minimal Progress Indicator */
        .progress-container {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .progress-pill-track {
            flex: 1;
            height: 4px;
            background-color: #f1f5f9;
            border-radius: 2px;
            overflow: hidden;
        }

        .progress-pill-fill {
            height: 100%;
            border-radius: 2px;
        }

        .progress-number {
            font-size: 12px;
            font-weight: 600;
            width: 36px;
            text-align: right;
        }

        /* Status Tags Minimal */
        .tag {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 2px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
        }
        .tag-success { background-color: var(--emerald-light); color: var(--emerald-text); }
        .tag-danger { background-color: var(--coral-soft); color: var(--coral-text); }
        .tag-none { color: var(--text-muted); font-weight: 400; }

        /* Sidebar Analytics Block */
        .sidebar-analytics {
            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .chart-card {
            background-color: var(--panel-white);
            border-radius: 16px;
            padding: 1.75rem;
            box-shadow: var(--shadow-subtle);
            border: 1px solid var(--border-clean);
        }

        .donut-analytics-box {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 1rem;
            gap: 1rem;
        }

        .donut-relative {
            position: relative;
            width: 110px;
            height: 110px;
        }

        .donut-center-label {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .donut-center-label .num { font-size: 22px; font-weight: 700; color: var(--emerald-deep); }
        .donut-center-label .lbl { font-size: 9px; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em; }

        .donut-legends-vertical {
            display: flex;
            flex-direction: column;
            gap: 8px;
            flex: 1;
        }

        .legend-item-flat {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 500;
        }

        .legend-marker-group { display: flex; align-items: center; gap: 8px; }
        .marker-dot { width: 6px; height: 6px; border-radius: 50%; }

        /* Utilities */
        .text-center { text-align: center; }

        @@media (max-width: 1100px) {
            .dashboard-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<div class="main-layout">

    <!-- Top Executive Header -->
    <header class="header-section">
        <div class="header-title">
            <h1>ZYCODA Report System</h1>
            <p>ฝ่ายไอที — ข้อมูลวิเคราะห์ดัชนีชี้วัดประสิทธิภาพรายแผนก</p>
        </div>
        <div class="system-status">
            <span class="status-indicator"></span> Operational Live
        </div>
    </header>

    <!-- Unified Stats Ribbon -->
    <section class="stats-ribbon">
        <div class="ribbon-item">
            <span class="ribbon-label">ภาระงานรวมสะสม</span>
            <span class="ribbon-value">@totalAll</span>
        </div>
        <div class="ribbon-item" style="border-left: 1px solid var(--border-clean);">
            <span class="ribbon-label" style="color: var(--emerald-mid);">เสร็จสิ้นสำเร็จ</span>
            <span class="ribbon-value" style="color: var(--emerald-mid);">@doneAll</span>
        </div>
        <div class="ribbon-item" style="border-left: 1px solid var(--border-clean);">
            <span class="ribbon-label" style="color: var(--coral-mid);">งานคงค้างสะสม</span>
            <span class="ribbon-value" style="color: var(--coral-mid);">@backAll</span>
        </div>
        <div class="ribbon-item" style="border-left: 1px solid var(--border-clean);">
            <span class="ribbon-label">เปิดใหม่วันนี้</span>
            <span class="ribbon-value" style="color: var(--brand-blue);">@openAll</span>
        </div>
    </section>

    <!-- Main Asymmetric Grid -->
    <div class="dashboard-grid">
        
        <!-- Left Block: Borderless Operational Matrix -->
        <main class="data-panel">
            <div class="panel-heading">ดัชนีวัดผลแยกตามแผนกงาน</div>
            <table class="custom-table">
                <colgroup>
                    <col style="width: 28%;">
                    <col style="width: 14%;">
                    <col style="width: 14%;">
                    <col style="width: 14%;">
                    <col style="width: 30%;">
                </colgroup>
                <thead>
                    <tr>
                        <th>แผนก / ฝ่ายงาน</th>
                        <th class="text-center">เคสใหม่</th>
                        <th class="text-center">งานค้าง</th>
                        <th class="text-center">เสร็จสิ้น</th>
                        <th>สัดส่วนความสำเร็จ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        var total   = item.OpenedToday + item.CarriedOver;
                        var pct     = total > 0 ? (int)Math.Round(item.Finished * 100.0 / total) : 0;
                        var uiColor = pct >= 75 ? "var(--emerald-mid)" : pct >= 50 ? "var(--brand-blue)" : "var(--coral-mid)";
                        
                        <tr>
                            <td class="dept-bold">@item.SectionName</td>
                            <td class="text-center" style="font-weight: 500;">@item.OpenedToday</td>
                            <td class="text-center">
                                @if (item.CarriedOver > 0)
                                {
                                    <span class="tag tag-danger">@item.CarriedOver</span>
                                }
                                else
                                {
                                    <span class="tag tag-none">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="tag tag-success">@item.Finished</span>
                            </td>
                            <td>
                                <div class="progress-container">
                                    <div class="progress-pill-track">
                                        <div class="progress-pill-fill" style="width: @(pct)%; background-color: @uiColor;"></div>
                                    </div>
                                    <span class="progress-number" style="color: @uiColor;">@(pct)%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </main>

        <!-- Right Block: Pure Minimal Analytics -->
        <aside class="sidebar-analytics">
            
            <div class="chart-card">
                <div class="panel-heading" style="margin-bottom: 0.5rem;">อัตราความสำเร็จภาพรวม</div>
                <div class="donut-analytics-box">
                    <div class="donut-relative">
                        <canvas id="donutChart" width="110" height="110"></canvas>
                        <div class="donut-center-label">
                            <span class="num">@(overallPct)%</span>
                            <span class="lbl">KPI</span>
                        </div>
                    </div>
                    <div class="donut-legends-vertical">
                        <div class="legend-item-flat">
                            <div class="legend-marker-group">
                                <span class="marker-dot" style="background-color: var(--emerald-mid);"></span>
                                <span>ปิดงานสำเร็จ</span>
                            </div>
                            <span style="font-weight: 600; color: var(--text-main);">@doneAll</span>
                        </div>
                        <div class="legend-item-flat">
                            <div class="legend-marker-group">
                                <span class="marker-dot" style="background-color: var(--coral-mid);"></span>
                                <span>งานค้างสะสม</span>
                            </div>
                            <span style="font-weight: 600; color: var(--text-main);">@backAll</span>
                        </div>
                        <div class="legend-item-flat">
                            <div class="legend-marker-group">
                                <span class="marker-dot" style="background-color: var(--brand-blue);"></span>
                                <span>เปิดใหม่วันนี้</span>
                            </div>
                            <span style="font-weight: 600; color: var(--text-main);">@openAll</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="chart-card">
                <div class="panel-heading" style="margin-bottom: 1.25rem;">ความคืบหน้ารายแผนก (%)</div>
                <div style="position: relative; height: 160px;">
                    <canvas id="barPct"></canvas>
                </div>
            </div>

        </aside>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    const doneAll = @doneAll;
    const backAll = @backAll;
    const openAll = @openAll;

    const depts = [
        @foreach (var item in items)
        {
            var total = item.OpenedToday + item.CarriedOver;
            var pct   = total > 0 ? (int)Math.Round(item.Finished * 100.0 / total) : 0;
            @:{ name: "@item.SectionName", pct: @pct },
        }
    ];

    const labels    = depts.map(d => d.name);
    const pcts      = depts.map(d => d.pct);
    const barColors = pcts.map(p => p >= 75 ? '#0d9488' : p >= 50 ? '#0284c7' : '#f43f5e');

    /* Premium Minimalist Donut */
    new Chart(document.getElementById('donutChart'), {
        type: 'doughnut',
        data: {
            labels: ['เสร็จสิ้น', 'งานค้าง', 'งานเข้าวันนี้'],
            datasets: [{
                data: [doneAll, backAll, openAll],
                backgroundColor: ['#0d9488', '#f43f5e', '#0284c7'],
                borderWidth: 0,
                hoverOffset: 0
            }]
        },
        options: {
            responsive: false,
            cutout: '82%',
            plugins: { legend: { display: false }, tooltip: { enabled: true } }
        }
    });

    /* Professional Progress Bar Chart */
    new Chart(document.getElementById('barPct'), {
        type: 'bar',
        data: {
            labels,
            datasets: [{
                data: pcts,
                backgroundColor: barColors,
                borderRadius: 4,
                barThickness: 12
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                x: { grid: { display: false }, ticks: { font: { family: 'Sarabun', size: 10 }, color: '#94a3b8' } },
                y: { max: 100, grid: { color: '#f1f5f9' }, ticks: { font: { size: 9 }, color: '#94a3b8', callback: v => v + '%' } }
            }
        }
    });
</script>
</body>
</html>