@model List<report_zycoda.Models.MaintenanceApiModels>
@{
    Layout = null;

    // Helper สำหรับจัดการวันที่ (Support ทั้ง String และ DateTime)
    string FormatDT(object dateInput, string format = "dd/MM/yy HH:mm")
    {
        if (dateInput == null) return "-";
        string val = dateInput.ToString();
        if (string.IsNullOrEmpty(val)) return "-";
        return DateTime.TryParse(val, out DateTime dt) ? dt.ToString(format) : val;
    }
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Report - JCS</title>
    <style>
        @@page { size: A4 landscape; margin: 1cm; }
        body { font-family: 'TH Sarabun New', Tahoma, sans-serif; font-size: 14px; margin: 0; }
        .title { font-size: 18px; font-weight: bold; text-align: center; }
        .data-table { width: 100%; border-collapse: collapse; margin-top: 10px; table-layout: fixed; }
        .data-table th, .data-table td { border: 1px solid #000; padding: 4px; word-wrap: break-word; vertical-align: top; }
        .data-table th { background-color: #f2f2f2; text-align: center; font-weight: bold; }
        .text-center { text-align: center; }
        .text-right { text-align: right; }
        .small-text { font-size: 12px; line-height: 1.1; }
        thead { display: table-header-group; }
        tr { page-break-inside: avoid; }
        @@media print { .no-print { display: none; } }
    </style>
</head>
<body>

    <!-- Header -->
    <table style="width:100%;">
        <tr>
            <td style="width:25%;">RPT_PROGRESS_JOB<br />@DateTime.Now.ToString("yyyyMMdd")</td>
            <td style="width:50%;" class="text-center">
                <div class="title">รายงานติดตามความคืบหน้า Job</div>
                <div>สำหรับหน่วยงาน: @(ViewBag.SectionTo ?? "150000 ตรวจสอบ")</div>
            </td>
            <td style="width:25%;" class="text-right">
                วันที่พิมพ์: @DateTime.Now.ToString("dd/MM/yyyy")<br />
                เวลา: @DateTime.Now.ToString("HH:mm:ss")
            </td>
        </tr>
    </table>

    <!-- Data Table -->
    <table class="data-table">
        <thead>
            <tr>
                <th style="width:65px;">วันที่แจ้ง</th>
                <th style="width:90px;">Service No.</th>
                <th style="width:80px;">ประเภทงาน</th>
                <th>ปัญหา/รายละเอียด</th>
                <th style="width:100px;">ผู้แจ้ง/หน่วยงาน</th>
                <th style="width:70px;">สถานะ</th>
                <th style="width:100px;">แผน (รับ/เสร็จ)</th>
                <th style="width:100px;">ทำจริง (เริ่ม/เสร็จ)</th>
                <th style="width:50px;">Delay</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="text-center">@FormatDT(item.timecreate, "dd/MM/yy")</td>
                        <td class="text-center" style="font-weight:bold;">@(item.id ?? item.id_h ?? "-")</td>
                        <td class="text-center">@item.jobtype</td>
                        <td class="small-text">@(item.detail ?? item.detail_h)</td>
                        <td class="text-center small-text">
                            @* ใช้ UserDisplayName จาก Model ที่คุณเขียนไว้ *@
                            @item.UserDisplayName <br />
                            <span style="color:#666;">(@(item.sectioncreate ?? item.section))</span>
                        </td>
                        <td class="text-center">
                             @* ใช้ statustext หรือ status ตามลำดับ *@
                             @(item.statustext ?? item.status)
                        </td>
                        <td class="text-center small-text">
                            <span style="color:blue;">P: @FormatDT(item.timestart)</span><br/>
                            <span style="color:navy;">F: @FormatDT(item.timeend)</span>
                        </td>
                        <td class="text-center small-text">
                            <span style="color:green;">S: @FormatDT(item.timestartrepair)</span><br/>
                            <span style="color:red;">E: @FormatDT(item.timeendrepair)</span>
                        </td>
                        <td class="text-center">
                            @if (!string.IsNullOrEmpty(item.timedelay) && item.timedelay != "0")
                            {
                                <span style="color:red; font-weight:bold;">@item.timedelay</span>
                            }
                            else { <span>-</span> }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="9" class="text-center" style="padding:20px;">-- ไม่พบข้อมูล --</td></tr>
            }
        </tbody>
    </table>

    <div class="no-print" style="position:fixed; bottom:20px; right:20px;">
        <button onclick="window.print()" style="padding:10px 20px; background:#007bff; color:white; border:none; cursor:pointer; border-radius:4px;">
            Print Report
        </button>
    </div>

</body>
</html>