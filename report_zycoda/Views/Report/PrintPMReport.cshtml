@model List<report_zycoda.Models.MaintenanceApiModels>
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Print Report - JCS</title>

    <style>
            @@page {
                size: A4 landscape;
                margin: 1cm;
            }

            body {
                font-family: 'TH Sarabun New', Tahoma, sans-serif;
                font-size: 14px;
                margin: 0;
            }

            .title {
                font-size: 18px;
                font-weight: bold;
            }

            .report-header {
                width: 100%;
                margin-bottom: 10px;
            }

                .report-header td {
                    vertical-align: top;
                }

            .filter-table {
                width: 60%;
                margin: 0 auto 10px auto;
            }

                .filter-table td {
                    padding: 2px;
                }

            .data-table {
                width: 100%;
                border-collapse: collapse;
            }

                .data-table th,
                .data-table td {
                    border: 1px dashed #000;
                    padding: 4px;
                    word-break: break-word;
                }

                .data-table th {
                    text-align: center;
                    font-weight: bold;
                }

            .text-center {
                text-align: center;
            }

            .text-right {
                text-align: right;
            }

            /* รองรับหลายหน้า */
            thead {
                display: table-header-group;
            }

            tr {
                page-break-inside: avoid;
            }

            @@media print {
                .no-print {
                    display: none;
                }
            }
    </style>
</head>

<body>

    <!-- HEADER -->
    <table class="report-header">
        <tr>
            <td style="width:25%;">
                RPT_PROGRESS_FOR_RECEIVER<br />
                2603000753
            </td>

            <td style="width:50%;" class="text-center">
                <div class="title">
                    รายงานติดตามความคืบหน้า Job (สำหรับผู้รับแจ้งงานตรวจสอบ)
                </div>
                <div style="font-weight:bold;">
                    สำหรับหน่วยงาน 150000 ตรวจสอบ
                </div>
            </td>

            <td style="width:25%;" class="text-right">
                วันที่ : @DateTime.Now.ToString("dd/MM/yyyy")<br />
                เวลา : @DateTime.Now.ToString("HH:mm:ss")<br />
                Page : 1
            </td>
        </tr>
    </table>

    <!-- FILTER -->
    <table class="filter-table">
        <tr>
            <td>จากหน่วยงานแจ้ง : <b>@ViewBag.SectionFrom</b></td>
            <td>ถึงหน่วยงาน : <b>@ViewBag.SectionTo</b></td>
        </tr>
        <tr>
            <td>จากวันที่แจ้ง : <b>@ViewBag.StartDate</b></td>
            <td>ถึงวันที่ : <b>@ViewBag.EndDate</b></td>
        </tr>
        <tr>
            <td colspan="2">สถานะ JOB : <b>@ViewBag.Status</b></td>
        </tr>
    </table>

    <!-- DATA TABLE -->
    <table class="data-table">
        <thead>
            <tr>
                <th>วันที่แจ้ง</th>
                <th>Service No.</th>
                <th>รหัส - แบบฟอร์ม</th>
                <th>ปัญหา-รายละเอียด</th>
                <th>รหัส - หน่วยงาน</th>
                <th>ผู้แจ้ง</th>
                <th>สถานะ</th>

                <!-- เพิ่มตามฟอร์ม -->
                <th>แผนรับ</th>
                <th>แผนเสร็จ</th>
                <th>เริ่มจริง</th>
                <th>เสร็จจริง</th>
                <th>Delay(วัน)</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        @* 1. วันที่แจ้ง *@
                        <td class="text-center">
                            @if (DateTime.TryParse(item.timecreate, out DateTime dtCreate))
                            {
                                <span>@dtCreate.ToString("dd/MM/yy")</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>

                        <td class="fw-bold">@item.id</td>
                        <td class="text-center">@item.jobtype</td>
                        <td class="text-truncate" style="max-width:200px">@item.detail</td>
                        <td>@item.sectioncreate</td>
                        <td>@item.usercreate</td>
                        <td class="text-center">@item.status</td>

                        @* 2. แผนรับ/เสร็จ (Parse string เป็น DateTime) *@
                        <td class="text-center small">
                            <div>@(DateTime.TryParse(item.timestart, out DateTime ts) ? ts.ToString("dd/MM/yy HH:mm") : "-")</div>
                            <div class="text-muted">@(DateTime.TryParse(item.timeend, out DateTime te) ? te.ToString("dd/MM/yy HH:mm") : "-")</div>
                        </td>

                        @* 3. เริ่ม/เสร็จจริง *@
                        <td class="text-center small">
                            <div>@(DateTime.TryParse(item.timestartrepair, out DateTime trs) ? trs.ToString("dd/MM/yy HH:mm") : "-")</div>
                            <div class="text-muted">@(DateTime.TryParse(item.timeendrepair, out DateTime tre) ? tre.ToString("dd/MM/yy HH:mm") : "-")</div>
                        </td>

                        @* 4. DELAY (Parse string เป็น TimeSpan) *@
                        <td class="text-center">
                            @if (TimeSpan.TryParse(item.timedelay, out TimeSpan delay) && delay != TimeSpan.Zero)
                            {
                                <span class="text-danger">@((int)delay.TotalDays) วัน</span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="11" class="text-center">-- ไม่พบข้อมูล --</td></tr>
            }
        </tbody>
    </table>

    <!-- FOOTER -->
    <div style="text-align:center; margin-top:10px;">
        End of Report
    </div>

    <!-- PRINT BUTTON -->
    <div class="no-print" style="position: fixed; bottom: 20px; right: 20px;">
        <button onclick="window.print()" style="padding: 10px 20px; cursor: pointer;">
            Print PDF / Paper
        </button>
    </div>

</body>
</html>