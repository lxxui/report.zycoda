@model List<report_zycoda.Models.MaintenanceApiModels>

@{
    Layout = null;
    var reports = Model ?? new List<report_zycoda.Models.MaintenanceApiModels>();
    var today = DateTime.Now.Date;

    // --- Logic Summary เหมือนเดิม ---
    var summaryData = reports
        .GroupBy(x => x.sectioncreate ?? "ไม่ระบุแผนก")
        .Select(g => new {
            SectionName = g.Key,
            CarriedOver = g.Count(x => (x.status == "Accept" || x.status == "Assigned") 
                          && (DateTime.TryParse(x.timecreate, out DateTime dt) && dt.Date < today)),
            OpenedToday = g.Count(x => x.status == "Accept" 
                          && (DateTime.TryParse(x.timecreate, out DateTime dt) && dt.Date == today)),
            Finished = g.Count(x => x.status == "Finish" || x.status == "Confirm"),
            RejectedToday = g.Count(x => x.status == "Reject" 
                             && (DateTime.TryParse(x.timecreate, out DateTime dt) && dt.Date == today)),
            Pending = g.Count(x => x.status == "Accept"),
            WaitPart = g.Count(x => x.status != null && x.status.Contains("Spare"))
        })
        .OrderBy(x => x.SectionName)
        .ToList();
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Zycoda Reporting</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        @@import url('https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;600;700&display=swap');
        
        :root {
            --zycoda-navy: #001f3f;
            --zycoda-blue: #0056b3;
            --bg-body: #f4f7f9;
        }

        body { 
            font-family: 'Sarabun', sans-serif; 
            background-color: var(--bg-body);
            color: #333;
            margin: 0;
            padding-bottom: 100px; /* เว้นที่ให้ปุ่มลอย */
        }

        /* Web View - กว้างๆ */
        .report-container {
            max-width: 95%;
            margin: 30px auto;
            background: white;
            padding: 40px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            border-radius: 12px;
        }

        .report-header {
            border-bottom: 3px solid var(--zycoda-navy);
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        /* Floating Button Table */
        .floating-actions {
            position: fixed;
            bottom: 30px;
            right: 30px;
            display: flex;
            gap: 15px;
            z-index: 9999;
            background: rgba(255, 255, 255, 0.8);
            padding: 15px 25px;
            border-radius: 50px;
            backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px rgba(0,0,0,0.15);
            border: 1px solid rgba(255,255,255,0.3);
        }

        .btn-print {
            background-color: var(--zycoda-navy);
            color: white;
            border-radius: 25px;
            padding: 10px 25px;
            font-weight: 600;
            transition: all 0.3s;
        }

        .btn-print:hover {
            background-color: var(--zycoda-blue);
            transform: translateY(-2px);
            color: white;
        }

        /* Table Style */
        .table-custom {
            width: 100%;
            border-radius: 8px;
            overflow: hidden;
            border: 1px solid #eee;
        }

        .table-custom th {
            background-color: var(--zycoda-navy) !important;
            color: white !important;
            text-align: center;
            padding: 15px 10px;
            font-size: 13px;
            text-transform: uppercase;
            border: 1px solid rgba(255,255,255,0.1);
        }

        .table-custom td {
            padding: 12px 15px;
            border-bottom: 1px solid #eee;
            text-align: center;
        }

        .table-custom tr:nth-child(even) { background-color: #fafafa; }
        .table-custom tr:hover { background-color: #f1f7ff; }

        .stat-circle {
            width: 30px;
            height: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            font-weight: bold;
            font-size: 12px;
        }

        .bg-pending { background-color: #fff3cd; color: #856404; }
        .bg-new { background-color: #cfe2ff; color: #084298; }

        @@media print {
            .no-print, .floating-actions { display: none !important; }
            body { background: white; padding-bottom: 0; }
            .report-container { 
                max-width: 100%; 
                margin: 0; 
                padding: 0; 
                box-shadow: none; 
            }
            .table-custom th { -webkit-print-color-adjust: exact; }
            @@page { size: A4; margin: 1.5cm; }
        }
    </style>
</head>
<body>

    <div class="floating-actions no-print">
        <button onclick="window.close()" class="btn btn-outline-secondary btn-rounded me-2">
            <i class="bi bi-x-lg"></i> ปิด
        </button>
        <button onclick="window.print()" class="btn btn-print shadow-sm">
            <i class="bi bi-printer-fill me-2"></i> พิมพ์รายงานสรุป (A4)
        </button>
    </div>

    <div class="report-container">
        <div class="report-header row align-items-center">
            <div class="col-md-7">
                <h3 class="fw-bold text-navy mb-1">PRESIDENT BAKERY PCL.</h3>
                <h5 class="text-muted">@ViewBag.Title</h5>
                <div class="mt-3">
                    <span class="badge rounded-pill bg-light text-dark border">
                        <i class="bi bi-geo-alt-fill text-primary me-1"></i> @ViewBag.SectionFrom - @ViewBag.SectionTo
                    </span>
                </div>
            </div>
            <div class="col-md-5 text-md-end mt-3 mt-md-0">
                <div class="p-3 rounded-3 bg-light border d-inline-block text-start">
                    <div class="small"><b>เลขที่อ้างอิง:</b> @ViewBag.RefNo</div>
                    <div class="small"><b>วันที่พิมพ์:</b> @ViewBag.PrintDate</div>
                    <div class="small text-primary"><b>Code Form:</b> @ViewBag.CodeForm</div>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th rowspan="2">ลำดับ</th>
                        <th rowspan="2" style="text-align: left;">สายการผลิต / หน่วยงาน</th>
                        <th colspan="6">สถานะใบแจ้งซ่อม (ใบ)</th>
                    </tr>
                    <tr>
                        <th style="width: 100px;">แจ้งยกมา</th>
                        <th style="width: 100px;">เปิดเพิ่มวันนี้</th>
                        <th style="width: 100px;">ดำเนินการแล้ว</th>
                        <th style="width: 100px;">ยกเลิกวันนี้</th>
                        <th style="width: 100px;">ค้างซ่อม</th>
                        <th style="width: 100px;">รออะไหล่</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 1;
                        foreach (var item in summaryData)
                        {
                            <tr>
                                <td>@i</td>
                                <td style="text-align: left;" class="fw-bold text-navy">@item.SectionName</td>
                                <td>@item.CarriedOver</td>
                                <td>
                                    <span class="stat-circle bg-new">@item.OpenedToday</span>
                                </td>
                                <td class="text-success fw-bold">@item.Finished</td>
                                <td class="text-danger">@item.RejectedToday</td>
                                <td>
                                    <span class="stat-circle bg-pending">@item.Pending</span>
                                </td>
                                <td>@item.WaitPart</td>
                            </tr>
                            i++;
                        }
                    }
                </tbody>
                <tfoot style="background-color: #001f3f; color: white;">
                    <tr class="fw-bold">
                        <td colspan="2">รวมทั้งสิ้น</td>
                        <td>@summaryData.Sum(x => x.CarriedOver)</td>
                        <td>@summaryData.Sum(x => x.OpenedToday)</td>
                        <td>@summaryData.Sum(x => x.Finished)</td>
                        <td>@summaryData.Sum(x => x.RejectedToday)</td>
                        <td>@summaryData.Sum(x => x.Pending)</td>
                        <td>@summaryData.Sum(x => x.WaitPart)</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="row mt-5 pt-5 text-center">
            <div class="col-4">
                <div style="border-bottom: 1px solid #ccc; width: 80%; margin: 0 auto 10px;"></div>
                <p class="mb-0 small fw-bold">(@ViewBag.ApiUser)</p>
                <p class="small text-muted">ผู้จัดทำรายงาน</p>
            </div>
            <div class="col-4">
                <div style="border-bottom: 1px solid #ccc; width: 80%; margin: 0 auto 10px;"></div>
                <p class="mb-0 small fw-bold">........................................</p>
                <p class="small text-muted">หัวหน้าแผนกตรวจสอบ</p>
            </div>
            <div class="col-4">
                <div style="border-bottom: 1px solid #ccc; width: 80%; margin: 0 auto 10px;"></div>
                <p class="mb-0 small fw-bold">........................................</p>
                <p class="small text-muted">ผู้อนุมัติ (Manager)</p>
            </div>
        </div>
    </div>

</body>
</html>